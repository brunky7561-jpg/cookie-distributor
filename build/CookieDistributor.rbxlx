		plotName = "Garage Kitchen Plot",
	},
	corner_shop = {
		id = "corner_shop",
		name = "Corner Cookie Shop",
		blurb = "A real storefront with a big display case and steady foot traffic.",
		price = 9000,
		unlockLevel = 7,
		ovenSlots = 3,
		storage = 220,
		dailyCost = 120,
		display = 6,
		walkIn = 8,
		receivingName = "Delivery Mat (Corner Cookie Shop)",
		plotName = "Corner Cookie Shop Plot",
	},
}

return Properties
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX11"><Properties><string name="Name">Recipes</string><ProtectedString name="Source"><![CDATA[--!strict
-- Recipes are built from slots on top of a fixed dough: flavor (required), mix-in and finish (optional).
-- Named recipes are known combinations of those slots. Any other valid combination is an experiment ("House Special").
local Types = require(script.Parent.Parent.Modules.Types)

local Recipes = {}

Recipes.synergies = {
	{ a = "chocolate", b = "salty", multiplier = 1.3 },
	{ a = "energy", b = "sweet", multiplier = 1.2 },
} :: { Types.Synergy }

Recipes.base = { flour = 2, butter = 1 } :: { [string]: number }

Recipes.slots = {
	flavor = { required = true, options = { "white_sugar", "brown_sugar", "caramel", "golden_honey" } },
	mixin = { required = false, options = { "chocolate_chips" } },
	finish = { required = false, options = { "sea_salt", "espresso_powder" } },
} :: { [string]: { required: boolean, options: { string } } }

Recipes.slotOrder = { "flavor", "mixin", "finish" }

Recipes.boxes = {
	{ id = "small", name = "Small box", size = 3 },
	{ id = "standard", name = "Standard box", size = 6 },
	{ id = "large", name = "Large box", size = 12 },
} :: { Types.BoxDef }

Recipes.YIELD = 6
Recipes.CUSTOM_CORRECTNESS = { 0.85, 0.92, 1 } -- recipe correctness after 0, 1, 2+ earlier bakes of the same experiment
Recipes.MAX_CUSTOM = 8

-- slots: { flavor: string?, mixin: string?, finish: string? }  ->  ingredient requirements
function Recipes.requiresFor(slots: { [string]: string }): { [string]: number }
	local out: { [string]: number } = table.clone(Recipes.base)
	for _, slot in Recipes.slotOrder do
		local id = slots[slot]
		if id then
			out[id] = (out[id] or 0) + 1
		end
	end
	return out
end

-- { flour = 2, butter = 1 } -> { "butter", "flour", "flour" } (sorted, for Appeal and tags)
function Recipes.expand(requires: { [string]: number }, times: number?): { string }
	local list = {}
	for id, n in requires do
		for _ = 1, n * (times or 1) do
			table.insert(list, id)
		end
	end
	table.sort(list)
	return list
end

function Recipes.keyFor(slots: { [string]: string }): string
	local parts = {}
	for _, slot in Recipes.slotOrder do
		table.insert(parts, slots[slot] or "-")
	end
	return table.concat(parts, "|")
end

-- Returns a clean slots table, or nil plus the reason it was refused.
function Recipes.validateSlots(raw: any): ({ [string]: string }?, string?)
	if type(raw) ~= "table" then
		return nil, "pick a flavor"
	end
	local out: { [string]: string } = {}
	for _, slot in Recipes.slotOrder do
		local def = Recipes.slots[slot]
		local id = raw[slot]
		if id == nil or id == "" then
			if def.required then
				return nil, `pick a {slot}`
			end
		elseif type(id) ~= "string" or not table.find(def.options, id) then
			return nil, `{tostring(id)} does not fit the {slot} slot`
		else
			out[slot] = id
		end
	end
	return out, nil
end

-- "custom:" keys come back from saved data; only well-formed ones survive.
function Recipes.parseCustomKey(key: any): { [string]: string }?
	if type(key) ~= "string" or string.sub(key, 1, 7) ~= "custom:" then
		return nil
	end
	local parts = string.split(string.sub(key, 8), "|")
	if #parts ~= #Recipes.slotOrder then
		return nil
	end
	local raw: { [string]: string } = {}
	for i, slot in Recipes.slotOrder do
		if parts[i] ~= "-" then
			raw[slot] = parts[i]
		end
	end
	local slots = Recipes.validateSlots(raw)
	return slots
end

Recipes.names = {
	white_sugar = "Sugar",
	brown_sugar = "Brown Sugar",
	caramel = "Caramel",
	golden_honey = "Golden Honey",
	chocolate_chips = "Chocolate",
	sea_salt = "Sea Salt",
	espresso_powder = "Espresso",
} :: { [string]: string }

function Recipes.customName(slots: { [string]: string }): string
	local parts = {}
	for _, slot in Recipes.slotOrder do
		local id = slots[slot]
		if id then
			table.insert(parts, Recipes.names[id] or id)
		end
	end
	return "House Special: " .. table.concat(parts, " + ")
end

local function def(id: string, name: string, slots: { [string]: string }, unlockLevel: number, priceMult: number, blurb: string): Types.RecipeDef
	return {
		id = id,
		name = name,
		yield = Recipes.YIELD,
		slots = slots,
		requires = Recipes.requiresFor(slots),
		unlockLevel = unlockLevel,
		priceMult = priceMult,
		blurb = blurb,
	}
end

Recipes.catalog = {
	simple_sugar = def("simple_sugar", "Simple Sugar Cookies", { flavor = "white_sugar" }, 1, 0.8, "Cheap and quick. Good for bargain shoppers."),
	classic_chip = def("classic_chip", "Classic Chip Cookies", { flavor = "white_sugar", mixin = "chocolate_chips" }, 1, 1, "Everyone's favorite. A safe bet."),
	brown_sugar_chunk = def("brown_sugar_chunk", "Brown Sugar Chunk", { flavor = "brown_sugar", mixin = "chocolate_chips" }, 2, 1.15, "Chewier and richer than the classic."),
	salted_chunk = def("salted_chunk", "Salted Chocolate Chunk", { flavor = "brown_sugar", mixin = "chocolate_chips", finish = "sea_salt" }, 3, 1.4, "Chocolate and salt are a famous pair. Foodies love it."),
	caramel_crunch = def("caramel_crunch", "Caramel Espresso Crunch", { flavor = "caramel", mixin = "chocolate_chips", finish = "espresso_powder" }, 4, 1.8, "Bold and expensive. Impresses critics, overwhelms the shy."),
	golden_honey = def("golden_honey", "Golden Honey Chip", { flavor = "golden_honey", mixin = "chocolate_chips" }, 6, 3.5, "A premium treat made with rare golden honey."),
} :: { [string]: Types.RecipeDef }

-- A named recipe that exactly matches these slots, if any.
function Recipes.matchCatalog(slots: { [string]: string }): Types.RecipeDef?
	local key = Recipes.keyFor(slots)
	for _, r in Recipes.catalog do
		if Recipes.keyFor(r.slots) == key then
			return r
		end
	end
	return nil
end

return Recipes
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX12"><Properties><string name="Name">Staff</string><ProtectedString name="Source"><![CDATA[--!strict
-- Hireable bakers. A baker works one recipe at a time and bakes a batch every `cycle` seconds while the pantry has the
-- ingredients and storage has room. Quality is deterministic: score = base + skill * perSkill, never random.
local Staff = {}

Staff.candidates = {
	sam = { id = "sam", name = "Sam", blurb = "Eager and cheap. Plain but decent batches.", skill = 1, wage = 30, cycle = 100 },
	rosa = { id = "rosa", name = "Rosa", blurb = "Steady hands and good timing.", skill = 2, wage = 70, cycle = 80 },
	ike = { id = "ike", name = "Ike", blurb = "A veteran pastry chef. Fast and precise.", skill = 3, wage = 130, cycle = 60 },
} :: { [string]: { id: string, name: string, blurb: string, skill: number, wage: number, cycle: number } }

Staff.order = { "sam", "rosa", "ike" }
Staff.BASE_SCORE = 50
Staff.PER_SKILL = 10 -- skill 1 => 60, 2 => 70, 3 => 80 (the player can still reach 100 by hand)
Staff.PROMOTE_EVERY = 10 -- bakes needed per extra skill point, up to +1 (max skill 4)
Staff.DAY = 600 -- seconds between wage payments

return Staff
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX13"><Properties><string name="Name">Theme</string><ProtectedString name="Source"><![CDATA[--!strict
-- Sugarblock City palette. Use these tokens instead of raw colors so the UI stays consistent.
local Theme = {
	Cocoa = Color3.fromHex("#4C3028"), -- main text, outlines, dark wood
	Buttercream = Color3.fromHex("#FFF5DF"), -- backgrounds, cards, menus
	Butter = Color3.fromHex("#F6D77A"), -- rewards, selected states, warm highlights
	Coral = Color3.fromHex("#EE786D"), -- primary action, alerts
	Mint = Color3.fromHex("#8EC8AE"), -- success, fresh, positive
	Blueberry = Color3.fromHex("#8A9EDD"), -- research, premium, information
	Cream = Color3.fromHex("#FFFBF0"), -- card highlights, gradient tops
	Peach = Color3.fromHex("#FFD9B8"), -- warm gradient bottoms
	Cherry = Color3.fromHex("#D9534F"), -- strong alerts, notification dots
	Night = Color3.fromHex("#2E1D18"), -- headers, deep shadows
}

return Theme
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX14"><Properties><string name="Name">Vehicles</string><ProtectedString name="Source"><![CDATA[--!strict
-- Vehicles speed up PantryDash couriers (a driver of yours does the run) and can also be driven around the map.
-- Walking always works: nothing in the game requires a vehicle.
local Vehicles = {}

Vehicles.catalog = {
	compact_car = {
		id = "compact_car",
		name = "Compact Car",
		blurb = "Zippy and cheap. Couriers arrive about a third faster.",
		price = 800,
		unlockLevel = 4,
		speed = 42,
		seats = 2,
		etaMult = 0.65,
		freeDelivery = false,
		color = { 255, 120, 90 },
	},
	delivery_van = {
		id = "delivery_van",
		name = "Delivery Van",
		blurb = "Bigger and slower to drive, but couriers arrive in under half the time and never charge a fee.",
		price = 2500,
		unlockLevel = 6,
		speed = 34,
		seats = 4,
		etaMult = 0.4,
		freeDelivery = true,
		color = { 240, 220, 170 },
	},
} :: { [string]: { id: string, name: string, blurb: string, price: number, unlockLevel: number, speed: number, seats: number, etaMult: number, freeDelivery: boolean, color: { number } } }

Vehicles.order = { "compact_car", "delivery_van" }

-- Best owned vehicle effect on deliveries: { etaMult, freeDelivery }.
function Vehicles.deliveryPerks(owned: { [string]: boolean }): (number, boolean)
	local mult, free = 1, false
	for id in owned do
		local v = Vehicles.catalog[id]
		if v then
			mult = math.min(mult, v.etaMult)
			free = free or v.freeDelivery
		end
	end
	return mult, free
end

return Vehicles
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX23"><Properties><string name="Name">Modules</string></Properties><Item class="ModuleScript" referent="RBX16"><Properties><string name="Name">AppealCalc</string><ProtectedString name="Source"><![CDATA[--!strict
-- Pure function: ingredient ids + bake quality -> Appeal score. Shared so UI can preview it.
local Ingredients = require(script.Parent.Parent.Config.Ingredients)
local Recipes = require(script.Parent.Parent.Config.Recipes)

local AppealCalc = {}

local DIMINISHING = 0.75 -- each repeat of the same ingredient adds 75% of the previous

function AppealCalc.compute(ingredientIds: { string }, quality: number): { score: number, effects: { string } }
	local seen: { [string]: number } = {}
	local tags: { [string]: boolean } = {}
	local effects: { [string]: boolean } = {}
	local total = 0

	for _, id in ingredientIds do
		local ing = Ingredients[id]
		if not ing then
			continue
		end
		local n = seen[id] or 0
		seen[id] = n + 1
		total += ing.appeal * DIMINISHING ^ n
		for _, t in ing.tags do
			tags[t] = true
		end
		for _, e in ing.sideEffects do
			effects[e] = true
		end
	end

	for _, syn in Recipes.synergies do
		if tags[syn.a] and tags[syn.b] then
			total *= syn.multiplier
		end
	end

	-- quality is 0..1; a perfect bake gets x1.2, a burnt one x0.5
	local mult = 0.5 + 0.7 * math.clamp(quality, 0, 1)
	local score = math.clamp(math.round(total * mult), 0, 100)

	local list = {}
	for e in effects do
		table.insert(list, e)
	end
	table.sort(list)
	return { score = score, effects = list }
end

return AppealCalc
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX17"><Properties><string name="Name">DataSchema</string><ProtectedString name="Source"><![CDATA[--!strict
-- Saved-data shape, migrations and sanitizing. Pure functions so they can be tested without Roblox.
-- Rules: never trust saved data. Anything missing, mistyped or unknown falls back to a safe default.
local Config = script.Parent.Parent.Config
local Equipment = require(Config.Equipment)
local Ingredients = require(Config.Ingredients)
local Properties = require(Config.Properties)
local Brand = require(Config.Brand)
local Market = require(Config.Market)
local Staff = require(Config.Staff)
local Vehicles = require(Config.Vehicles)
local Recipes = require(Config.Recipes)

local DataSchema = {}

DataSchema.VERSION = 2

local MAX_COUNT = 9999
local MAX_BATCHES = 30

function DataSchema.default(): any
	return {
		schemaVersion = DataSchema.VERSION,
		cash = 250,
		level = 1,
		xp = 0,
		reputation = 0,
		ingredients = { flour = 6, white_sugar = 4, butter = 4, chocolate_chips = 3 }, -- one small batch plus spare
		batches = {},
		recipes = { classic_chip = true, simple_sugar = true },
		recipeBook = {}, -- per recipe: { name, bakes, best, grade, custom }
		properties = { apartment = true },
		vehicles = {},
		contract = false, -- active contract offer or false
		contractNextAt = 0,
		contractWins = 0,
		contractLosses = 0,
		staff = {}, -- hired bakers: { id, recipeId, bakes, progress, status, unpaid }
		equipment = { basic_oven = true, mixing_bowl = true, cooling_rack = true },
		customers = {},
		nextBatchId = 1,
		milestones = {},
		stats = { gross = 0, supplies = 0, wages = 0, delivery = 0, other = 0, orders = 0, walkIn = 0 },
		deliveries = {}, -- paid PantryDash orders not yet collected: { id, items, propertyId, arriveAt }
		nextDeliveryId = 1,
		history = {}, -- last completed orders for the phone
		settings = { guidance = true, effects = true, seenApps = {}, textScale = 1, sfx = 0.6, brandName = "", brandColor = 1 },
	}
end

local function isNumber(v: any): boolean
	return type(v) == "number" and v == v and v > -math.huge and v < math.huge
end

local function num(v: any, default: number, lo: number, hi: number): number
	if isNumber(v) then
		return math.clamp(v, lo, hi)
	end
	return default
end

local function int(v: any, default: number, lo: number, hi: number): number
	return math.floor(num(v, default, lo, hi))
end

local function boolMap(v: any, allowed: ((string) -> boolean)?): { [string]: boolean }
	local out: { [string]: boolean } = {}
	if type(v) == "table" then
		for k, val in v do
			if type(k) == "string" and val == true and (allowed == nil or allowed(k)) then
				out[k] = true
			end
		end
	end
	return out
end

local function stringList(v: any, maxLen: number): { string }
	local out: { string } = {}
	if type(v) == "table" then
		for _, s in v do
			if type(s) == "string" and #s <= 40 and #out < maxLen then
				table.insert(out, s)
			end
		end
	end
	return out
end

local function sanitizeBatch(b: any): any?
	if type(b) ~= "table" or not isNumber(b.id) then
		return nil
	end
	local count = int(b.count, 0, 0, 100)
	if count < 1 then
		return nil
	end
	local quality = num(b.quality, 0.5, 0, 1)
	return {
		id = int(b.id, 0, 0, 2 ^ 31),
		name = if type(b.name) == "string" then string.sub(b.name, 1, 40) else "Cookies",
		recipeId = if type(b.recipeId) == "string" then string.sub(b.recipeId, 1, 40) else nil,
		ingredients = stringList(b.ingredients, 20),
		tags = stringList(b.tags, 20),
		quality = quality,
		score = int(b.score, math.floor(quality * 100), 0, 100),
		grade = if type(b.grade) == "string" then string.sub(b.grade, 1, 20) else nil,
		feedback = if type(b.feedback) == "string" then string.sub(b.feedback, 1, 200) else nil,
		factors = if type(b.factors) == "table" then b.factors else nil,
		appeal = int(b.appeal, 0, 0, 100),
		effects = stringList(b.effects, 10),
		count = count,
		packaged = b.packaged == true,
		displayed = b.displayed == true,
		-- reservedFor is intentionally dropped: open orders are not saved, so no box may stay reserved
	}
end

local function sanitizeContract(v: any): any
	if type(v) ~= "table" or type(v.recipeId) ~= "string" or not Recipes.catalog[v.recipeId] then
		return false
	end
	local rival = nil
	for _, r in Market.rivals do
		if r.id == v.rivalId then
			rival = r.id
		end
	end
	if not rival then
		return false
	end
	return {
		rivalId = rival,
		recipeId = v.recipeId,
		count = int(v.count, Market.CONTRACT_COUNT, 1, 100),
		minScore = int(v.minScore, Market.CONTRACT_MIN_SCORE, 0, 100),
		pay = int(v.pay, 100, 0, 1e6),
		expiresAt = int(v.expiresAt, 0, 0, 2 ^ 40),
	}
end

local function sanitizeStaff(v: any): { any }
	local out = {}
	if type(v) == "table" then
		for _, e in v do
			if type(e) == "table" and type(e.id) == "string" and Staff.candidates[e.id] and #out < 3 then
				table.insert(out, {
					id = e.id,
					recipeId = if type(e.recipeId) == "string" and Recipes.catalog[e.recipeId] then e.recipeId else nil,
					bakes = int(e.bakes, 0, 0, 1e6),
					progress = num(e.progress, 0, 0, 1000),
					status = if type(e.status) == "string" then string.sub(e.status, 1, 90) else "Waiting for a recipe.",
					unpaid = e.unpaid == true,
				})
			end
		end
	end
	return out
end

local function sanitizeCustomers(v: any): { [string]: any }
	local out: { [string]: any } = {}
	if type(v) == "table" then
		for id, s in v do
			if type(id) == "string" and #id <= 40 and type(s) == "table" then
				local memory = {}
				if type(s.memory) == "table" then
					for _, m in s.memory do
						if type(m) == "table" and #memory < 5 then
							table.insert(memory, {
								name = if type(m.name) == "string" then string.sub(m.name, 1, 40) else "Cookies",
								quality = num(m.quality, 0.5, 0, 1),
								appeal = int(m.appeal, 0, 0, 100),
								sat = num(m.sat, 0.5, 0, 1),
							})
						end
					end
				end
				out[id] = { rel = int(s.rel, 0, 0, 100000), memory = memory }
			end
		end
	end
	return out
end

local function sanitizeDeliveries(v: any): { any }
	local out = {}
	if type(v) == "table" then
		for _, d in v do
			if type(d) == "table" and type(d.propertyId) == "string" and Properties[d.propertyId] and type(d.items) == "table" and #out < 10 then
				local items: { [string]: number } = {}
				local any = false
				for id, n in d.items do
					if type(id) == "string" and Ingredients[id] and isNumber(n) then
						local count = int(n, 0, 0, 100)
						if count > 0 then
							items[id] = count
							any = true
						end
					end
				end
				if any then
					table.insert(out, { id = int(d.id, 0, 0, 2 ^ 31), items = items, propertyId = d.propertyId, arriveAt = int(d.arriveAt, 0, 0, 2 ^ 40) })
				end
			end
		end
	end
	return out
end

local function sanitizeHistory(v: any): { any }
	local out = {}
	if type(v) == "table" then
		for _, h in v do
			if type(h) == "table" and #out < 10 then
				table.insert(out, {
					customer = if type(h.customer) == "string" then string.sub(h.customer, 1, 30) else "Customer",
					recipe = if type(h.recipe) == "string" then string.sub(h.recipe, 1, 40) else "Cookies",
					pay = int(h.pay, 0, 0, 1e9),
					grade = if type(h.grade) == "string" then string.sub(h.grade, 1, 20) else "",
					t = int(h.t, 0, 0, 2 ^ 40),
				})
			end
		end
	end
	return out
end

local function sanitizeRecipeBook(v: any): { [string]: any }
	local out: { [string]: any } = {}
	local customs = 0
	if type(v) == "table" then
		for key, e in v do
			if type(key) == "string" and type(e) == "table" then
				local custom = Recipes.parseCustomKey(key) ~= nil
				if (Recipes.catalog[key] ~= nil or custom) and (not custom or customs < Recipes.MAX_CUSTOM) then
					if custom then
						customs += 1
					end
					out[key] = {
						name = if type(e.name) == "string" then string.sub(e.name, 1, 60) else key,
						bakes = int(e.bakes, 0, 0, 100000),
						best = int(e.best, 0, 0, 100),
						grade = if type(e.grade) == "string" then string.sub(e.grade, 1, 20) else "",
						custom = custom,
					}
				end
			end
		end
	end
	return out
end

-- Brings data from any older version up to VERSION. Unknown future versions are not handled here.
function DataSchema.migrate(raw: any): any
	if type(raw) ~= "table" then
		return DataSchema.default()
	end
	local from = if isNumber(raw.schemaVersion) then raw.schemaVersion else 1
	if from < 2 then
		-- v1 (milestones 0 and 1): no equipment, stats, settings or reputation; recipe names instead of ids
		raw.equipment = raw.equipment or { basic_oven = true, mixing_bowl = true, cooling_rack = true }
		raw.stats = raw.stats or { gross = 0, supplies = 0, wages = 0, delivery = 0, other = 0, orders = 0, walkIn = 0 }
		raw.settings = raw.settings or {}
		raw.reputation = raw.reputation or 0
		raw.recipes = { classic_chip = true, simple_sugar = true }
	end
	raw.schemaVersion = DataSchema.VERSION
	return raw
end

-- Returns a fresh, fully valid table built only from fields we know about.
function DataSchema.sanitize(raw: any): any
	local d = DataSchema.default()
	if type(raw) ~= "table" then
		return d
	end

	d.cash = num(raw.cash, d.cash, 0, 1e9)
	d.level = int(raw.level, 1, 1, 1000)
	d.xp = int(raw.xp, 0, 0, 1e9)
	d.reputation = int(raw.reputation, 0, 0, 1e9)
	d.nextBatchId = int(raw.nextBatchId, 1, 1, 2 ^ 31)

	if type(raw.ingredients) == "table" then
		local ing: { [string]: number } = {}
		for id, n in raw.ingredients do
			if type(id) == "string" and Ingredients[id] and isNumber(n) then
				local count = int(n, 0, 0, MAX_COUNT)
				if count > 0 then
					ing[id] = count
				end
			end
		end
		d.ingredients = ing
	end

	local batches = {}
	if type(raw.batches) == "table" then
		for _, b in raw.batches do
			local clean = sanitizeBatch(b)
			if clean and #batches < MAX_BATCHES then
				table.insert(batches, clean)
				d.nextBatchId = math.max(d.nextBatchId, clean.id + 1)
			end
		end
	end
	d.batches = batches

	d.recipes = boolMap(raw.recipes, function(id)
		return Recipes.catalog[id] ~= nil
	end)
	d.recipes.classic_chip = true -- the starter recipes can never be lost
	d.recipes.simple_sugar = true
	d.recipeBook = sanitizeRecipeBook(raw.recipeBook)
	d.properties = boolMap(raw.properties, function(id)
		return Properties[id] ~= nil
	end)
	d.properties.apartment = true
	d.equipment = boolMap(raw.equipment, function(id)
		return Equipment.catalog[id] ~= nil
	end)
	for _, id in Equipment.starter do
		d.equipment[id] = true
	end
	d.milestones = boolMap(raw.milestones)
	d.customers = sanitizeCustomers(raw.customers)

	local stats = if type(raw.stats) == "table" then raw.stats else {}
	for k in d.stats do
		d.stats[k] = int(stats[k], 0, 0, 1e12)
	end
	local settings = if type(raw.settings) == "table" then raw.settings else {}
	d.settings.guidance = settings.guidance ~= false
	d.settings.effects = settings.effects ~= false
	d.settings.seenApps = boolMap(settings.seenApps)
	d.settings.textScale = if table.find(Brand.TEXT_SCALES, settings.textScale) then settings.textScale else 1
	d.settings.sfx = num(settings.sfx, 0.6, 0, 1)
	d.settings.brandName = Brand.cleanName(settings.brandName) or ""
	d.settings.brandColor = int(settings.brandColor, 1, 1, #Brand.COLORS)
	d.deliveries = sanitizeDeliveries(raw.deliveries)
	d.nextDeliveryId = int(raw.nextDeliveryId, 1, 1, 2 ^ 31)
	for _, dl in d.deliveries do
		d.nextDeliveryId = math.max(d.nextDeliveryId, dl.id + 1)
	end
	d.history = sanitizeHistory(raw.history)
	d.contract = sanitizeContract(raw.contract)
	d.contractNextAt = int(raw.contractNextAt, 0, 0, 2 ^ 40)
	d.contractWins = int(raw.contractWins, 0, 0, 1e9)
	d.contractLosses = int(raw.contractLosses, 0, 0, 1e9)
	d.staff = sanitizeStaff(raw.staff)
	d.vehicles = boolMap(raw.vehicles, function(id)
		return Vehicles.catalog[id] ~= nil
	end)
	return d
end

return DataSchema
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX18"><Properties><string name="Name">DeliveryMath</string><ProtectedString name="Source"><![CDATA[--!strict
-- PantryDash rules in one pure place: the client uses it for the live preview, the server uses it to authorize.
local Config = script.Parent.Parent.Config
local Ingredients = require(Config.Ingredients)
local Properties = require(Config.Properties)
local Vehicles = require(Config.Vehicles)

local DeliveryMath = {}

DeliveryMath.ETA = 15 -- seconds until the courier arrives
DeliveryMath.FEE = 4
DeliveryMath.FREE_DELIVERY_FROM = 30
DeliveryMath.MAX_QTY_PER_ITEM = 50
DeliveryMath.MAX_UNITS_PER_ORDER = 60
DeliveryMath.MAX_PENDING = 5
DeliveryMath.RARE_UNLOCK_LEVEL = 5

function DeliveryMath.eta(vehicles: { [string]: boolean }?): number
	local mult = Vehicles.deliveryPerks(vehicles or {})
	return math.max(4, math.floor(DeliveryMath.ETA * mult + 0.5))
end

function DeliveryMath.subtotal(items: { [string]: number }): number
	local total = 0
	for id, n in items do
		total += Ingredients[id].cost * n
	end
	return total
end

function DeliveryMath.fee(subtotal: number, vehicles: { [string]: boolean }?): number
	local _, free = Vehicles.deliveryPerks(vehicles or {})
	if free or subtotal <= 0 or subtotal >= DeliveryMath.FREE_DELIVERY_FROM then
		return 0
	end
	return DeliveryMath.FEE
end

-- Ingredient capacity: the sum of storage over owned properties.
function DeliveryMath.capacity(data: any): number
	local cap = 0
	for id in data.properties do
		local def = Properties[id]
		if def then
			cap += def.storage
		end
	end
	return cap
end

-- Units on hand plus units already paid for and still on their way.
function DeliveryMath.units(data: any): number
	local n = 0
	for _, count in data.ingredients do
		n += count
	end
	for _, d in data.deliveries do
		for _, count in d.items do
			n += count
		end
	end
	return n
end

-- Accepts either { {id=, qty=}, ... } or { [id] = qty }. Returns a clean { [id] = qty } map, or nil plus a reason.
function DeliveryMath.normalize(raw: any): ({ [string]: number }?, string?)
	if type(raw) ~= "table" then
		return nil, "your cart is empty"
	end
	local out: { [string]: number } = {}
	local function add(id: any, qty: any): string?
		if type(id) ~= "string" or not Ingredients[id] then
			return "unknown ingredient"
		end
		if type(qty) ~= "number" or qty ~= qty or qty < 1 or qty > DeliveryMath.MAX_QTY_PER_ITEM or math.floor(qty) ~= qty then
			return "quantities must be whole numbers from 1 to 50"
		end
		out[id] = (out[id] or 0) + qty
		return nil
	end
	local count = 0
	for k, v in raw do
		count += 1
		if count > 30 then
			return nil, "too many items"
		end
		local err
		if type(v) == "table" then
			err = add(v.id, v.qty)
		else
			err = add(k, v)
		end
		if err then
			return nil, err
		end
	end
	local units = 0
	for id, qty in out do
		if qty > DeliveryMath.MAX_QTY_PER_ITEM then
			return nil, "quantities must be whole numbers from 1 to 50"
		end
		units += qty
	end
	if units == 0 then
		return nil, "your cart is empty"
	end
	if units > DeliveryMath.MAX_UNITS_PER_ORDER then
		return nil, `one delivery can carry up to {DeliveryMath.MAX_UNITS_PER_ORDER} items`
	end
	return out, nil
end

export type Quote = {
	items: { [string]: number },
	propertyId: string,
	subtotal: number,
	fee: number,
	total: number,
	eta: number,
	cashAfter: number,
	unitsAfter: number,
	capacity: number,
}

-- Full check against saved data. Returns a quote, or nil plus a message the player can act on.
function DeliveryMath.quote(data: any, items: { [string]: number }, propertyId: any): (Quote?, string?)
	local def = if type(propertyId) == "string" then Properties[propertyId] else nil
	if not def or not data.properties[def.id] or not def.receivingName then
		return nil, "pick one of your properties to receive the delivery"
	end
	if #data.deliveries >= DeliveryMath.MAX_PENDING then
		return nil, "you have several deliveries waiting; collect a crate first"
	end
	for id in items do
		if table.find(Ingredients[id].tags, "rare") and data.level < DeliveryMath.RARE_UNLOCK_LEVEL then
			return nil, `{Ingredients[id].name} unlocks at level {DeliveryMath.RARE_UNLOCK_LEVEL}`
		end
	end
	local added = 0
	for _, n in items do
		added += n
	end
	local capacity = DeliveryMath.capacity(data)
	local unitsAfter = DeliveryMath.units(data) + added
	if unitsAfter > capacity then
		return nil, `Not enough storage: this would make {unitsAfter} items but you can hold {capacity}.`
	end
	local subtotal = DeliveryMath.subtotal(items)
	local fee = DeliveryMath.fee(subtotal, data.vehicles)
	local total = subtotal + fee
	if data.cash < total then
		return nil, `You need ${total} but have ${math.floor(data.cash)}.`
	end
	return {
		items = items,
		propertyId = def.id,
		subtotal = subtotal,
		fee = fee,
		total = total,
		eta = DeliveryMath.eta(data.vehicles),
		cashAfter = data.cash - total,
		unitsAfter = unitsAfter,
		capacity = capacity,
	},
		nil
end

return DeliveryMath
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX19"><Properties><string name="Name">Quality</string><ProtectedString name="Source"><![CDATA[--!strict
-- Transparent 0-100 batch quality: recipe 40%, bake timing 30%, ingredient freshness 15%, portion consistency 15%.
local Quality = {}

export type Factors = { recipe: number, bake: number, fresh: number, portion: number } -- each 0..1

Quality.WEIGHTS = { recipe = 0.40, bake = 0.30, fresh = 0.15, portion = 0.15 }

-- 1 at the ideal moment, falling to 0 once you are a full IDEAL away. `slack` seconds either side still score 1
-- (better equipment forgives more).
function Quality.timing(elapsed: number, ideal: number, slack: number?): number
	local off = math.max(0, math.abs(elapsed - ideal) - (slack or 0))
	return math.clamp(1 - off / ideal, 0, 1)
end

function Quality.score(f: Factors): number
	local w = Quality.WEIGHTS
	local total = f.recipe * w.recipe + f.bake * w.bake + f.fresh * w.fresh + f.portion * w.portion
	return math.clamp(math.floor(total * 100 + 0.5), 0, 100)
end

function Quality.grade(score: number): string
	if score >= 90 then
		return "Perfect Batch"
	elseif score >= 75 then
		return "Great"
	elseif score >= 50 then
		return "Good"
	end
	return "Needs Work"
end

-- One sentence that points at the weakest factor. bakeSigned > 0 means the tray stayed in too long.
function Quality.feedback(f: Factors, bakeSigned: number): string
	local order = {
		{ "bake", f.bake },
		{ "portion", f.portion },
		{ "fresh", f.fresh },
		{ "recipe", f.recipe },
	}
	local weakest, value = "bake", 2
	for _, entry in order do
		if (entry[2] :: number) < value then
			weakest, value = entry[1] :: string, entry[2] :: number
		end
	end
	if value >= 0.9 then
		return "Golden edges and even sizes. A perfect little batch."
	end
	if weakest == "bake" then
		if bakeSigned > 0 then
			return "This batch baked a little long; pull the tray a touch sooner next time."
		end
		return "This batch came out a little early; give it a few more seconds in the oven."
	elseif weakest == "portion" then
		return "The cookies came out uneven; stop the portion bar right in the green zone."
	elseif weakest == "fresh" then
		return "Some ingredients were past their best."
	end
	return "Something was off in the recipe."
end

return Quality
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX20"><Properties><string name="Name">RateLimit</string><ProtectedString name="Source"><![CDATA[--!strict
-- Per-player, per-key cooldown for remote handlers. Call from the server only.
local Players = game:GetService("Players")

local RateLimit = {}

local last: { [Player]: { [string]: number } } = {}

-- Rejections since the server started, per key (read by MetricsService).
RateLimit.rejected = {} :: { [string]: number }

-- Returns true if the call is allowed. A rejected call does not reset the timer.
function RateLimit.check(player: Player, key: string, interval: number): boolean
	local mine = last[player]
	if not mine then
		mine = {}
		last[player] = mine
	end
	local now = os.clock()
	if now - (mine[key] or -math.huge) < interval then
		RateLimit.rejected[key] = (RateLimit.rejected[key] or 0) + 1
		return false
	end
	mine[key] = now
	return true
end

Players.PlayerRemoving:Connect(function(p)
	last[p] = nil
end)

return RateLimit
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX21"><Properties><string name="Name">Remotes</string><ProtectedString name="Source"><![CDATA[--!strict
-- Server creates remotes on first request; client waits for them. Same call on both sides.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Remotes = {}

local function folder(): Folder
	local f = ReplicatedStorage:FindFirstChild("Remotes")
	if f then
		return f :: Folder
	end
	if RunService:IsServer() then
		local new = Instance.new("Folder")
		new.Name = "Remotes"
		new.Parent = ReplicatedStorage
		return new
	end
	return ReplicatedStorage:WaitForChild("Remotes") :: Folder
end

local function get(name: string, className: string): Instance
	local f = folder()
	local existing = f:FindFirstChild(name)
	if existing then
		return existing
	end
	if RunService:IsServer() then
		local r = Instance.new(className)
		r.Name = name
		r.Parent = f
		return r
	end
	return f:WaitForChild(name)
end

function Remotes.event(name: string): RemoteEvent
	return get(name, "RemoteEvent") :: RemoteEvent
end

function Remotes.func(name: string): RemoteFunction
	return get(name, "RemoteFunction") :: RemoteFunction
end

return Remotes
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX22"><Properties><string name="Name">Types</string><ProtectedString name="Source"><![CDATA[--!strict
export type Ingredient = {
	id: string,
	name: string,
	category: string,
	cost: number,
	appeal: number,
	tags: { string },
	sideEffects: { string },
}

export type Synergy = {
	a: string,
	b: string,
	multiplier: number,
}

export type Personality = "Neighbor" | "Foodie" | "BargainHunter" | "SweetTooth" | "HealthNut" | "Trendsetter" | "Grump"

export type CustomerTemplate = {
	id: string,
	name: string,
	personality: Personality,
	loves: { string },
	hates: { string },
	appealMin: number,
	appealMax: number,
	budget: number,
}

export type RecipeDef = {
	id: string,
	name: string,
	yield: number,
	slots: { [string]: string },
	requires: { [string]: number },
	unlockLevel: number?, -- level at which the recipe is added to the Recipe Book
	priceMult: number?, -- how much more (or less) customers pay for it
	blurb: string?,
}

export type BoxDef = {
	id: string,
	name: string,
	size: number,
}

export type PropertyDef = {
	id: string,
	name: string,
	blurb: string?,
	price: number,
	unlockLevel: number?,
	display: number?,
	walkIn: number?,
	plotName: string?,
	ovenSlots: number,
	storage: number,
	dailyCost: number,
	receivingName: string?, -- name of the tagged ReceivingArea part where deliveries are left
}

return {}
]]></ProtectedString></Properties></Item></Item></Item></Item><Item class="ServerScriptService" referent="RBX72"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Folder" referent="RBX45"><Properties><string name="Name">Server</string></Properties><Item class="Script" referent="RBX25"><Properties><string name="Name">Bootstrap</string><ProtectedString name="Source"><![CDATA[--!strict
-- Loads every ModuleScript in Services and calls :Init() then :Start() on each.
local services = script.Parent:WaitForChild("Services")

local loaded = {}
for _, module in services:GetChildren() do
	if module:IsA("ModuleScript") then
		local ok, svc = pcall(require, module)
		if ok then
			table.insert(loaded, { name = module.Name, svc = svc })
		else
			warn(`[Server] failed to load {module.Name}: {svc}`)
		end
	end
end

for _, entry in loaded do
	if type(entry.svc) == "table" and entry.svc.Init then
		local ok, err = pcall(entry.svc.Init, entry.svc)
		if not ok then
			warn(`[Server] {entry.name}:Init failed: {err}`) -- one broken service must not stop the others
		end
	end
end
for _, entry in loaded do
	if type(entry.svc) == "table" and entry.svc.Start then
		task.spawn(function()
			local ok, err = pcall(entry.svc.Start, entry.svc)
			if not ok then
				warn(`[Server] {entry.name}:Start failed: {err}`)
			end
		end)
	end
end

print(`[Server] started {#loaded} services`)
]]></ProtectedString></Properties></Item><Item class="Folder" referent="RBX44"><Properties><string name="Name">Services</string></Properties><Item class="ModuleScript" referent="RBX26"><Properties><string name="Name">BakingService</string><ProtectedString name="Source"><![CDATA[--!strict
-- Server-side baking station. One session per player walks through Mix -> Portion -> Bake -> Cool -> Package.
-- The server times every step with os.clock; the client only draws bars and can never send a quality score.
-- Recipes are named combinations of slots (see Config/Recipes). Anything else is an experiment that is saved to the
-- Recipe Book when it turns out well, and gets better with practice.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Baking = require(ReplicatedStorage.Shared.Config.Baking)
local Ingredients = require(ReplicatedStorage.Shared.Config.Ingredients)
local Recipes = require(ReplicatedStorage.Shared.Config.Recipes)
local AppealCalc = require(ReplicatedStorage.Shared.Modules.AppealCalc)
local Quality = require(ReplicatedStorage.Shared.Modules.Quality)
local RateLimit = require(ReplicatedStorage.Shared.Modules.RateLimit)
local Remotes = require(ReplicatedStorage.Shared.Modules.Remotes)
local PlayerDataService = require(script.Parent.PlayerDataService)
local EconomyService = require(script.Parent.EconomyService)
local InventoryService = require(script.Parent.InventoryService)
local InteractionService = require(script.Parent.InteractionService)
local EquipmentService = require(script.Parent.EquipmentService)
local OrderService = require(script.Parent.OrderService)

type Stage = "mix" | "portion" | "bake" | "cool" | "package"

type Session = {
	recipeId: string, -- catalog id, or "custom:..." for an experiment
	recipeName: string,
	custom: boolean,
	correctness: number, -- 0..1, the recipe factor of the quality score
	orderId: number?,
	ingredients: { string },
	yield: number,
	batchMult: number,
	mixTaps: number,
	mixMin: number,
	coolTime: number,
	bakeSlack: number, -- seconds of forgiveness from the oven the session started with
	stage: Stage,
	running: boolean, -- true while a timing bar is live (portion, bake)
	t0: number,
	portion: number,
	bake: number,
	bakeSigned: number,
	coolEnd: number,
}

local sessions: { [Player]: Session } = {}

local BakingService = {}

local function describe(s: Session): any
	return {
		stage = s.stage,
		running = s.running,
		recipeId = s.recipeId,
		recipeName = s.recipeName,
		orderId = s.orderId,
		yield = s.yield,
		batchMult = s.batchMult,
		mixTaps = s.mixTaps,
		mixMin = s.mixMin,
		bakeSlack = s.bakeSlack,
		coolRemaining = math.max(0, s.coolEnd - os.clock()),
		elapsed = if s.running then os.clock() - s.t0 else 0, -- lets a reopened UI resume its timing bar
	}
end

local function customCount(book: { [string]: any }): number
	local n = 0
	for _, e in book do
		if e.custom then
			n += 1
		end
	end
	return n
end

local function finish(player: Player, s: Session): (boolean, any)
	local data = PlayerDataService:Get(player)
	if not data then
		return false, "your data is still loading"
	end
	sessions[player] = nil

	-- Ingredients do not spoil yet, so freshness is full marks until a later milestone gives it meaning.
	local factors: Quality.Factors = { recipe = s.correctness, bake = s.bake, fresh = 1, portion = s.portion }
	local score = Quality.score(factors)
	local quality = score / 100
	local appeal = AppealCalc.compute(s.ingredients, quality)

	local tagSet: { [string]: boolean } = {}
	for _, id in s.ingredients do
		for _, t in Ingredients[id].tags do
			tagSet[t] = true
		end
	end
	local tags = {}
	for t in tagSet do
		table.insert(tags, t)
	end
	table.sort(tags)

	local grade = Quality.grade(score)
	local feedback = Quality.feedback(factors, s.bakeSigned)
	if s.custom and s.correctness < 0.9 and feedback == "Golden edges and even sizes. A perfect little batch." then
		feedback = "A promising experiment. Bake it again to refine the recipe."
	end
	local batch = {
		id = InventoryService:NextBatchId(player),
		name = s.recipeName,
		recipeId = s.recipeId,
		ingredients = s.ingredients,
		tags = tags,
		quality = quality,
		score = score,
		grade = grade,
		feedback = feedback,
		factors = factors,
		appeal = appeal.score,
		effects = appeal.effects,
		count = s.yield,
		packaged = true,
	}
	InventoryService:AddBatch(player, batch)

	-- Recipe Book: practice, best score, and discoveries
	local entry = data.recipeBook[s.recipeId]
	local keepCustom = s.custom and (entry ~= nil or (score >= 50 and customCount(data.recipeBook) < Recipes.MAX_CUSTOM))
	if not s.custom or keepCustom then
		if not entry then
			entry = { name = s.recipeName, bakes = 0, best = 0, grade = "", custom = s.custom }
			data.recipeBook[s.recipeId] = entry
		end
		entry.bakes += 1
		if score >= entry.best then
			entry.best = score
			entry.grade = grade
		end
	end
	local newlyKnown = not s.custom and not data.recipes[s.recipeId]
	if not s.custom then
		data.recipes[s.recipeId] = true
	end
	if newlyKnown then
		Remotes.event("Notify"):FireClient(player, `Discovery! You worked out {s.recipeName}. It's in your Recipe Book now.`)
		EconomyService:AddXp(player, 40)
	elseif entry and entry.bakes == 1 then
		EconomyService:AddXp(player, 25) -- first time baking this recipe
	end
	EconomyService:AddXp(player, math.floor(5 + quality * 15))

	local linked = false
	if s.orderId then
		linked = OrderService:MarkReady(player, s.orderId, batch.id)
	end
	PlayerDataService:Replicate(player)
	return true, { batch = batch, linkedOrder = linked, orderId = s.orderId, discovered = newlyKnown, custom = s.custom }
end

function BakingService:Init()
	Remotes.func("BakeStatus").OnServerInvoke = function(player: Player)
		local s = sessions[player]
		return if s then describe(s) else nil
	end

	Remotes.func("BakeStart").OnServerInvoke = function(player: Player, recipeId: any, orderId: any, options: any): (boolean, any)
		if not RateLimit.check(player, "BakeStart", 0.5) then
			return false, "slow down a little"
		end
		local data = PlayerDataService:Get(player)
		if not data or type(recipeId) ~= "string" then
			return false, "cannot start a bake right now"
		end
		if sessions[player] then
			return false, "you already have a bake in progress"
		end
		local opts: { [string]: any } = if type(options) == "table" then options else {}
		local effects = EquipmentService:Effects(player)

		local mult = opts.batchMult
		if mult == nil then
			mult = 1
		end
		if mult ~= 1 and mult ~= 2 then
			return false, "pick a single or a double batch"
		end
		if mult > effects.maxBatchMult then
			return false, "you need a Stand Mixer to bake double batches"
		end

		-- work out which recipe this is
		local recipe: any
		local custom = false
		if recipeId == "experiment" then
			local slots, err = Recipes.validateSlots(opts.slots)
			if not slots then
				return false, err
			end
			recipe = Recipes.matchCatalog(slots)
			if not recipe then
				custom = true
				local key = "custom:" .. Recipes.keyFor(slots)
				recipe = {
					id = key,
					name = Recipes.customName(slots),
					requires = Recipes.requiresFor(slots),
				}
				if not data.recipeBook[key] and customCount(data.recipeBook) >= Recipes.MAX_CUSTOM then
					return false, "Your Recipe Book has no room for more experiments."
				end
			end
		else
			recipe = Recipes.catalog[recipeId]
			if not recipe then
				return false, "unknown recipe"
			end
			if not data.recipes[recipeId] then
				return false, "you have not unlocked that recipe yet"
			end
		end

		if not InteractionService:IsNearStation(player, "BakeStation") then
			return false, "walk up to your kitchen counter or oven first"
		end
		if not InventoryService:HasRoomForBatch(player) then
			return false, "storage is full, deliver or use some cookies first"
		end
		if orderId ~= nil then
			if type(orderId) ~= "number" or not OrderService:CanProduce(player, orderId, recipe.id, custom) then
				return false, "that order cannot be baked for right now"
			end
		end
		local need: { [string]: number } = {}
		for id, n in recipe.requires do
			need[id] = n * mult
		end
		local missing = InventoryService:Missing(player, need)
		if missing then
			return false, `Not enough ingredients: {missing}. Order more with PantryDash on your phone (P).`
		end

		-- Everything is validated above and nothing yields below, so these steps cannot be interrupted.
		InventoryService:Consume(player, need)
		if orderId ~= nil then
			OrderService:BeginProduction(player, orderId)
		end
		local book = data.recipeBook[recipe.id]
		local correctness = 1
		if custom then
			local bakes = if book then book.bakes else 0
			correctness = Recipes.CUSTOM_CORRECTNESS[math.min(bakes + 1, #Recipes.CUSTOM_CORRECTNESS)]
		end
		local s: Session = {
			recipeId = recipe.id,
			recipeName = recipe.name,
			custom = custom,
			correctness = correctness,
			orderId = orderId,
			ingredients = Recipes.expand(recipe.requires, mult),
			yield = Recipes.YIELD * mult,
			batchMult = mult,
			mixTaps = effects.mixTaps,
			mixMin = effects.mixMin,
			coolTime = effects.coolTime,
			bakeSlack = effects.bakeSlack,
			stage = "mix",
			running = false,
			t0 = os.clock(),
			portion = 0,
			bake = 0,
			bakeSigned = 0,
			coolEnd = 0,
		}
		sessions[player] = s
		return true, describe(s)
	end

	Remotes.func("BakeStep").OnServerInvoke = function(player: Player, action: any, arg: any): (boolean, any)
		if not RateLimit.check(player, "BakeStep", 0.15) then
			return false, "slow down a little"
		end
		local s = sessions[player]
		if not s or type(action) ~= "string" then
			return false, "no bake in progress"
		end
		local now = os.clock()

		if action == "mixDone" and s.stage == "mix" then
			if now - s.t0 < s.mixMin then
				return false, "keep stirring a little longer"
			end
			s.stage = "portion"
			s.running = false
			return true, describe(s)
		elseif action == "portionStart" and s.stage == "portion" and not s.running then
			s.running = true
			s.t0 = now
			return true, describe(s)
		elseif action == "portionStop" and s.stage == "portion" and s.running then
			s.portion = Quality.timing(now - s.t0, Baking.PORTION_IDEAL)
			s.stage = "bake"
			s.running = false
			local info = describe(s)
			info.portionScore = s.portion
			return true, info
		elseif action == "ovenStart" and s.stage == "bake" and not s.running then
			s.running = true
			s.t0 = now
			return true, describe(s)
		elseif action == "ovenPull" and s.stage == "bake" and s.running then
			local elapsed = now - s.t0
			s.bake = Quality.timing(elapsed, Baking.BAKE_IDEAL, s.bakeSlack)
			s.bakeSigned = elapsed - Baking.BAKE_IDEAL
			s.stage = "cool"
			s.running = false
			s.coolEnd = now + s.coolTime
			local info = describe(s)
			info.bakeScore = s.bake
			return true, info
		elseif action == "coolDone" and s.stage == "cool" then
			if now < s.coolEnd then
				return false, "the tray is still cooling"
			end
			s.stage = "package"
			return true, describe(s)
		elseif action == "pack" and s.stage == "package" then
			local box
			for _, b in Recipes.boxes do
				if b.id == arg then
					box = b
				end
			end
			if not box then
				return false, "pick a box"
			end
			if box.size ~= s.yield then
				return false, `That box holds {box.size}; this tray has {s.yield} cookies.`
			end
			return finish(player, s)
		end
		return false, "that step does not fit right now"
	end

	PlayerDataService.Reset:Connect(function(p)
		sessions[p] = nil
	end)
	Players.PlayerRemoving:Connect(function(p)
		sessions[p] = nil
	end)
end

function BakingService:Start() end

return BakingService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX27"><Properties><string name="Name">DeliveryService</string><ProtectedString name="Source"><![CDATA[--!strict
-- PantryDash deliveries: validated purchase, courier drops a crate at the property's receiving mat, player collects it.
-- Paid deliveries are saved, so a crate is never lost by leaving the game: it is simply waiting on the next visit.
local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Properties = require(ReplicatedStorage.Shared.Config.Properties)
local Theme = require(ReplicatedStorage.Shared.Config.Theme)
local DeliveryMath = require(ReplicatedStorage.Shared.Modules.DeliveryMath)
local RateLimit = require(ReplicatedStorage.Shared.Modules.RateLimit)
local Remotes = require(ReplicatedStorage.Shared.Modules.Remotes)
local PlayerDataService = require(script.Parent.PlayerDataService)
local EconomyService = require(script.Parent.EconomyService)
local InventoryService = require(script.Parent.InventoryService)
local InteractionService = require(script.Parent.InteractionService)

local COLLECT_DISTANCE = 16
local TICK = 1

local crates: { [Player]: { [number]: BasePart } } = {}
local folder: Folder? = nil

local DeliveryService = {}

local function cratesFor(player: Player): { [number]: BasePart }
	local t = crates[player]
	if not t then
		t = {}
		crates[player] = t
	end
	return t
end

local function notify(player: Player, text: string)
	Remotes.event("Notify"):FireClient(player, text)
end

local function findMat(def: any): BasePart?
	for _, inst in CollectionService:GetTagged("ReceivingArea") do
		if inst:IsA("BasePart") and inst.Name == def.receivingName and inst:IsDescendantOf(workspace) then
			return inst
		end
	end
	return nil
end

local function itemCount(items: { [string]: number }): number
	local n = 0
	for _, c in items do
		n += c
	end
	return n
end

local function findDelivery(data: any, id: number): (any?, number?)
	for i, d in data.deliveries do
		if d.id == id then
			return d, i
		end
	end
	return nil, nil
end

local function collect(player: Player, crate: BasePart)
	if not RateLimit.check(player, "CollectCrate", 0.5) then
		return
	end
	local data = PlayerDataService:Get(player)
	local id = crate:GetAttribute("DeliveryId")
	if not data or type(id) ~= "number" or crate:GetAttribute("OwnerUserId") ~= player.UserId then
		return -- not your crate
	end
	local d, index = findDelivery(data, id)
	if not d or not index then
		crate:Destroy()
		return
	end
	local distance = InteractionService:DistanceToPart(player, crate)
	if not distance or distance > COLLECT_DISTANCE then
		return
	end
	-- Capacity can only be exceeded here if something else filled the pantry meanwhile; the crate waits for room.
	local onHand = 0
	for _, n in data.ingredients do
		onHand += n
	end
	if onHand + itemCount(d.items) > DeliveryMath.capacity(data) then
		notify(player, "Your storage is full. Use some ingredients, then collect the crate.")
		return
	end

	-- The delivery leaves the list before any item is added, so a crate can only ever be collected once.
	table.remove(data.deliveries, index)
	cratesFor(player)[id] = nil
	crate:Destroy()
	local total = 0
	for ing, n in d.items do
		InventoryService:Add(player, ing, n)
		total += n
	end
	PlayerDataService:Replicate(player)
	notify(player, `Collected {total} items. They are in your pantry.`)
end

local function courier(near: Vector3, parent: Instance)
	local body = Instance.new("Part")
	body.Name = "Courier"
	body.Size = Vector3.new(2, 3, 1.5)
	body.Position = near
	body.Anchored = true
	body.CanCollide = false
	body.Color = Theme.Mint
	body.Material = Enum.Material.SmoothPlastic
	body.Parent = parent
	local head = Instance.new("Part")
	head.Name = "CourierHead"
	head.Shape = Enum.PartType.Ball
	head.Size = Vector3.new(1.6, 1.6, 1.6)
	head.Position = near + Vector3.new(0, 2.3, 0)
	head.Anchored = true
	head.CanCollide = false
	head.Color = Theme.Butter
	head.Parent = parent
	task.delay(8, function()
		body:Destroy()
		head:Destroy()
	end)
end

local function spawnCrate(player: Player, d: any)
	local mine = cratesFor(player)
	if mine[d.id] then
		return
	end
	local def = Properties[d.propertyId]
	local mat = if def then findMat(def) else nil
	if not mat or not folder then
		return
	end
	local slot = 0
	for _ in mine do
		slot += 1
	end
	local crate = Instance.new("Part")
	crate.Name = `Supply Crate ({player.Name})`
	crate.Size = Vector3.new(3, 2.4, 3)
	crate.Anchored = true
	crate.Color = Theme.Butter
	crate.Material = Enum.Material.Wood
	crate.Position = mat.Position + Vector3.new(((slot % 3) - 1) * 3.4, mat.Size.Y / 2 + 1.2, math.floor(slot / 3) * 3.4)
	crate:SetAttribute("OwnerUserId", player.UserId)
	crate:SetAttribute("DeliveryId", d.id)
	crate.Parent = folder

	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(180, 34)
	gui.StudsOffset = Vector3.new(0, 2.6, 0)
	gui.AlwaysOnTop = true
	gui.MaxDistance = 60
	gui.Parent = crate
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundColor3 = Theme.Buttercream
	label.TextColor3 = Theme.Cocoa
	label.Font = Enum.Font.GothamBold
	label.TextSize = 14
	label.Text = `Supplies for {player.DisplayName}`
	label.Parent = gui

	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Collect"
	prompt.ObjectText = "Supply crate"
	prompt.MaxActivationDistance = 10
	prompt.RequiresLineOfSight = false
	prompt.Parent = crate
	prompt.Triggered:Connect(function(who: Player)
		collect(who, crate)
	end)

	mine[d.id] = crate
	courier(crate.Position + Vector3.new(4, 0, 0), folder)
	notify(player, `Your supplies arrived at the {if def then def.name else "property"}. Collect the crate!`)
end

local function dropCrates(player: Player)
	for _, crate in cratesFor(player) do
		crate:Destroy()
	end
	crates[player] = nil
end

function DeliveryService:Init()
	Remotes.func("PantryQuote").OnServerInvoke = function(player: Player, rawItems: any, propertyId: any): (boolean, any)
		if not RateLimit.check(player, "PantryQuote", 0.15) then
			return false, "slow down a little"
		end
		local data = PlayerDataService:Get(player)
		local items, err = DeliveryMath.normalize(rawItems)
		if not data or not items then
			return false, err or "your data is still loading"
		end
		local quote, qerr = DeliveryMath.quote(data, items, propertyId)
		if not quote then
			return false, qerr
		end
		return true, quote
	end

	Remotes.func("PantryOrder").OnServerInvoke = function(player: Player, rawItems: any, propertyId: any): (boolean, any)
		if not RateLimit.check(player, "PantryOrder", 0.5) then
			return false, "slow down a little"
		end
		local data = PlayerDataService:Get(player)
		local items, err = DeliveryMath.normalize(rawItems)
		if not data or not items then
			return false, err or "your data is still loading"
		end
		local quote, qerr = DeliveryMath.quote(data, items, propertyId)
		if not quote then
			return false, qerr
		end
		if not EconomyService:TrySpend(player, quote.total) then
			return false, "not enough cash"
		end
		EconomyService:Record(player, "supplies", quote.subtotal)
		EconomyService:Record(player, "delivery", quote.fee)
		local d = { id = data.nextDeliveryId, items = quote.items, propertyId = quote.propertyId, arriveAt = os.time() + quote.eta }
		data.nextDeliveryId += 1
		table.insert(data.deliveries, d)
		PlayerDataService:Replicate(player)
		return true, { id = d.id, arriveAt = d.arriveAt, total = quote.total }
	end

	PlayerDataService.Reset:Connect(function(player: Player)
		dropCrates(player)
	end)
end

function DeliveryService:Start()
	local f = workspace:FindFirstChild("DeliveryCrates")
	if not f then
		f = Instance.new("Folder")
		f.Name = "DeliveryCrates"
		f.Parent = workspace
	end
	folder = f :: Folder

	Players.PlayerRemoving:Connect(dropCrates)
	while true do
		task.wait(TICK)
		for _, player in Players:GetPlayers() do
			local data = PlayerDataService:Get(player)
			if data then
				for _, d in data.deliveries do
					if os.time() >= d.arriveAt then
						spawnCrate(player, d)
					end
				end
			end
		end
	end
end

return DeliveryService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX28"><Properties><string name="Name">DevService</string><ProtectedString name="Source"><![CDATA[--!strict
-- Studio-only test shortcut: "Dev: unlock everything" jumps to a late-game save so every phone app, property, vehicle and
-- recipe can be seen at once. Refused for everyone outside Studio unless their UserId is in DEV_USER_IDS.
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Equipment = require(ReplicatedStorage.Shared.Config.Equipment)
local Ingredients = require(ReplicatedStorage.Shared.Config.Ingredients)
local Properties = require(ReplicatedStorage.Shared.Config.Properties)
local Recipes = require(ReplicatedStorage.Shared.Config.Recipes)
local Vehicles = require(ReplicatedStorage.Shared.Config.Vehicles)
local RateLimit = require(ReplicatedStorage.Shared.Modules.RateLimit)
local Remotes = require(ReplicatedStorage.Shared.Modules.Remotes)
local PlayerDataService = require(script.Parent.PlayerDataService)

local DEV_USER_IDS: { [number]: boolean } = {}

local DevService = {}

function DevService:Boost(player: Player): boolean
	local data = PlayerDataService:Get(player)
	if not data or not (RunService:IsStudio() or DEV_USER_IDS[player.UserId]) then
		return false
	end
	data.level = math.max(data.level, 8)
	data.cash = math.max(data.cash, 25000)
	data.milestones.firstOrderDone = true
	for id in Recipes.catalog do
		data.recipes[id] = true
	end
	for id in Properties do
		data.properties[id] = true
	end
	for id in Vehicles.catalog do
		data.vehicles[id] = true
	end
	for id in Equipment.catalog do
		data.equipment[id] = true
	end
	for id in Ingredients do
		data.ingredients[id] = math.max(data.ingredients[id] or 0, 12)
	end
	data.contractNextAt = 0
	PlayerDataService:Replicate(player)
	return true
end

function DevService:Init()
	Remotes.func("DevBoost").OnServerInvoke = function(player: Player): boolean
		if not RateLimit.check(player, "DevBoost", 1) then
			return false
		end
		return DevService:Boost(player)
	end
end

function DevService:Start() end

return DevService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX29"><Properties><string name="Name">EconomyService</string><ProtectedString name="Source"><![CDATA[--!strict
-- Owns cash, XP and the ledger. Amounts are only ever changed here, never by the client.
local PlayerDataService = require(script.Parent.PlayerDataService)

local XP_PER_LEVEL = 100 -- level n needs n * XP_PER_LEVEL to reach n + 1

local EconomyService = {}

function EconomyService:AddCash(player: Player, amount: number)
	local data = PlayerDataService:Get(player)
	if data then
		data.cash += amount
		PlayerDataService:Replicate(player)
	end
end

-- Ledger bookkeeping: kind is one of gross, supplies, wages, delivery, other. Amounts are always positive.
function EconomyService:Record(player: Player, kind: string, amount: number)
	local data = PlayerDataService:Get(player)
	if data and data.stats[kind] ~= nil and amount > 0 then
		data.stats[kind] += math.floor(amount)
	end
end

function EconomyService:TrySpend(player: Player, amount: number): boolean
	local data = PlayerDataService:Get(player)
	if not data or amount < 0 or data.cash < amount then
		return false
	end
	data.cash -= amount
	PlayerDataService:Replicate(player)
	return true
end

function EconomyService:AddXp(player: Player, amount: number)
	local data = PlayerDataService:Get(player)
	if not data then
		return
	end
	data.xp += amount
	while data.xp >= data.level * XP_PER_LEVEL do
		data.xp -= data.level * XP_PER_LEVEL
		data.level += 1
	end
	PlayerDataService:Replicate(player)
end

function EconomyService:Init() end

function EconomyService:Start() end

return EconomyService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX30"><Properties><string name="Name">EquipmentService</string><ProtectedString name="Source"><![CDATA[--!strict
-- Buying equipment. The server checks the id, what is already owned, the unlock and the price.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Equipment = require(ReplicatedStorage.Shared.Config.Equipment)
local RateLimit = require(ReplicatedStorage.Shared.Modules.RateLimit)
local Remotes = require(ReplicatedStorage.Shared.Modules.Remotes)
local PlayerDataService = require(script.Parent.PlayerDataService)
local EconomyService = require(script.Parent.EconomyService)

local EquipmentService = {}

-- Effective stats for this player's best equipment in each category.
function EquipmentService:Effects(player: Player): { [string]: number }
	local data = PlayerDataService:Get(player)
	return Equipment.effective(if data then data.equipment else {})
end

function EquipmentService:Init()
	Remotes.func("BuyEquipment").OnServerInvoke = function(player: Player, id: any)
		if not RateLimit.check(player, "BuyEquipment", 0.3) then
			return false, "slow down a little"
		end
		local data = PlayerDataService:Get(player)
		local def = if type(id) == "string" then Equipment.catalog[id] else nil
		if not data or not def or def.price <= 0 then
			return false, "that item is not for sale"
		end
		if data.equipment[def.id] then
			return false, "you already own that"
		end
		if def.requiresMilestone and not data.milestones[def.requiresMilestone] then
			return false, "finish your first order to unlock this"
		end
		if not EconomyService:TrySpend(player, def.price) then
			return false, `you need ${def.price}`
		end
		data.equipment[def.id] = true
		EconomyService:Record(player, "other", def.price)
		PlayerDataService:Replicate(player)
		return true, `Bought the {def.name}!`
	end
end

function EquipmentService:Start() end

return EquipmentService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX31"><Properties><string name="Name">IntegrityService</string><ProtectedString name="Source"><![CDATA[--!strict
-- Integrity audit. All game rules are enforced where the change happens; this is the safety net underneath them. Every
-- minute it checks each player's data for impossible values (NaN, infinity, negatives, empty batches), repairs them to the
-- nearest valid value, and counts what it fixed so a bug or exploit shows up in the metrics instead of in a player's save.
local Players = game:GetService("Players")

local PlayerDataService = require(script.Parent.PlayerDataService)

local IntegrityService = {}

IntegrityService.repairs = 0

local function bad(n: any): boolean
	return type(n) ~= "number" or n ~= n or n == math.huge or n == -math.huge
end

-- Returns the number of repairs made.
function IntegrityService:Audit(player: Player): number
	local data = PlayerDataService:Get(player)
	if not data then
		return 0
	end
	local fixed = 0
	local function fix(label: string)
		fixed += 1
		warn(`[Integrity] repaired {label} for {player.Name}`)
	end

	if bad(data.cash) or data.cash < 0 then
		data.cash = 0
		fix("cash")
	end
	for _, key in { "xp", "reputation" } do
		if bad((data :: any)[key]) or (data :: any)[key] < 0 then
			(data :: any)[key] = 0
			fix(key)
		end
	end
	if bad(data.level) or data.level < 1 then
		data.level = 1
		fix("level")
	end
	for id, n in data.ingredients do
		if bad(n) or n < 0 or n % 1 ~= 0 then
			data.ingredients[id] = if bad(n) or n < 0 then 0 else math.floor(n)
			fix(`ingredient {id}`)
		end
	end
	for i = #data.batches, 1, -1 do
		local b = data.batches[i]
		if bad(b.count) or b.count < 1 or b.count % 1 ~= 0 then
			table.remove(data.batches, i)
			fix("empty batch")
		end
	end
	for key, n in data.stats do
		if bad(n) or n < 0 then
			data.stats[key] = 0
			fix(`stat {key}`)
		end
	end
	if fixed > 0 then
		IntegrityService.repairs += fixed
		PlayerDataService:Replicate(player)
	end
	return fixed
end

function IntegrityService:Init() end

function IntegrityService:Start()
	task.spawn(function()
		while true do
			task.wait(60)
			for _, p in Players:GetPlayers() do
				IntegrityService:Audit(p)
			end
		end
	end)
end

return IntegrityService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX32"><Properties><string name="Name">InteractionService</string><ProtectedString name="Source"><![CDATA[--!strict
-- Server-owned interaction contract. Every station in Workspace carries a tag (e.g. BakeStation) and this
-- service gives it the attributes StationType, OwnerUserId, Capacity and BusyState plus a ProximityPrompt.
-- A trigger is only forwarded to the client after the server checks the station, distance, owner and state.
local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local RateLimit = require(ReplicatedStorage.Shared.Modules.RateLimit)
local Remotes = require(ReplicatedStorage.Shared.Modules.Remotes)

local MAX_DISTANCE = 14 -- studs from the nearest edge of the station
local COOLDOWN = 0.4 -- seconds between interactions per player

type StationDef = { action: string, object: string, panel: string, capacity: number }

local STATION_TYPES: { [string]: StationDef } = {
	BakeStation = { action = "Bake", object = "Kitchen", panel = "Bake", capacity = 1 },
}

local lastUse: { [Player]: number } = {}
local accepted = Remotes.event("InteractionAccepted")

local InteractionService = {}

local function distanceToPart(player: Player, part: BasePart): number?
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not root or not root:IsA("BasePart") then
		return nil
	end
	-- distance to the closest point of the part, so long counters count from their edge
	local localPos = part.CFrame:PointToObjectSpace(root.Position)
	local half = part.Size / 2
	local clamped =
		Vector3.new(math.clamp(localPos.X, -half.X, half.X), math.clamp(localPos.Y, -half.Y, half.Y), math.clamp(localPos.Z, -half.Z, half.Z))
	return (localPos - clamped).Magnitude
end

-- Public: studs from the player's character to the nearest edge of a part (nil if the player has no character).
function InteractionService:DistanceToPart(player: Player, part: BasePart): number?
	return distanceToPart(player, part)
end

-- True if the player is close enough to any station with this tag. Other services use this to guard actions.
function InteractionService:IsNearStation(player: Player, tag: string): boolean
	for _, inst in CollectionService:GetTagged(tag) do
		if inst:IsA("BasePart") and inst:IsDescendantOf(workspace) then
			local d = distanceToPart(player, inst)
			if d and d <= MAX_DISTANCE + 4 then
				return true
			end
		end
	end
	return false
end

-- Moves the player's character to the front of the first station with this tag (used by the HUD Bake shortcut).
function InteractionService:BringToStation(player: Player, tag: string): boolean
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not root or not root:IsA("BasePart") then
		return false
	end
	local target: BasePart? = nil
	for _, inst in CollectionService:GetTagged(tag) do
		if inst:IsA("BasePart") and inst:IsDescendantOf(workspace) then
			if inst.Name == "Counter" or not target then
				target = inst
			end
		end
	end
	if not target then
		return false
	end
	local distance = distanceToPart(player, target)
	if distance and distance <= MAX_DISTANCE - 4 then
		return true -- already close enough, do not move them
	end
	root.CFrame = CFrame.new(target.Position + Vector3.new(0, target.Size.Y / 2 + 3, target.Size.Z / 2 + 4))
	return true
end

local function onTriggered(part: BasePart, tag: string, def: StationDef, player: Player)
	local now = os.clock()
	if now - (lastUse[player] or 0) < COOLDOWN then
		return
	end
	lastUse[player] = now

	if not part:IsDescendantOf(workspace) or not CollectionService:HasTag(part, tag) then
		return
	end
	local d = distanceToPart(player, part)
	if not d or d > MAX_DISTANCE then
		return
	end
	local owner = part:GetAttribute("OwnerUserId")
	if owner ~= 0 and owner ~= player.UserId then
		return -- someone else's station
	end
	if part:GetAttribute("BusyState") == "Busy" then
		return
	end
	accepted:FireClient(player, def.panel)
end

local function setup(part: Instance, tag: string)
	local def = STATION_TYPES[tag]
	if not part:IsA("BasePart") or not def or part:FindFirstChild("StationPrompt") then
		return
	end
	part:SetAttribute("StationType", tag)
	part:SetAttribute("OwnerUserId", 0) -- 0 = public starter station; property ownership arrives in a later milestone
	part:SetAttribute("Capacity", def.capacity)
	part:SetAttribute("BusyState", "Idle")

	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "StationPrompt"
	prompt.ActionText = def.action
	prompt.ObjectText = def.object
	prompt.MaxActivationDistance = 10
	prompt.HoldDuration = 0
	prompt.RequiresLineOfSight = false
	prompt.Parent = part
	prompt.Triggered:Connect(function(player)
		onTriggered(part, tag, def, player)
	end)
end

function InteractionService:Init()
	Remotes.func("GoToKitchen").OnServerInvoke = function(player: Player): boolean
		if not RateLimit.check(player, "GoToKitchen", 1) then
			return false
		end
		return InteractionService:BringToStation(player, "BakeStation")
	end
end

function InteractionService:Start()
	for tag in STATION_TYPES do
		for _, inst in CollectionService:GetTagged(tag) do
			setup(inst, tag)
		end
		CollectionService:GetInstanceAddedSignal(tag):Connect(function(inst)
			setup(inst, tag)
		end)
	end
	Players.PlayerRemoving:Connect(function(p)
		lastUse[p] = nil
	end)
end

return InteractionService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX33"><Properties><string name="Name">InventoryService</string><ProtectedString name="Source"><![CDATA[--!strict
-- The only place that adds or removes ingredients and packaged batches. Every change is checked here so
-- ingredients are consumed exactly once and cookies are handed over exactly once.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Ingredients = require(ReplicatedStorage.Shared.Config.Ingredients)
local DeliveryMath = require(ReplicatedStorage.Shared.Modules.DeliveryMath)
local PlayerDataService = require(script.Parent.PlayerDataService)

local MAX_BATCHES_STORED = 30

local InventoryService = {}

function InventoryService:Count(player: Player, id: string): number
	local data = PlayerDataService:Get(player)
	return if data then data.ingredients[id] or 0 else 0
end

-- Returns nil if the player has everything, otherwise a short sentence naming what is missing.
function InventoryService:Missing(player: Player, need: { [string]: number }): string?
	local data = PlayerDataService:Get(player)
	if not data then
		return "your data is still loading"
	end
	for id, n in need do
		local have = data.ingredients[id] or 0
		if have < n then
			local ing = Ingredients[id]
			return `you need {n} {if ing then ing.name else id} but only have {have}`
		end
	end
	return nil
end

-- All-or-nothing: either every ingredient is removed or none are.
function InventoryService:Consume(player: Player, need: { [string]: number }): boolean
	local data = PlayerDataService:Get(player)
	if not data or InventoryService:Missing(player, need) then
		return false
	end
	for id, n in need do
		data.ingredients[id] -= n
	end
	PlayerDataService:Replicate(player)
	return true
end

function InventoryService:Add(player: Player, id: string, qty: number)
	local data = PlayerDataService:Get(player)
	if data and Ingredients[id] and qty > 0 then
		data.ingredients[id] = (data.ingredients[id] or 0) + qty
		PlayerDataService:Replicate(player)
	end
end

function InventoryService:Units(player: Player): number
	local data = PlayerDataService:Get(player)
	return if data then DeliveryMath.units(data) else 0
end

function InventoryService:Capacity(player: Player): number
	local data = PlayerDataService:Get(player)
	return if data then DeliveryMath.capacity(data) else 0
end

function InventoryService:HasRoomForBatch(player: Player): boolean
	local data = PlayerDataService:Get(player)
	return data ~= nil and #data.batches < MAX_BATCHES_STORED
end

function InventoryService:AddBatch(player: Player, batch: any)
	local data = PlayerDataService:Get(player)
	if data then
		table.insert(data.batches, batch)
		PlayerDataService:Replicate(player)
	end
end

function InventoryService:FindBatch(player: Player, batchId: number): any?
	local data = PlayerDataService:Get(player)
	if not data then
		return nil
	end
	for _, b in data.batches do
		if b.id == batchId then
			return b
		end
	end
	return nil
end

function InventoryService:Reserve(player: Player, batchId: number, orderId: number): boolean
	local batch = InventoryService:FindBatch(player, batchId)
	if not batch or batch.reservedFor or batch.displayed then
		return false
	end
	batch.reservedFor = orderId
	PlayerDataService:Replicate(player)
	return true
end

function InventoryService:Release(player: Player, batchId: number)
	local batch = InventoryService:FindBatch(player, batchId)
	if batch then
		batch.reservedFor = nil
		PlayerDataService:Replicate(player)
	end
end

-- Removes qty cookies from a batch (deleting the batch when empty). Returns false if there are not enough.
function InventoryService:TakeCookies(player: Player, batchId: number, qty: number): boolean
	local data = PlayerDataService:Get(player)
	if not data then
		return false
	end
	for i, b in data.batches do
		if b.id == batchId then
			if b.count < qty then
				return false
			end
			b.count -= qty
			b.reservedFor = nil
			if b.count <= 0 then
				table.remove(data.batches, i)
			end
			PlayerDataService:Replicate(player)
			return true
		end
	end
	return false
end

function InventoryService:NextBatchId(player: Player): number
	local data = PlayerDataService:Get(player)
	if not data then
		return 0
	end
	local id = data.nextBatchId
	data.nextBatchId += 1
	return id
end

function InventoryService:Init() end

function InventoryService:Start() end

return InventoryService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX34"><Properties><string name="Name">MarketService</string><ProtectedString name="Source"><![CDATA[--!strict
-- Market: rotating events (see Config/Market), rival-backed contracts, and a lifetime-earnings leaderboard.
-- A contract is one big order at a time: deliver 12 cookies of one recipe at a minimum score before it expires. If you
-- let it expire, a rival wins it - there is no other penalty. The leaderboard is best-effort: if the ordered store is
-- unavailable the game simply shows an empty board.
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Market = require(ReplicatedStorage.Shared.Config.Market)
local Recipes = require(ReplicatedStorage.Shared.Config.Recipes)
local RateLimit = require(ReplicatedStorage.Shared.Modules.RateLimit)
local Remotes = require(ReplicatedStorage.Shared.Modules.Remotes)
local PlayerDataService = require(script.Parent.PlayerDataService)
local EconomyService = require(script.Parent.EconomyService)
local InventoryService = require(script.Parent.InventoryService)

local BOARD_NAME = "LifetimeGross_v1"
local BOARD_TTL = 60

local board: { { name: string, gross: number } } = {}
local boardAt = -math.huge

local MarketService = {}

local function notify(player: Player, text: string)
	Remotes.event("Notify"):FireClient(player, text)
end

-- Creates a contract if the player has none and the cooldown is over; expires an old one. Returns true if data changed.
function MarketService:Refresh(player: Player): boolean
	local data = PlayerDataService:Get(player)
	if not data or data.level < 2 then
		return false
	end
	local now = os.time()
	local changed = false
	local c = data.contract
	if c and now >= c.expiresAt then
		local rival = "A rival"
		for _, r in Market.rivals do
			if r.id == c.rivalId then
				rival = r.name
			end
		end
		data.contract = false
		data.contractLosses += 1
		data.contractNextAt = now + Market.CONTRACT_COOLDOWN
		notify(player, `{rival} won the contract you did not finish. More will come.`)
		changed = true
	end
	if not data.contract and now >= data.contractNextAt then
		local pool = {}
		for id in data.recipes do
			if Recipes.catalog[id] then
				table.insert(pool, id)
			end
		end
		table.sort(pool)
		if #pool > 0 then
			local recipeId = pool[math.random(#pool)]
			local recipe = Recipes.catalog[recipeId]
			local rival = Market.rivals[math.random(#Market.rivals)]
			local per = (Market.CONTRACT_COUNT * 45 / 6 + 3) * (recipe.priceMult or 1)
			data.contract = {
				rivalId = rival.id,
				recipeId = recipeId,
				count = Market.CONTRACT_COUNT,
				minScore = Market.CONTRACT_MIN_SCORE,
				pay = math.floor(per * Market.CONTRACT_PREMIUM + 0.5),
				expiresAt = now + Market.CONTRACT_LIFETIME,
			}
			notify(player, `New contract: {recipe.name} for ${data.contract.pay}. {rival.name} wants it too.`)
			changed = true
		end
	end
	if changed then
		PlayerDataService:Replicate(player)
	end
	return changed
end

-- Hands over matching cookies. Atomic: either the whole contract is filled or nothing changes.
function MarketService:Fulfil(player: Player): (boolean, string)
	local data = PlayerDataService:Get(player)
	if not data then
		return false, "loading"
	end
	MarketService:Refresh(player)
	local c = data.contract
	if not c then
		return false, "you have no contract right now"
	end
	local usable = {}
	local have = 0
	for _, b in data.batches do
		if b.recipeId == c.recipeId and b.score >= c.minScore and not b.displayed and not b.reservedFor then
			table.insert(usable, b)
			have += b.count
		end
	end
	if have < c.count then
		return false, `Need {c.count} {Recipes.catalog[c.recipeId].name} cookies at score {c.minScore}+ (not on display or promised). You have {have}.`
	end
	local left = c.count
	local tags = usable[1].tags
	for _, b in usable do
		if left <= 0 then
			break
		end
		local take = math.min(b.count, left)
		InventoryService:TakeCookies(player, b.id, take)
		left -= take
	end
	local pay = math.floor(c.pay * Market.eventMult(Market.currentEvent(os.time()), tags) + 0.5)
	data.contract = false
	data.contractWins += 1
	data.contractNextAt = os.time() + Market.CONTRACT_COOLDOWN
	data.reputation += Market.CONTRACT_REPUTATION
	EconomyService:AddCash(player, pay)
	EconomyService:Record(player, "gross", pay)
	EconomyService:AddXp(player, 60)
	PlayerDataService:Replicate(player)
	return true, `Contract complete! You earned ${pay} and {Market.CONTRACT_REPUTATION} reputation.`
end

local function pushScore(player: Player)
	local data = PlayerDataService:Get(player)
	if not data or not PlayerDataService:IsPersistent(player) then
		return
	end
	pcall(function()
		DataStoreService:GetOrderedDataStore(BOARD_NAME):SetAsync(tostring(player.UserId), data.stats.gross)
	end)
end

function MarketService:Board(): { { name: string, gross: number } }
	if os.clock() - boardAt < BOARD_TTL then
		return board
	end
	boardAt = os.clock()
	local ok, pages = pcall(function()
		return DataStoreService:GetOrderedDataStore(BOARD_NAME):GetSortedAsync(false, 10)
	end)
	if ok and pages then
		local out = {}
		local okp, items = pcall(function()
			return pages:GetCurrentPage()
		end)
		if okp then
			for _, item in items do
				local name = "Baker"
				local okn, n = pcall(function()
					return Players:GetNameFromUserIdAsync(tonumber(item.key) or 0)
				end)
				if okn and type(n) == "string" then
					name = n
				end
				table.insert(out, { name = name, gross = item.value })
			end
			board = out
		end
	end
	return board
end

function MarketService:Init()
	Remotes.func("MarketStatus").OnServerInvoke = function(player: Player): any
		if not RateLimit.check(player, "MarketStatus", 1) then
			return nil
		end
		MarketService:Refresh(player)
		local now = os.time()
		return { event = Market.currentEvent(now), secondsLeft = Market.secondsLeft(now), board = MarketService:Board() }
	end
	Remotes.func("ContractDeliver").OnServerInvoke = function(player: Player): (boolean, string)
		if not RateLimit.check(player, "ContractDeliver", 0.5) then
			return false, "slow down a little"
		end
		return MarketService:Fulfil(player)
	end
	Players.PlayerRemoving:Connect(pushScore)
end

function MarketService:Start()
	task.spawn(function()
		while true do
			task.wait(60)
			for _, p in Players:GetPlayers() do
				MarketService:Refresh(p)
				pushScore(p)
			end
		end
	end)
end

return MarketService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX35"><Properties><string name="Name">MetricsService</string><ProtectedString name="Source"><![CDATA[--!strict
-- Operational counters, printed as one log line every five minutes so a live server's health can be read from the
-- developer console. Nothing leaves the server: there is no external analytics.
local Players = game:GetService("Players")

local RateLimit = require(game:GetService("ReplicatedStorage").Shared.Modules.RateLimit)
local PlayerDataService = require(script.Parent.PlayerDataService)
local IntegrityService = require(script.Parent.IntegrityService)

local MetricsService = {}

function MetricsService:Snapshot(): { [string]: any }
	local rejected = 0
	local worst, worstKey = 0, ""
	for key, n in RateLimit.rejected do
		rejected += n
		if n > worst then
			worst, worstKey = n, key
		end
	end
	local unsaved = 0
	for _, p in Players:GetPlayers() do
		if PlayerDataService:Get(p) and not PlayerDataService:IsPersistent(p) then
			unsaved += 1
		end
	end
	return {
		players = #Players:GetPlayers(),
		unsavedPlayers = unsaved,
		loadErrors = PlayerDataService.errors.load,
		saveErrors = PlayerDataService.errors.save,
		malformedSaves = PlayerDataService.errors.malformed,
		integrityRepairs = IntegrityService.repairs,
		rateLimited = rejected,
		noisiestRemote = worstKey,
	}
end

function MetricsService:Init() end

function MetricsService:Start()
	task.spawn(function()
		while true do
			task.wait(300)
			local s = MetricsService:Snapshot()
			print(`[Metrics] players={s.players} unsaved={s.unsavedPlayers} loadErr={s.loadErrors} saveErr={s.saveErrors} malformed={s.malformedSaves} repairs={s.integrityRepairs} rateLimited={s.rateLimited} noisiest={s.noisiestRemote}`)
		end
	end)
end

return MetricsService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX36"><Properties><string name="Name">OrderService</string><ProtectedString name="Source"><![CDATA[--!strict
-- Customer orders and their lifecycle: Available -> Accepted -> In Production -> Ready -> Delivered -> Paid.
-- The server owns every state change; the client only asks ("accept", "cancel", "assign", "deliver").
-- A seeded first order (no deadline) is offered to every new player so the first loop never needs admin help.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local CustomerTemplates = require(ReplicatedStorage.Shared.Config.Customers)
local Dialogue = require(ReplicatedStorage.Shared.Config.Dialogue)
local Market = require(ReplicatedStorage.Shared.Config.Market)
local Recipes = require(ReplicatedStorage.Shared.Config.Recipes)
local RateLimit = require(ReplicatedStorage.Shared.Modules.RateLimit)
local Remotes = require(ReplicatedStorage.Shared.Modules.Remotes)
local PlayerDataService = require(script.Parent.PlayerDataService)
local EconomyService = require(script.Parent.EconomyService)
local InventoryService = require(script.Parent.InventoryService)

local TICK = 5 -- seconds between expiry checks
local SPAWN_EVERY = 30 -- seconds between new random orders per player
local MAX_ACTIVE_ORDERS = 3
local ORDER_LIFETIME = 600 -- seconds; random orders only, the first order never expires
local FIRST_RECIPE = "classic_chip"
local ANY = "any" -- an order for "something new" accepts any recipe, including experiments
local DESTINATION = "Starter Apartment doorstep"
local REL_LEVELS: { { points: number, name: string } } = {
	{ points = 0, name = "Stranger" },
	{ points = 10, name = "Customer" },
	{ points = 30, name = "Regular" },
	{ points = 70, name = "Fan" },
	{ points = 150, name = "Superfan" },
}

local ORDER_TEXT: { [string]: string } = {
	Neighbor = "Hi neighbor! I'm hosting book club. Could you bake {count} {recipe} for us?",
	Foodie = "Hi! I'd love {count} {recipe}. Quality matters to me.",
	BargainHunter = "Hey, got a deal on {count} {recipe}? Nothing fancy.",
	SweetTooth = "I NEED {count} {recipe}. The sweeter the better!",
	HealthNut = "Could I get {count} {recipe}? Not too sweet, thanks!",
	Trendsetter = "Make me {count} cookies nobody has tried yet! Surprise me.",
	Grump = "{count} {recipe}. Don't disappoint me.",
}

local REACTIONS = {
	great = { "Oh wow. These are perfect.", "Okay, you've outdone yourself.", "I'm telling everyone about you." },
	ok = { "These are pretty good.", "Not bad at all.", "Thanks, that hits the spot." },
	bad = { "Hmm. Not really what I wanted.", "These aren't great.", "I expected better." },
}

export type OrderState = "Available" | "Accepted" | "In Production" | "Ready" | "Delivered" | "Paid"

type Order = {
	id: number,
	customerId: string,
	recipeId: string,
	count: number,
	offer: number,
	state: OrderState,
	deadline: number?, -- os.time(); nil = never expires
	destination: string,
	batchId: number?,
	isFirst: boolean,
}

local orders: { [Player]: { [number]: Order } } = {}
local nextOrderId = 1
local templatesById: { [string]: any } = {}
for _, t in CustomerTemplates do
	templatesById[t.id] = t
end

local OrderService = {}

local function relLevel(points: number): string
	local name = REL_LEVELS[1].name
	for _, entry in REL_LEVELS do
		if points >= entry.points then
			name = entry.name
		end
	end
	return name
end

local function customerState(data: any, id: string): any
	local s = data.customers[id]
	if not s then
		s = { rel = 0, memory = {} }
		data.customers[id] = s
	end
	return s
end

local function activeFor(player: Player): { [number]: Order }
	local t = orders[player]
	if not t then
		t = {}
		orders[player] = t
	end
	return t
end

local function view(order: Order): any
	local t = templatesById[order.customerId]
	local recipe = Recipes.catalog[order.recipeId]
	local recipeName = if recipe then recipe.name else "any new recipe"
	local text = (ORDER_TEXT[t.personality] :: string):gsub("{count}", tostring(order.count)):gsub("{recipe}", recipeName)
	return {
		id = order.id,
		customerName = t.name,
		personality = t.personality,
		text = text,
		count = order.count,
		recipeId = order.recipeId,
		recipeName = recipeName,
		offer = order.offer,
		state = order.state,
		deadline = order.deadline,
		destination = order.destination,
		batchId = order.batchId,
		isFirst = order.isFirst,
	}
end

local function push(player: Player)
	local list: { any } = {}
	for _, o in activeFor(player) do
		table.insert(list, view(o))
	end
	table.sort(list, function(a: any, b: any)
		return a.id < b.id
	end)
	Remotes.event("OrdersUpdated"):FireClient(player, list)
end

local function notify(player: Player, text: string)
	Remotes.event("Notify"):FireClient(player, text)
end

local function pickRecipe(player: Player, t: any, isFirst: boolean): string
	if isFirst then
		return FIRST_RECIPE
	end
	if t.personality == "Trendsetter" then
		return ANY
	end
	local data = PlayerDataService:Get(player)
	local pool = {}
	if data then
		for id in data.recipes do
			if Recipes.catalog[id] then
				table.insert(pool, id)
			end
		end
	end
	table.sort(pool)
	return if #pool > 0 then pool[math.random(#pool)] else FIRST_RECIPE
end

local function newOrder(player: Player, t: any, count: number, isFirst: boolean)
	local recipeId = pickRecipe(player, t, isFirst)
	local recipe = Recipes.catalog[recipeId]
	local mult = if recipe then recipe.priceMult or 1 else 1.3 -- novelty pays a little extra
	local order: Order = {
		id = nextOrderId,
		customerId = t.id,
		recipeId = recipeId,
		count = count,
		offer = math.floor((count * t.budget / 6 + 3) * mult + 0.5),
		state = "Available",
		deadline = if isFirst then nil else os.time() + ORDER_LIFETIME,
		destination = DESTINATION,
		batchId = nil,
		isFirst = isFirst,
	}
	nextOrderId += 1
	activeFor(player)[order.id] = order
	push(player)
	notify(player, `New order from {t.name}! Open your phone (P).`)
end

local function countActive(player: Player): number
	local n = 0
	for _ in activeFor(player) do
		n += 1
	end
	return n
end

-- Offers the free starter order until the player has completed one.
local function ensureFirstOrder(player: Player)
	local data = PlayerDataService:Get(player)
	if not data or data.milestones.firstOrderDone then
		return
	end
	if countActive(player) == 0 then
		newOrder(player, templatesById.parkway, 6, true)
	end
end

local function spawnRandomOrder(player: Player)
	local data = PlayerDataService:Get(player)
	if not data or not data.milestones.firstOrderDone or countActive(player) >= MAX_ACTIVE_ORDERS then
		return
	end
	local busy = {}
	for _, o in activeFor(player) do
		busy[o.customerId] = true
	end
	local pool = {}
	for _, t in CustomerTemplates do
		if not busy[t.id] then
			table.insert(pool, t)
		end
	end
	if #pool > 0 then
		newOrder(player, pool[math.random(#pool)], math.random(2, 6), false)
	end
end

local function satisfaction(batch: any, t: any): number
	local taste = 0.6
	for _, tag in t.loves do
		if table.find(batch.tags, tag) then
			taste += 0.2
		end
	end
	for _, tag in t.hates do
		if table.find(batch.tags, tag) then
			taste -= 0.4
		end
	end
	taste = math.clamp(taste, 0, 1)

	local fit = 1
	if batch.appeal < t.appealMin then
		fit = math.clamp(1 - (t.appealMin - batch.appeal) / 30, 0, 1)
	elseif batch.appeal > t.appealMax then
		fit = math.clamp(1 - (batch.appeal - t.appealMax) / 30, 0, 1)
	end
	return 0.4 * taste + 0.3 * fit + 0.3 * batch.quality
end

local function getOrder(player: Player, orderId: any): Order?
	if type(orderId) ~= "number" then
		return nil
	end
	return activeFor(player)[orderId]
end

-- Removes an order without paying. Anything reserved for it goes back to stock.
local function drop(player: Player, order: Order)
	if order.batchId then
		InventoryService:Release(player, order.batchId)
		order.batchId = nil
	end
	activeFor(player)[order.id] = nil
end

local function penalize(player: Player, order: Order)
	local data = PlayerDataService:Get(player)
	if data and data.milestones.firstOrderDone and order.state ~= "Available" then
		local s = customerState(data, order.customerId)
		s.rel = math.max(0, s.rel - 1)
		PlayerDataService:Replicate(player)
	end
end

-- Curated answers to the preset questions. `questionId` must be one of Dialogue.questions.
local function answer(order: Order, questionId: any): string?
	local t = templatesById[order.customerId]
	if questionId == "flavor" then
		local words = {}
		for _, tag in t.loves do
			table.insert(words, Dialogue.tagWords[tag] or tag)
		end
		if #words == 0 then
			return "Surprise me! I like most things."
		end
		return `I'm really into {table.concat(words, " and ")}.`
	elseif questionId == "deadline" then
		if order.deadline then
			local minutes = math.max(1, math.ceil((order.deadline - os.time()) / 60))
			return `About {minutes} minute{if minutes == 1 then "" else "s"} from now would be great.`
		end
		return "No rush at all. Whenever you're ready!"
	elseif questionId == "where" then
		return `Bring them to the {order.destination}, please.`
	elseif questionId == "budget" then
		return `I can pay around ${order.offer}, more if they're really good.`
	end
	return nil
end

local function deliver(player: Player, order: Order): (boolean, any)
	local data = PlayerDataService:Get(player)
	if not data or order.state ~= "Ready" or not order.batchId then
		return false, "this order is not ready to hand over"
	end
	local batch = InventoryService:FindBatch(player, order.batchId)
	if not batch or batch.count < order.count then
		order.state = "Accepted"
		order.batchId = nil
		push(player)
		return false, "the cookies for this order are gone; bake or assign a new box"
	end

	-- State moves first and the order leaves the table in the same step, so a payout can never happen twice.
	order.state = "Delivered"
	activeFor(player)[order.id] = nil
	InventoryService:TakeCookies(player, batch.id, order.count)

	local t = templatesById[order.customerId]
	local state = customerState(data, t.id)
	local sat = satisfaction(batch, t)
	local eventMult = Market.eventMult(Market.currentEvent(os.time()), batch.tags)
	local pay = math.floor(order.offer * (0.5 + sat) * eventMult + 0.5)
	local tip = 0
	if sat > 0.85 then
		tip = math.floor(order.offer * 0.2)
	end
	order.state = "Paid"
	EconomyService:AddCash(player, pay + tip)
	EconomyService:Record(player, "gross", pay + tip)
	data.stats.orders += 1
	EconomyService:AddXp(player, math.floor(10 + sat * 20))

	state.rel = math.max(0, state.rel + math.floor(sat * 10) - 4)
	table.insert(state.memory, { name = batch.name, quality = batch.quality, appeal = batch.appeal, sat = sat })
	if #state.memory > 5 then
		table.remove(state.memory, 1)
	end
	local wasFirst = not data.milestones.firstOrderDone
	data.milestones.firstOrderDone = true

	table.insert(data.history, 1, { customer = t.name, recipe = batch.name, pay = pay + tip, grade = batch.grade or "", t = os.time() })
	while #data.history > 10 do
		table.remove(data.history)
	end

	local pool = if sat > 0.75 then REACTIONS.great elseif sat > 0.45 then REACTIONS.ok else REACTIONS.bad
	PlayerDataService:Replicate(player)
	push(player)
	return true,
		{
			customerName = t.name,
			pay = pay,
			tip = tip,
			satisfaction = sat,
			reaction = pool[math.random(#pool)],
			relationship = relLevel(state.rel),
			grade = batch.grade,
			feedback = batch.feedback,
			states = { "Available", "Accepted", "In Production", "Ready", "Delivered", "Paid" },
			wasFirst = wasFirst,
		}
end

-- Called by BakingService --------------------------------------------------------------------------------

function OrderService:CanProduce(player: Player, orderId: number, recipeId: string, _custom: boolean?): boolean
	local order = getOrder(player, orderId)
	return order ~= nil and order.state == "Accepted" and (order.recipeId == ANY or order.recipeId == recipeId)
end

function OrderService:BeginProduction(player: Player, orderId: number): boolean
	local order = getOrder(player, orderId)
	if not order or order.state ~= "Accepted" then
		return false
	end
	order.state = "In Production"
	push(player)
	return true
end

-- Attach a finished batch. Returns false if the order was cancelled or expired meanwhile (batch stays in stock).
function OrderService:MarkReady(player: Player, orderId: number, batchId: number): boolean
	local order = getOrder(player, orderId)
	if not order or order.state ~= "In Production" then
		return false
	end
	if not InventoryService:Reserve(player, batchId, order.id) then
		return false
	end
	order.state = "Ready"
	order.batchId = batchId
	push(player)
	notify(player, `Your {order.count} cookies are ready. Open the phone to deliver them.`)
	return true
end

function OrderService:Init()
	Remotes.func("GetOrders").OnServerInvoke = function(player: Player)
		local list: { any } = {}
		for _, o in activeFor(player) do
			table.insert(list, view(o))
		end
		table.sort(list, function(a: any, b: any)
			return a.id < b.id
		end)
		return list
	end

	Remotes.func("OrderAction").OnServerInvoke = function(player: Player, action: any, orderId: any, extra: any)
		if not RateLimit.check(player, "OrderAction", 0.2) then
			return false, "slow down a little"
		end
		if type(action) ~= "string" then
			return false, "bad request"
		end
		local order = getOrder(player, orderId)
		if not order then
			return false, "that order is gone"
		end

		if action == "accept" then
			if order.state ~= "Available" then
				return false, "you already accepted this order"
			end
			order.state = "Accepted"
			push(player)
			return true, "Accepted. Walk to your kitchen counter and press E to bake."
		elseif action == "cancel" then
			if order.state == "Delivered" or order.state == "Paid" then
				return false, "that order is already finished"
			end
			local msg = if order.state == "Available"
				then "Declined. No penalty."
				else "Cancelled. Anything already baked stays in your stock. Backing out after accepting can cost goodwill later."
			penalize(player, order)
			drop(player, order)
			push(player)
			ensureFirstOrder(player) -- no-op once the first order has been completed
			return true, msg
		elseif action == "assign" then
			if order.state ~= "Accepted" then
				return false, "accept the order first"
			end
			if type(extra) ~= "number" then
				return false, "pick a box"
			end
			local batch = InventoryService:FindBatch(player, extra)
			if not batch or batch.reservedFor or (order.recipeId ~= ANY and batch.recipeId ~= order.recipeId) then
				return false, "that box does not match this order"
			end
			if batch.count < order.count then
				return false, `this order needs {order.count} cookies; that box has {batch.count}`
			end
			if not InventoryService:Reserve(player, batch.id, order.id) then
				return false, "that box is already taken"
			end
			order.state = "Ready"
			order.batchId = batch.id
			push(player)
			return true, "Box set aside. Deliver it when you're ready."
		elseif action == "deliver" then
			return deliver(player, order)
		elseif action == "ask" then
			local reply = answer(order, extra)
			if not reply then
				return false, "unknown question"
			end
			return true, reply
		end
		return false, "unknown action"
	end
end

function OrderService:Start()
	PlayerDataService.Reset:Connect(function(player: Player)
		orders[player] = {}
		push(player)
		ensureFirstOrder(player)
	end)
	local function onJoin(player: Player)
		for _ = 1, 60 do
			if PlayerDataService:Get(player) or not player.Parent then
				break
			end
			task.wait(0.5)
		end
		if player.Parent then
			ensureFirstOrder(player)
		end
	end
	Players.PlayerAdded:Connect(function(p)
		task.spawn(onJoin, p)
	end)
	for _, p in Players:GetPlayers() do
		task.spawn(onJoin, p)
	end
	Players.PlayerRemoving:Connect(function(p)
		orders[p] = nil
	end)

	local elapsed = 0
	while true do
		task.wait(TICK)
		elapsed += TICK
		local spawnNow = elapsed >= SPAWN_EVERY
		if spawnNow then
			elapsed = 0
		end
		for _, player in Players:GetPlayers() do
			local changed = false
			for id, o in activeFor(player) do
				if o.deadline and os.time() >= o.deadline and o.state ~= "Ready" then
					penalize(player, o)
					drop(player, o)
					activeFor(player)[id] = nil
					changed = true
					notify(player, "An order expired. No big deal, new ones are coming.")
				end
			end
			if changed then
				push(player)
			end
			ensureFirstOrder(player)
			if spawnNow then
				spawnRandomOrder(player)
			end
		end
	end
end

return OrderService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX37"><Properties><string name="Name">PlayerDataService</string><ProtectedString name="Source"><![CDATA[--!strict
-- Per-player saved data: DataStore with a simple session lock, schema versions, migrations, retries and logging.
-- Every profile that reaches the rest of the game has been through DataSchema.sanitize, so services can rely on its shape.
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local DataSchema = require(ReplicatedStorage.Shared.Modules.DataSchema)
local RateLimit = require(ReplicatedStorage.Shared.Modules.RateLimit)
local Remotes = require(ReplicatedStorage.Shared.Modules.Remotes)

local STORE_NAME = "CookieDistributor_v1"
local LOCK_TIMEOUT = 120 -- seconds before a dead server's lock is ignored
local AUTOSAVE_INTERVAL = 60
local LOAD_ATTEMPTS = 4
local SAVE_ATTEMPTS = 3
local DEV_USER_IDS: { [number]: boolean } = {} -- add a UserId here to allow the dev reset outside Studio

export type Data = any

local PlayerDataService = {}

local store = DataStoreService:GetDataStore(STORE_NAME)
local profiles: { [Player]: Data } = {}
local unsaved: { [Player]: boolean } = {} -- profiles that failed to load: never overwrite the real save
local changedEvent = Instance.new("BindableEvent")
local resetEvent = Instance.new("BindableEvent")
PlayerDataService.Changed = changedEvent.Event :: RBXScriptSignal
PlayerDataService.Reset = resetEvent.Event :: RBXScriptSignal
PlayerDataService.errors = { load = 0, save = 0, malformed = 0 } -- read by the metrics/launch checks

local stateRemote = Remotes.event("StateUpdated")

local function key(player: Player): string
	return `Player_{player.UserId}`
end

-- Returns the profile, or nil plus a reason when the save must not be touched ("locked", "newer", "error").
local function load(player: Player): (Data?, string?)
	local reason = "error"
	for attempt = 1, LOAD_ATTEMPTS do
		local locked = false
		local ok, result = pcall(function()
			return store:UpdateAsync(key(player), function(old: any)
				if old ~= nil and type(old) ~= "table" then
					old = nil -- malformed record: start clean (the next save replaces it)
				end
				if old and old.lock and old.lock.jobId ~= game.JobId and os.time() - old.lock.time < LOCK_TIMEOUT then
					locked = true
					return nil
				end
				local record = old or {}
				record.lock = { jobId = game.JobId, time = os.time() }
				return record
			end)
		end)
		if ok and result then
			local raw = result.data
			if type(raw) == "table" and type(raw.schemaVersion) == "number" and raw.schemaVersion > DataSchema.VERSION then
				warn(`[PlayerDataService] {player.Name} has data from a newer version ({raw.schemaVersion}); not loading it`)
				return nil, "newer"
			end
			if raw ~= nil and type(raw) ~= "table" then
				PlayerDataService.errors.malformed += 1
				warn(`[PlayerDataService] malformed save for {player.Name}; using defaults`)
				raw = nil
			end
			return DataSchema.sanitize(DataSchema.migrate(raw)), nil
		end
		if ok and locked then
			reason = "locked"
			task.wait(3)
		elseif not ok then
			PlayerDataService.errors.load += 1
			warn(`[PlayerDataService] load attempt {attempt} for {player.Name} failed: {result}`)
			-- an unpublished place, or Studio without API access, can never reach the DataStore: do not make the player wait
			local text = string.lower(tostring(result))
			if string.find(text, "publish", 1, true) or string.find(text, "studio access", 1, true) or string.find(text, "studioaccesstoapis", 1, true) then
				return nil, "offline"
			end
			task.wait(2 ^ attempt)
		end
	end
	return nil, reason
end

local function save(player: Player, release: boolean): boolean
	local data = profiles[player]
	if not data or unsaved[player] then
		return false
	end
	local lastError: any = nil
	for attempt = 1, SAVE_ATTEMPTS do
		local ok, err = pcall(function()
			store:UpdateAsync(key(player), function(old: any)
				if type(old) == "table" and old.lock and old.lock.jobId ~= game.JobId then
					return nil -- another server took over; do not overwrite
				end
				return { data = data, lock = if release then nil else { jobId = game.JobId, time = os.time() } }
			end)
		end)
		if ok then
			return true
		end
		lastError = err
		PlayerDataService.errors.save += 1
		warn(`[PlayerDataService] save attempt {attempt} for {player.Name} failed: {err}`)
		if attempt < SAVE_ATTEMPTS then
			task.wait(2 ^ (attempt - 1))
		end
	end
	warn(`[PlayerDataService] GAVE UP saving {player.Name}: {lastError}`)
	return false
end

function PlayerDataService:Get(player: Player): Data?
	return profiles[player]
end

-- True when this profile will be written back to the DataStore.
function PlayerDataService:IsPersistent(player: Player): boolean
	return profiles[player] ~= nil and not unsaved[player]
end

function PlayerDataService:SaveNow(player: Player): boolean
	return save(player, false)
end

-- Call after any change so the client UI and other services stay in sync.
function PlayerDataService:Replicate(player: Player)
	local data = profiles[player]
	if data then
		stateRemote:FireClient(player, data)
		changedEvent:Fire(player)
	end
end

local function onJoin(player: Player)
	local data, reason = load(player)
	if not player.Parent then
		return
	end
	if not data then
		warn(`[PlayerDataService] could not load {player.Name} ({reason}); using temporary data that will NOT be saved`)
		data = DataSchema.default()
		unsaved[player] = true
		Remotes.event("Notify"):FireClient(player, "We could not load your saved progress. You can play, but nothing will be saved this session.")
	end
	profiles[player] = data
	print(`[PlayerDataService] save ready for {player.Name} (saved: {not unsaved[player]})`)
	PlayerDataService:Replicate(player)
end

local function onLeave(player: Player)
	save(player, true)
	profiles[player] = nil
	unsaved[player] = nil
end

function PlayerDataService:Init()
	Remotes.func("GetState").OnServerInvoke = function(player: Player)
		-- the client asks as soon as it starts, often before the save has finished loading: wait for it
		local waited = 0
		while not profiles[player] and player.Parent and waited < 20 do
			task.wait(0.25)
			waited += 0.25
		end
		return profiles[player]
	end

	-- Dev-only reset: Studio sessions and listed UserIds only. Normal players are refused on the server.
	Remotes.func("DevReset").OnServerInvoke = function(player: Player)
		if not RateLimit.check(player, "DevReset", 1) then
			return false
		end
		if not (RunService:IsStudio() or DEV_USER_IDS[player.UserId]) or not profiles[player] then
			return false
		end
		profiles[player] = DataSchema.default()
		resetEvent:Fire(player)
		PlayerDataService:Replicate(player)
		return true
	end
end

function PlayerDataService:Start()
	Players.PlayerAdded:Connect(function(p)
		task.spawn(onJoin, p)
	end)
	Players.PlayerRemoving:Connect(onLeave)
	for _, p in Players:GetPlayers() do
		task.spawn(onJoin, p)
	end

	task.spawn(function()
		while true do
			task.wait(AUTOSAVE_INTERVAL)
			for p in profiles do
				task.spawn(function()
					if not save(p, false) and profiles[p] and not unsaved[p] then
						Remotes.event("Notify"):FireClient(p, "Your progress could not be saved just now. We will keep trying.")
					end
				end)
			end
		end
	end)

	game:BindToClose(function()
		if RunService:IsStudio() then
			return
		end
		for p in profiles do
			task.spawn(save, p, true)
		end
		task.wait(3)
	end)
end

return PlayerDataService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX38"><Properties><string name="Name">ProgressService</string><ProtectedString name="Source"><![CDATA[--!strict
-- Awards business milestones from saved data and keeps new players out of dead ends.
--  * Milestones: checked whenever a profile changes; each one is awarded once.
--  * Recovery: a player with no cash, no ingredients, no cookies and no order in progress gets a small
--    supply kit (at most one per RECOVERY_COOLDOWN), so a bad purchase can never end the game.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local AppsConfig = require(ReplicatedStorage.Shared.Config.Apps)
local Milestones = require(ReplicatedStorage.Shared.Config.Milestones)
local RateLimit = require(ReplicatedStorage.Shared.Modules.RateLimit)
local Recipes = require(ReplicatedStorage.Shared.Config.Recipes)
local Remotes = require(ReplicatedStorage.Shared.Modules.Remotes)
local PlayerDataService = require(script.Parent.PlayerDataService)
local InventoryService = require(script.Parent.InventoryService)

local RECOVERY_COOLDOWN = 300 -- seconds
local RECOVERY_CASH_LIMIT = 10 -- only when this poor
local RECOVERY_KIT: { [string]: number } = { flour = 2, butter = 1, white_sugar = 1, chocolate_chips = 1 }

local lastKit: { [Player]: number } = {}
local checking: { [Player]: boolean } = {}

local ProgressService = {}

local function canBakeSomething(data: any): boolean
	for _, recipe in Recipes.catalog do
		local ok = true
		for id, n in recipe.requires do
			if (data.ingredients[id] or 0) < n then
				ok = false
			end
		end
		if ok then
			return true
		end
	end
	return false
end

function ProgressService:Check(player: Player)
	local data = PlayerDataService:Get(player)
	if not data or checking[player] then
		return
	end
	checking[player] = true
	local changed = false
	for _, m in Milestones.list do
		if not data.milestones[m.id] and m.done(data) then
			data.milestones[m.id] = true
			changed = true
			Remotes.event("Notify"):FireClient(player, `Milestone reached: {m.title}`)
		end
	end

	for id, recipe in Recipes.catalog do
		if not data.recipes[id] and (recipe.unlockLevel or 1) <= data.level then
			data.recipes[id] = true
			changed = true
			Remotes.event("Notify"):FireClient(player, `New recipe unlocked: {recipe.name}`)
		end
	end

	if data.cash <= RECOVERY_CASH_LIMIT and #data.batches == 0 and not canBakeSomething(data) then
		local now = os.clock()
		if now - (lastKit[player] or -math.huge) >= RECOVERY_COOLDOWN then
			lastKit[player] = now
			for id, n in RECOVERY_KIT do
				InventoryService:Add(player, id, n)
			end
			Remotes.event("Notify"):FireClient(player, "A neighbor left a basket of baking supplies on your doorstep. Back to work!")
			changed = true
		end
	end
	checking[player] = nil
	if changed then
		PlayerDataService:Replicate(player)
	end
end

function ProgressService:Init()
	-- The phone tells us an app was opened so its "NEW" badge goes away for good.
	Remotes.func("SeenApp").OnServerInvoke = function(player: Player, appId: any)
		if not RateLimit.check(player, "SeenApp", 0.2) then
			return false
		end
		local data = PlayerDataService:Get(player)
		local def = if type(appId) == "string" then AppsConfig.byId[appId] else nil
		if not data or not def or not def.unlock(data) then
			return false
		end
		if not data.settings.seenApps[def.id] then
			data.settings.seenApps[def.id] = true
			PlayerDataService:Replicate(player)
		end
		return true
	end
end

function ProgressService:Start()
	PlayerDataService.Changed:Connect(function(player: Player)
		ProgressService:Check(player)
	end)
	Players.PlayerRemoving:Connect(function(p)
		lastKit[p] = nil
		checking[p] = nil
	end)
end

return ProgressService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX39"><Properties><string name="Name">PropertyService</string><ProtectedString name="Source"><![CDATA[--!strict
-- Properties and the storefront. Buying is validated here (level, cash, not already owned). Owning a property raises
-- storage, adds a delivery mat, and from the food truck up adds a display case: batches you put on display are sold to
-- walk-in customers in rounds while you play. Rent is charged per "day"; if you cannot pay, the storefront simply
-- closes for that day - nothing is ever taken away.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Properties = require(ReplicatedStorage.Shared.Config.Properties)
local Recipes = require(ReplicatedStorage.Shared.Config.Recipes)
local RateLimit = require(ReplicatedStorage.Shared.Modules.RateLimit)
local Remotes = require(ReplicatedStorage.Shared.Modules.Remotes)
local PlayerDataService = require(script.Parent.PlayerDataService)
local EconomyService = require(script.Parent.EconomyService)

local SALE_ROUND = 20 -- seconds between walk-in rounds
local DAY = 600 -- seconds per rent day
local BASE_PRICE = 2.2 -- per cookie, before quality and recipe multipliers

local closed: { [Player]: boolean } = {}
local lastRent: { [Player]: number } = {}
local lastSale: { [Player]: number } = {}

local PropertyService = {}

local function notify(player: Player, text: string)
	Remotes.event("Notify"):FireClient(player, text)
end

local function ownedDisplaySlots(data: any): number
	local n = 0
	for id in data.properties do
		local def = Properties[id]
		if def and def.display then
			n += def.display
		end
	end
	return n
end

local function walkInCapacity(data: any): number
	local n = 0
	for id in data.properties do
		local def = Properties[id]
		if def and def.walkIn then
			n += def.walkIn
		end
	end
	return n
end

local function displayedBatches(data: any): { any }
	local out = {}
	for _, b in data.batches do
		if b.displayed then
			table.insert(out, b)
		end
	end
	return out
end

-- Price one walk-in customer pays for one cookie from this batch.
function PropertyService.walkInPrice(batch: any): number
	local recipe = if batch.recipeId then Recipes.catalog[batch.recipeId] else nil
	local mult = if recipe then recipe.priceMult or 1 else 1.1
	return math.floor(BASE_PRICE * mult * (0.5 + batch.quality) * 10 + 0.5) / 10
end

-- One round of walk-in sales. Returns cookies sold. Exposed so tests can drive it.
function PropertyService:SellRound(player: Player): number
	local data = PlayerDataService:Get(player)
	if not data or closed[player] then
		return 0
	end
	local budget = walkInCapacity(data)
	local sold, earned = 0, 0
	for _, b in displayedBatches(data) do
		while budget > 0 and b.count > 0 do
			b.count -= 1
			budget -= 1
			sold += 1
			earned += PropertyService.walkInPrice(b)
		end
		if b.count <= 0 then
			for i, x in data.batches do
				if x == b then
					table.remove(data.batches, i)
					break
				end
			end
		end
		if budget <= 0 then
			break
		end
	end
	if sold > 0 then
		earned = math.floor(earned)
		EconomyService:AddCash(player, earned)
		EconomyService:Record(player, "gross", earned)
		EconomyService:AddXp(player, math.ceil(sold / 2))
		data.stats.walkIn = (data.stats.walkIn or 0) + sold
		notify(player, `Walk-in customers bought {sold} cookies for ${earned}.`)
	end
	return sold
end

-- Charges rent for every owned property. Returns true if all rent was paid.
function PropertyService:ChargeRent(player: Player): boolean
	local data = PlayerDataService:Get(player)
	if not data then
		return true
	end
	local due = 0
	for id in data.properties do
		local def = Properties[id]
		if def then
			due += def.dailyCost
		end
	end
	if due == 0 then
		closed[player] = false
		return true
	end
	if EconomyService:TrySpend(player, due) then
		EconomyService:Record(player, "other", due)
		closed[player] = false
		notify(player, `Paid ${due} rent for your properties.`)
		return true
	end
	closed[player] = true
	notify(player, `You could not pay ${due} rent, so your storefront is closed until you can. Orders still work.`)
	PlayerDataService:Replicate(player)
	return false
end

function PropertyService:IsClosed(player: Player): boolean
	return closed[player] == true
end

local function describe(data: any, player: Player): any
	return {
		displaySlots = ownedDisplaySlots(data),
		displayed = #displayedBatches(data),
		closed = closed[player] == true,
	}
end

function PropertyService:Init()
	Remotes.func("PropertyBuy").OnServerInvoke = function(player: Player, propertyId: any): (boolean, string)
		if not RateLimit.check(player, "PropertyBuy", 0.5) then
			return false, "slow down a little"
		end
		local data = PlayerDataService:Get(player)
		local def = if type(propertyId) == "string" then Properties[propertyId] else nil
		if not data or not def then
			return false, "unknown property"
		end
		if data.properties[def.id] then
			return false, "you already own that"
		end
		if data.level < (def.unlockLevel or 1) then
			return false, `Reach level {def.unlockLevel} to buy the {def.name}.`
		end
		if not EconomyService:TrySpend(player, def.price) then
			return false, `You need ${def.price} for the {def.name}.`
		end
		data.properties[def.id] = true
		EconomyService:Record(player, "other", def.price)
		EconomyService:AddXp(player, 50)
		closed[player] = false
		PlayerDataService:Replicate(player)
		return true, `You bought the {def.name}!`
	end

	Remotes.func("DisplaySet").OnServerInvoke = function(player: Player, batchId: any, on: any): (boolean, string)
		if not RateLimit.check(player, "DisplaySet", 0.2) then
			return false, "slow down a little"
		end
		local data = PlayerDataService:Get(player)
		if not data or type(batchId) ~= "number" or type(on) ~= "boolean" then
			return false, "bad request"
		end
		local batch
		for _, b in data.batches do
			if b.id == batchId then
				batch = b
			end
		end
		if not batch then
			return false, "that batch is gone"
		end
		if on then
			if batch.displayed then
				return true, "already on display"
			end
			if batch.reservedFor then
				return false, "that box is promised to an order"
			end
			if #displayedBatches(data) >= ownedDisplaySlots(data) then
				return false, if ownedDisplaySlots(data) == 0 then "You need a Food Truck or bigger to run a display case." else "Your display case is full."
			end
			batch.displayed = true
		else
			batch.displayed = false
		end
		PlayerDataService:Replicate(player)
		return true, if on then "On display. Walk-in customers will buy it." else "Back in stock."
	end

	Remotes.func("StorefrontStatus").OnServerInvoke = function(player: Player)
		local data = PlayerDataService:Get(player)
		return if data then describe(data, player) else nil
	end

	Players.PlayerRemoving:Connect(function(p)
		closed[p] = nil
		lastRent[p] = nil
		lastSale[p] = nil
	end)
end

function PropertyService:Start()
	task.spawn(function()
		while true do
			task.wait(5)
			local now = os.clock()
			for _, p in Players:GetPlayers() do
				local data = PlayerDataService:Get(p)
				if data then
					lastRent[p] = lastRent[p] or now
					lastSale[p] = lastSale[p] or now
					if now - lastRent[p] >= DAY then
						lastRent[p] = now
						PropertyService:ChargeRent(p)
					end
					if now - lastSale[p] >= SALE_ROUND then
						lastSale[p] = now
						PropertyService:SellRound(p)
					end
				end
			end
		end
	end)
end

return PropertyService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX40"><Properties><string name="Name">SettingsService</string><ProtectedString name="Source"><![CDATA[--!strict
-- Player settings (text size, sound volume, effects) and the bakery brand. Everything is validated against Config/Brand.
-- The bakery name is player-written text, so it goes through Roblox text filtering before it is saved or shown.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TextService = game:GetService("TextService")

local Brand = require(ReplicatedStorage.Shared.Config.Brand)
local RateLimit = require(ReplicatedStorage.Shared.Modules.RateLimit)
local Remotes = require(ReplicatedStorage.Shared.Modules.Remotes)
local PlayerDataService = require(script.Parent.PlayerDataService)

local SettingsService = {}

local function filtered(player: Player, text: string): string?
	local ok, result = pcall(function()
		local obj = TextService:FilterStringAsync(text, player.UserId)
		return obj:GetNonChatStringForBroadcastAsync()
	end)
	if ok and type(result) == "string" then
		return result
	end
	return nil
end

function SettingsService:Init()
	Remotes.func("SettingSet").OnServerInvoke = function(player: Player, key: any, value: any): (boolean, string)
		if not RateLimit.check(player, "SettingSet", 0.2) then
			return false, "slow down a little"
		end
		local data = PlayerDataService:Get(player)
		if not data then
			return false, "loading"
		end
		local s = data.settings
		if key == "textScale" then
			if not table.find(Brand.TEXT_SCALES, value) then
				return false, "unknown text size"
			end
			s.textScale = value
		elseif key == "sfx" then
			if type(value) ~= "number" or value ~= value or value < 0 or value > 1 then
				return false, "volume must be between 0 and 1"
			end
			s.sfx = math.floor(value * 10 + 0.5) / 10
		elseif key == "effects" or key == "guidance" then
			if type(value) ~= "boolean" then
				return false, "bad value"
			end
			s[key] = value
		else
			return false, "unknown setting"
		end
		PlayerDataService:Replicate(player)
		return true, "Saved."
	end

	Remotes.func("BrandSet").OnServerInvoke = function(player: Player, name: any, colorIndex: any): (boolean, string)
		if not RateLimit.check(player, "BrandSet", 2) then
			return false, "slow down a little"
		end
		local data = PlayerDataService:Get(player)
		if not data then
			return false, "loading"
		end
		if type(colorIndex) ~= "number" or colorIndex % 1 ~= 0 or colorIndex < 1 or colorIndex > #Brand.COLORS then
			return false, "pick one of the colors"
		end
		local clean, reason = Brand.cleanName(name)
		if not clean then
			return false, reason or "bad name"
		end
		local safe = filtered(player, clean)
		if not safe then
			return false, "Could not check that name right now. Try again in a moment."
		end
		if safe ~= clean then
			return false, "That name was not allowed. Try another."
		end
		data.settings.brandName = clean
		data.settings.brandColor = colorIndex
		PlayerDataService:Replicate(player)
		return true, `Welcome, {clean}!`
	end
end

function SettingsService:Start() end

return SettingsService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX41"><Properties><string name="Name">StaffService</string><ProtectedString name="Source"><![CDATA[--!strict
-- Employees. A baker bakes one assigned recipe on a fixed cycle using the pantry, so the result is predictable and the
-- Staff Board can always say exactly why a baker is idle. Wages are paid per day; if you cannot pay, the baker waits
-- (nobody is fired and nothing is lost) and resumes as soon as the wage is paid.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Ingredients = require(ReplicatedStorage.Shared.Config.Ingredients)
local Properties = require(ReplicatedStorage.Shared.Config.Properties)
local Recipes = require(ReplicatedStorage.Shared.Config.Recipes)
local Staff = require(ReplicatedStorage.Shared.Config.Staff)
local AppealCalc = require(ReplicatedStorage.Shared.Modules.AppealCalc)
local Quality = require(ReplicatedStorage.Shared.Modules.Quality)
local RateLimit = require(ReplicatedStorage.Shared.Modules.RateLimit)
local Remotes = require(ReplicatedStorage.Shared.Modules.Remotes)
local PlayerDataService = require(script.Parent.PlayerDataService)
local EconomyService = require(script.Parent.EconomyService)
local InventoryService = require(script.Parent.InventoryService)

local STEP = 5
local lastPay: { [Player]: number } = {}

local StaffService = {}

local function slots(data: any): number
	local n = 0
	for id in data.properties do
		local def = Properties[id]
		if def then
			n += def.ovenSlots
		end
	end
	return math.max(0, n - 1) -- one oven is always yours
end

local function skillOf(entry: any): number
	local c = Staff.candidates[entry.id]
	return math.min(4, c.skill + (if entry.bakes >= Staff.PROMOTE_EVERY then 1 else 0))
end

local function cycleOf(entry: any): number
	return Staff.candidates[entry.id].cycle
end

function StaffService.slots(data: any): number
	return slots(data)
end

local function setStatus(entry: any, text: string): boolean
	if entry.status ~= text then
		entry.status = text
		return true
	end
	return false
end

local function bakeBatch(player: Player, data: any, entry: any)
	local recipe = Recipes.catalog[entry.recipeId]
	local list = Recipes.expand(recipe.requires)
	local score = math.min(100, Staff.BASE_SCORE + skillOf(entry) * Staff.PER_SKILL)
	local quality = score / 100
	local appeal = AppealCalc.compute(list, quality)
	local tagSet: { [string]: boolean } = {}
	for _, id in list do
		for _, t in Ingredients[id].tags do
			tagSet[t] = true
		end
	end
	local tags = {}
	for t in tagSet do
		table.insert(tags, t)
	end
	table.sort(tags)
	InventoryService:AddBatch(player, {
		id = InventoryService:NextBatchId(player),
		name = recipe.name,
		recipeId = recipe.id,
		ingredients = list,
		tags = tags,
		quality = quality,
		score = score,
		grade = Quality.grade(score),
		feedback = `Baked by {Staff.candidates[entry.id].name}.`,
		appeal = appeal.score,
		effects = appeal.effects,
		count = Recipes.YIELD,
		packaged = true,
		byStaff = true,
	})
end

-- Advances every baker by dt seconds. Exposed so tests can drive time.
function StaffService:Step(player: Player, dt: number)
	local data = PlayerDataService:Get(player)
	if not data or #data.staff == 0 then
		return
	end
	local changed = false
	for _, entry in data.staff do
		local c = Staff.candidates[entry.id]
		if entry.unpaid then
			if EconomyService:TrySpend(player, c.wage) then
				EconomyService:Record(player, "wages", c.wage)
				entry.unpaid = false
				changed = true
			else
				changed = setStatus(entry, `Waiting for wages (${c.wage}).`) or changed
				continue
			end
		end
		local recipe = if entry.recipeId then Recipes.catalog[entry.recipeId] else nil
		if not recipe then
			changed = setStatus(entry, "Needs a recipe. Assign one in the Staff Board.") or changed
		elseif not data.recipes[recipe.id] then
			changed = setStatus(entry, `You have not learned {recipe.name} yet.`) or changed
		elseif not InventoryService:HasRoomForBatch(player) then
			changed = setStatus(entry, "Storage is full. Sell or deliver some cookies.") or changed
		else
			local missing = InventoryService:Missing(player, recipe.requires)
			if missing then
				changed = setStatus(entry, `Waiting on ingredients: {missing}. Order more in PantryDash.`) or changed
			else
				entry.progress += dt
				if entry.progress >= cycleOf(entry) then
					do
						InventoryService:Consume(player, recipe.requires)
						bakeBatch(player, data, entry)
						entry.bakes += 1
						entry.progress = 0
						EconomyService:AddXp(player, 3)
						changed = setStatus(entry, `Finished a batch of {recipe.name}.`) or changed
					end
				else
					changed = setStatus(entry, `Baking {recipe.name}: {math.floor(entry.progress / cycleOf(entry) * 100)}%`) or changed
				end
			end
		end
	end
	if changed then
		PlayerDataService:Replicate(player)
	end
end

-- Pays one day of wages for every baker; unpaid bakers wait.
function StaffService:PayDay(player: Player)
	local data = PlayerDataService:Get(player)
	if not data then
		return
	end
	for _, entry in data.staff do
		if not entry.unpaid then
			local c = Staff.candidates[entry.id]
			if EconomyService:TrySpend(player, c.wage) then
				EconomyService:Record(player, "wages", c.wage)
			else
				entry.unpaid = true
				setStatus(entry, `Waiting for wages (${c.wage}).`)
				Remotes.event("Notify"):FireClient(player, `You could not pay {c.name}. They will wait until you can.`)
			end
		end
	end
	PlayerDataService:Replicate(player)
end

function StaffService:Init()
	Remotes.func("StaffHire").OnServerInvoke = function(player: Player, candidateId: any): (boolean, string)
		if not RateLimit.check(player, "StaffHire", 0.5) then
			return false, "slow down a little"
		end
		local data = PlayerDataService:Get(player)
		local c = if type(candidateId) == "string" then Staff.candidates[candidateId] else nil
		if not data or not c then
			return false, "unknown candidate"
		end
		for _, e in data.staff do
			if e.id == c.id then
				return false, `{c.name} already works for you.`
			end
		end
		if #data.staff >= slots(data) then
			return false, if slots(data) == 0 then "You need a second oven (own a Food Truck or bigger) before you can hire." else "All your ovens are staffed."
		end
		if not EconomyService:TrySpend(player, c.wage) then
			return false, `Hiring {c.name} costs ${c.wage} for the first day.`
		end
		EconomyService:Record(player, "wages", c.wage)
		table.insert(data.staff, { id = c.id, recipeId = nil, bakes = 0, progress = 0, status = "Needs a recipe. Assign one in the Staff Board.", unpaid = false })
		lastPay[player] = lastPay[player] or os.clock()
		PlayerDataService:Replicate(player)
		return true, `{c.name} is on the team. Pick what they bake.`
	end

	Remotes.func("StaffFire").OnServerInvoke = function(player: Player, candidateId: any): (boolean, string)
		if not RateLimit.check(player, "StaffFire", 0.5) then
			return false, "slow down a little"
		end
		local data = PlayerDataService:Get(player)
		if not data then
			return false, "loading"
		end
		for i, e in data.staff do
			if e.id == candidateId then
				table.remove(data.staff, i)
				PlayerDataService:Replicate(player)
				return true, "They have left. No hard feelings."
			end
		end
		return false, "that person does not work for you"
	end

	Remotes.func("StaffAssign").OnServerInvoke = function(player: Player, candidateId: any, recipeId: any): (boolean, string)
		if not RateLimit.check(player, "StaffAssign", 0.3) then
			return false, "slow down a little"
		end
		local data = PlayerDataService:Get(player)
		local recipe = if type(recipeId) == "string" then Recipes.catalog[recipeId] else nil
		if not data or not recipe then
			return false, "unknown recipe"
		end
		if not data.recipes[recipe.id] then
			return false, "you have not learned that recipe yet"
		end
		for _, e in data.staff do
			if e.id == candidateId then
				if e.recipeId ~= recipe.id then
					e.recipeId = recipe.id
					e.progress = 0
					e.status = `Assigned to {recipe.name}.`
				end
				PlayerDataService:Replicate(player)
				return true, `{Staff.candidates[e.id].name} will bake {recipe.name}.`
			end
		end
		return false, "that person does not work for you"
	end

	Players.PlayerRemoving:Connect(function(p)
		lastPay[p] = nil
	end)
end

function StaffService:Start()
	task.spawn(function()
		while true do
			task.wait(STEP)
			local now = os.clock()
			for _, p in Players:GetPlayers() do
				StaffService:Step(p, STEP)
				local data = PlayerDataService:Get(p)
				if data and #data.staff > 0 then
					lastPay[p] = lastPay[p] or now
					if now - lastPay[p] >= Staff.DAY then
						lastPay[p] = now
						StaffService:PayDay(p)
					end
				end
			end
		end
	end)
end

return StaffService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX42"><Properties><string name="Name">VehicleService</string><ProtectedString name="Source"><![CDATA[--!strict
-- Vehicles: buying is validated here; spawning builds a simple driveable car on the server. The car is a body with a
-- VehicleSeat; while someone sits in it the server steers it from the seat's throttle and steer values, and
-- AlignOrientation keeps it upright so it cannot tip over. One vehicle per player; it is removed when they leave.
-- This is the least-tested piece of the game: if driving misbehaves, the delivery perks from owning a vehicle still work.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Vehicles = require(ReplicatedStorage.Shared.Config.Vehicles)
local RateLimit = require(ReplicatedStorage.Shared.Modules.RateLimit)
local Remotes = require(ReplicatedStorage.Shared.Modules.Remotes)
local PlayerDataService = require(script.Parent.PlayerDataService)
local EconomyService = require(script.Parent.EconomyService)

type Car = { model: Model, body: BasePart, seat: VehicleSeat, speed: number, owner: Player }

local cars: { [Player]: Car } = {}
local folder: Folder? = nil

local VehicleService = {}

local function buildCar(player: Player, def: any, at: CFrame): Car
	local model = Instance.new("Model")
	model.Name = `{def.name} ({player.Name})`
	local c = Color3.fromRGB(def.color[1], def.color[2], def.color[3])

	local body = Instance.new("Part")
	body.Name = "Body"
	body.Size = Vector3.new(6, 2, 10)
	body.Color = c
	body.Material = Enum.Material.SmoothPlastic
	body.CustomPhysicalProperties = PhysicalProperties.new(2, 0, 0, 1, 1) -- low friction: we drive it directly
	body.CFrame = at
	body.Parent = model

	local seat = Instance.new("VehicleSeat")
	seat.Name = "DriverSeat"
	seat.Size = Vector3.new(2, 1, 2)
	seat.CFrame = at * CFrame.new(0, 1.5, -1)
	seat.MaxSpeed = 0 -- we move the body ourselves
	seat.Torque = 0
	seat.Parent = model
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = body
	weld.Part1 = seat
	weld.Parent = body

	for _, off in { Vector3.new(-3.2, -1, -3.5), Vector3.new(3.2, -1, -3.5), Vector3.new(-3.2, -1, 3.5), Vector3.new(3.2, -1, 3.5) } do
		local wheel = Instance.new("Part")
		wheel.Name = "Wheel"
		wheel.Shape = Enum.PartType.Cylinder
		wheel.Size = Vector3.new(0.8, 2.4, 2.4)
		wheel.Color = Color3.fromRGB(40, 40, 40)
		wheel.CanCollide = false
		wheel.CFrame = at * CFrame.new(off) * CFrame.Angles(0, 0, math.rad(90))
		wheel.Parent = model
		local w = Instance.new("WeldConstraint")
		w.Part0 = body
		w.Part1 = wheel
		w.Parent = body
	end

	-- keep the car upright (yaw is free, tilt is not)
	local att = Instance.new("Attachment")
	att.Parent = body
	local align = Instance.new("AlignOrientation")
	align.Mode = Enum.OrientationAlignmentMode.OneAttachment
	align.AlignType = Enum.AlignType.PrimaryAxisParallel
	align.PrimaryAxis = Vector3.new(0, 1, 0)
	align.Attachment0 = att
	align.MaxTorque = 1e7
	align.Responsiveness = 40
	align.Parent = body

	model.PrimaryPart = body
	model.Parent = folder
	return { model = model, body = body, seat = seat, speed = def.speed, owner = player }
end

local function remove(player: Player)
	local car = cars[player]
	if car then
		cars[player] = nil
		car.model:Destroy()
	end
end

function VehicleService:Init()
	folder = Instance.new("Folder")
	folder.Name = "Vehicles"
	folder.Parent = workspace

	Remotes.func("VehicleBuy").OnServerInvoke = function(player: Player, id: any): (boolean, string)
		if not RateLimit.check(player, "VehicleBuy", 0.5) then
			return false, "slow down a little"
		end
		local data = PlayerDataService:Get(player)
		local def = if type(id) == "string" then Vehicles.catalog[id] else nil
		if not data or not def then
			return false, "unknown vehicle"
		end
		if data.vehicles[def.id] then
			return false, "you already own that"
		end
		if data.level < def.unlockLevel then
			return false, `Reach level {def.unlockLevel} to buy the {def.name}.`
		end
		if not EconomyService:TrySpend(player, def.price) then
			return false, `You need ${def.price} for the {def.name}.`
		end
		data.vehicles[def.id] = true
		EconomyService:Record(player, "other", def.price)
		PlayerDataService:Replicate(player)
		return true, `You bought the {def.name}! Spawn it from the Wheelhouse.`
	end

	Remotes.func("VehicleSpawn").OnServerInvoke = function(player: Player, id: any): (boolean, string)
		if not RateLimit.check(player, "VehicleSpawn", 3) then
			return false, "give it a few seconds"
		end
		local data = PlayerDataService:Get(player)
		local def = if type(id) == "string" then Vehicles.catalog[id] else nil
		if not data or not def or not data.vehicles[def.id] then
			return false, "you do not own that vehicle"
		end
		local char = player.Character
		local root = if char then char:FindFirstChild("HumanoidRootPart") else nil
		if not root or not root:IsA("BasePart") then
			return false, "your character is not ready"
		end
		remove(player)
		local ok, car = pcall(buildCar, player, def, root.CFrame * CFrame.new(0, 3, -12))
		if not ok then
			warn(`[Vehicle] could not build {def.id}: {car}`)
			return false, "the vehicle could not be built; delivery perks still apply"
		end
		cars[player] = car :: Car
		return true, `Your {def.name} is ready. Hop in the driver seat.`
	end

	Remotes.func("VehicleRemove").OnServerInvoke = function(player: Player): boolean
		remove(player)
		return true
	end

	Players.PlayerRemoving:Connect(remove)
end

function VehicleService:Start()
	RunService.Heartbeat:Connect(function()
		for player, car in cars do
			local seat = car.seat
			if not seat.Parent then
				cars[player] = nil
			elseif seat.Occupant then
				local throttle = math.clamp(seat.ThrottleFloat, -1, 1)
				local steer = math.clamp(seat.SteerFloat, -1, 1)
				local look = car.body.CFrame.LookVector
				local vel = car.body.AssemblyLinearVelocity
				local target = look * throttle * car.speed
				car.body.AssemblyLinearVelocity = Vector3.new(target.X, vel.Y, target.Z)
				car.body.AssemblyAngularVelocity = Vector3.new(0, -steer * 1.8 * (if throttle < 0 then -1 else 1), 0)
			end
		end
	end)
end

return VehicleService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX43"><Properties><string name="Name">WorldService</string><ProtectedString name="Source"><![CDATA[--!strict
-- Sets up lighting and puts floating name labels on tagged parts in the map.
-- Tags (set in tools/map_gen.py): BakeStation, MeetupSpot, PropertyPlot, Landmark.
local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")

local STYLES: { [string]: { color: Color3, offset: number, size: number } } = {
	BakeStation = { color = Color3.fromRGB(255, 200, 90), offset = 5, size = 15 },
	MeetupSpot = { color = Color3.fromRGB(120, 220, 255), offset = 6, size = 16 },
	PropertyPlot = { color = Color3.fromRGB(130, 235, 150), offset = 6, size = 16 },
	ReceivingArea = { color = Color3.fromRGB(255, 200, 90), offset = 5, size = 14 },
	Landmark = { color = Color3.fromRGB(255, 236, 200), offset = 8, size = 18 },
}

local WorldService = {}

local function addLabel(part: BasePart, tag: string)
	if part:FindFirstChild("NameTag") then
		return
	end
	local style = STYLES[tag]
	local gui = Instance.new("BillboardGui")
	gui.Name = "NameTag"
	gui.Adornee = part
	gui.AlwaysOnTop = true
	gui.MaxDistance = if tag == "Landmark" then 260 else 130
	gui.Size = UDim2.fromOffset(240, 34)
	gui.StudsOffsetWorldSpace = Vector3.new(0, style.offset, 0)

	local text = Instance.new("TextLabel")
	text.Size = UDim2.fromScale(1, 1)
	text.BackgroundTransparency = 1
	text.Font = Enum.Font.GothamBold
	text.TextSize = style.size
	text.TextColor3 = style.color
	text.TextStrokeTransparency = 0.3
	text.Text = part.Name
	text.Parent = gui
	gui.Parent = part
end

local DAY_SECONDS = 14 * 60 -- one full in-game day
local START_CLOCK = 16.5 -- golden hour on arrival

local function isNight(clock: number): boolean
	return clock < 6 or clock > 18.5
end

local function setupLighting()
	Lighting.ClockTime = START_CLOCK
	Lighting.GeographicLatitude = 35
	Lighting.Brightness = 2.6
	Lighting.Ambient = Color3.fromRGB(110, 105, 125)
	Lighting.OutdoorAmbient = Color3.fromRGB(150, 140, 150)
	Lighting.ColorShift_Top = Color3.fromRGB(255, 226, 170)
	Lighting.EnvironmentDiffuseScale = 0.6
	Lighting.EnvironmentSpecularScale = 0.5
	Lighting.GlobalShadows = true
	Lighting.ShadowSoftness = 0.25

	local sky = Instance.new("Sky")
	sky.StarCount = 3000
	sky.CelestialBodiesShown = true
	sky.Parent = Lighting

	local atmosphere = Instance.new("Atmosphere")
	atmosphere.Density = 0.25
	atmosphere.Offset = 0.2
	atmosphere.Color = Color3.fromRGB(199, 215, 235)
	atmosphere.Decay = Color3.fromRGB(240, 220, 190)
	atmosphere.Glare = 0.1
	atmosphere.Haze = 1.2
	atmosphere.Parent = Lighting

	local color = Instance.new("ColorCorrectionEffect")
	color.Saturation = 0.22
	color.Contrast = 0.08
	color.TintColor = Color3.fromRGB(255, 244, 232)
	color.Parent = Lighting

	local depth = Instance.new("DepthOfFieldEffect")
	depth.FarIntensity = 0.12
	depth.FocusDistance = 80
	depth.InFocusRadius = 120
	depth.NearIntensity = 0
	depth.Parent = Lighting

	local bloom = Instance.new("BloomEffect")
	bloom.Intensity = 0.3
	bloom.Size = 24
	bloom.Threshold = 1.5
	bloom.Parent = Lighting

	local rays = Instance.new("SunRaysEffect")
	rays.Intensity = 0.08
	rays.Parent = Lighting
end

local lampLights: { PointLight } = {}

-- Warm point lights on every street lamp; they switch on at dusk so the city glows at night.
local function lightLamp(part: BasePart)
	if part:FindFirstChild("LampLight") then
		return
	end
	local light = Instance.new("PointLight")
	light.Name = "LampLight"
	light.Color = Color3.fromRGB(255, 214, 140)
	light.Range = 26
	light.Brightness = 1.6
	light.Shadows = false
	light.Enabled = isNight(Lighting.ClockTime)
	light.Parent = part
	table.insert(lampLights, light)
end

-- Sparkles on the cookie monument and a mist over the fountain: cheap, built-in textures only.
local function addSparkles(part: BasePart, color: Color3, rate: number)
	local e = Instance.new("ParticleEmitter")
	e.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	e.Color = ColorSequence.new(color)
	e.Rate = rate
	e.Lifetime = NumberRange.new(1.5, 3)
	e.Speed = NumberRange.new(1, 4)
	e.SpreadAngle = Vector2.new(180, 180)
	e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6), NumberSequenceKeypoint.new(1, 0) })
	e.LightEmission = 0.6
	e.Parent = part
end

-- A glowing welcome arch just in front of the spawn so the first view has a landmark.
local function buildArch()
	local model = Instance.new("Model")
	model.Name = "Welcome Arch"
	local function block(name: string, pos: Vector3, size: Vector3, color: Color3, material: Enum.Material): Part
		local p = Instance.new("Part")
		p.Name = name
		p.Anchored = true
		p.Size = size
		p.Position = pos
		p.Color = color
		p.Material = material
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		p.Parent = model
		return p
	end
	local center = Vector3.new(-30, 0, -40)
	for _, dx in { -13, 13 } do
		block("Pillar", center + Vector3.new(dx, 9, 0), Vector3.new(3, 18, 3), Color3.fromRGB(120, 78, 60), Enum.Material.Brick)
		block("PillarCap", center + Vector3.new(dx, 18.4, 0), Vector3.new(4.4, 1, 4.4), Color3.fromRGB(240, 200, 120), Enum.Material.SmoothPlastic)
	end
	local beam = block("Sign", center + Vector3.new(0, 16, 0), Vector3.new(30, 5, 1.6), Color3.fromRGB(46, 29, 24), Enum.Material.SmoothPlastic)
	for _, face in { Enum.NormalId.Front, Enum.NormalId.Back } do
		local gui = Instance.new("SurfaceGui")
		gui.Face = face
		gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		gui.PixelsPerStud = 40
		gui.Parent = beam
		local label = Instance.new("TextLabel")
		label.Size = UDim2.fromScale(1, 1)
		label.BackgroundTransparency = 1
		label.Font = Enum.Font.GothamBlack
		label.TextScaled = true
		label.TextColor3 = Color3.fromRGB(255, 214, 120)
		label.Text = "🍪 COOKIE EMPIRE 🍪"
		label.Parent = gui
	end
	local glowLight = Instance.new("PointLight")
	glowLight.Color = Color3.fromRGB(255, 200, 120)
	glowLight.Range = 40
	glowLight.Brightness = 1.5
	glowLight.Parent = beam
	model.Parent = workspace
end

function WorldService:Init()
	setupLighting()
	buildArch()
end

function WorldService:Start()
	for _, inst in workspace:GetDescendants() do
		if inst:IsA("BasePart") then
			if inst.Name == "Lamp" then
				lightLamp(inst)
			elseif inst.Name == "Cookie Monument" then
				addSparkles(inst, Color3.fromRGB(255, 220, 140), 12)
			elseif inst.Name == "FountainColumn" then
				addSparkles(inst, Color3.fromRGB(190, 230, 255), 20)
			end
		end
	end
	-- slow day/night cycle; lamps follow it
	task.spawn(function()
		local wasNight = isNight(Lighting.ClockTime)
		while true do
			task.wait(1)
			Lighting.ClockTime = (Lighting.ClockTime + 24 / DAY_SECONDS) % 24
			local night = isNight(Lighting.ClockTime)
			if night ~= wasNight then
				wasNight = night
				for _, l in lampLights do
					l.Enabled = night
				end
			end
		end
	end)
	for tag in STYLES do
		for _, inst in CollectionService:GetTagged(tag) do
			if inst:IsA("BasePart") then
				addLabel(inst, tag)
			end
		end
		CollectionService:GetInstanceAddedSignal(tag):Connect(function(inst)
			if inst:IsA("BasePart") then
				addLabel(inst, tag)
			end
		end)
	end
end

return WorldService
]]></ProtectedString></Properties></Item></Item></Item></Item><Item class="StarterPlayer" referent="RBX74"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX73"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="Folder" referent="RBX69"><Properties><string name="Name">Client</string></Properties><Item class="Folder" referent="RBX57"><Properties><string name="Name">Apps</string></Properties><Item class="ModuleScript" referent="RBX46"><Properties><string name="Name">BrandStudio</string><ProtectedString name="Source"><![CDATA[--!strict
-- Brand Studio: name your bakery and pick its color. The name is filtered by the server.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Brand = require(ReplicatedStorage.Shared.Config.Brand)
local Remotes = require(ReplicatedStorage.Shared.Modules.Remotes)
local UI = require(script.Parent.Parent.Modules.UI)

local Theme = UI.Theme
local draftName = ""
local draftColor: number? = nil

local BrandStudio = {}
BrandStudio.id = "brandstudio"

function BrandStudio.render(ctx: any)
	local s = ctx.state.settings
	if draftName == "" then
		draftName = s.brandName
	end
	local color = draftColor or s.brandColor

	local preview = UI.card(ctx.content, Color3.fromRGB(Brand.COLORS[color].rgb[1], Brand.COLORS[color].rgb[2], Brand.COLORS[color].rgb[3]))
	UI.label(preview, if draftName ~= "" then draftName else "Your Bakery", { bold = true, size = 22, align = Enum.TextXAlignment.Center })

	UI.label(ctx.content, "Bakery name", { bold = true, size = 18 })
	local box = Instance.new("TextBox")
	box.Size = UDim2.new(1, 0, 0, UI.MIN_TOUCH)
	box.BackgroundColor3 = Theme.Buttercream
	box.TextColor3 = Theme.Cocoa
	box.Font = Enum.Font.Gotham
	box.TextSize = math.floor(16 * UI.textScale + 0.5)
	box.PlaceholderText = `{Brand.NAME_MIN}-{Brand.NAME_MAX} letters, numbers, spaces`
	box.ClearTextOnFocus = false
	box.Text = draftName
	box.Parent = ctx.content
	UI.corner(box)
	UI.stroke(box, 1.5)
	box.FocusLost:Connect(function()
		draftName = box.Text
		ctx.rerender()
	end)

	UI.label(ctx.content, "Color", { bold = true, size = 18 })
	for i, c in Brand.COLORS do
		UI.button(ctx.content, c.name .. (if i == color then "  (selected)" else ""), Color3.fromRGB(c.rgb[1], c.rgb[2], c.rgb[3]), function()
			draftColor = i
			ctx.rerender()
		end)
	end
	UI.button(ctx.content, "Save brand", Theme.Butter, function()
		local ok, msg = Remotes.func("BrandSet"):InvokeServer(draftName, color)
		ctx.say(tostring(msg))
		if ok then
			draftColor = nil
		end
		ctx.rerender()
		return ok
	end)
end

return BrandStudio
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX47"><Properties><string name="Name">CrumbChat</string><ProtectedString name="Source"><![CDATA[--!strict
-- CrumbChat: customer requests as chat threads. Accept or decline, ask preset questions, see the order's state,
-- and hand the cookies over. NPC answers come from the server (curated text only; players never type to NPCs).
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Dialogue = require(ReplicatedStorage.Shared.Config.Dialogue)
local Remotes = require(ReplicatedStorage.Shared.Modules.Remotes)
local UI = require(script.Parent.Parent.Modules.UI)

local Theme = UI.Theme
local STATES = { "Available", "Accepted", "In Production", "Ready", "Delivered", "Paid" }

local chat: { [number]: { { from: string, text: string } } } = {} -- per order, this session only
local receipt: any = nil

local function stateLine(current: string): string
	local parts = {}
	for _, s in STATES do
		table.insert(parts, if s == current then `[{s}]` else s)
	end
	return table.concat(parts, " > ")
end

local function matchingBoxes(state: any, order: any): { any }
	local found = {}
	for _, b in state.batches do
		if b.recipeId == order.recipeId and not b.reservedFor and b.count >= order.count then
			table.insert(found, b)
		end
	end
	return found
end

local function bubble(parent: Instance, who: string, text: string)
	local mine = who == "you"
	local box = UI.card(parent, if mine then Theme.Butter else Color3.fromRGB(255, 255, 255))
	UI.label(box, text, { size = 14, bold = mine })
end

local CrumbChat = {}
CrumbChat.id = "crumbchat"

function CrumbChat.render(ctx: any)
	local content = ctx.content
	local state = ctx.state

	local function act(action: string, orderId: number, extra: any?)
		local ok, res = Remotes.func("OrderAction"):InvokeServer(action, orderId, extra)
		if ok then
			if action == "deliver" and type(res) == "table" then
				receipt = res
				ctx.say(`{res.customerName}: "{res.reaction}"  +${res.pay + res.tip}`)
			elseif action == "ask" then
				local log = chat[orderId] or {}
				chat[orderId] = log
				table.insert(log, { from = "npc", text = tostring(res) })
			else
				ctx.say(tostring(res))
			end
		else
			ctx.say(tostring(res))
		end
		ctx.rerender()
	end

	if receipt then
		local card = UI.card(content, Theme.Mint)
		UI.label(card, `Receipt: {receipt.customerName}`, { bold = true, size = 17 })
		local tipText = if receipt.tip > 0 then " (+$" .. receipt.tip .. " tip)" else ""
		UI.label(card, "Delivered and paid  +$" .. receipt.pay .. tipText)
		UI.label(card, `Batch grade: {receipt.grade or "n/a"}`)
		UI.label(card, tostring(receipt.feedback or ""), { size = 14 })
		UI.label(card, `"{receipt.reaction}"  ({receipt.relationship})`, { size = 14 })
		UI.label(card, table.concat(receipt.states, " > "), { size = 12 })
		if receipt.wasFirst then
			UI.label(card, "First order complete! More customers will text you soon.", { bold = true })
		end
		UI.button(card, "Close receipt", Theme.Butter, function()
			receipt = nil
			ctx.rerender()
		end)
	end

	local shown = 0
	for _, o in ctx.orders do
		shown += 1
		local card = UI.card(content)
		UI.label(card, o.customerName, { bold = true, size = 17 })
		bubble(card, "npc", o.text)
		for _, m in chat[o.id] or {} do
			bubble(card, m.from, m.text)
		end
		UI.label(card, `{o.count}x {o.recipeName}  |  Pays about ${o.offer}  |  Deliver to: {o.destination}`, { size = 13 })
		if o.deadline then
			local left = math.max(0, o.deadline - os.time())
			UI.label(card, `Time left: {math.ceil(left / 60)} min`, { size = 13 })
		else
			UI.label(card, "No deadline. Take your time.", { size = 13 })
		end
		UI.label(card, stateLine(o.state), { size = 12, bold = true })

		-- preset follow-up questions (curated; the answer comes from the server)
		if o.state == "Available" or o.state == "Accepted" then
			for _, q in Dialogue.questions do
				UI.button(card, q.label, Theme.Blueberry, function()
					local log = chat[o.id] or {}
					chat[o.id] = log
					table.insert(log, { from = "you", text = q.label })
					act("ask", o.id, q.id)
				end)
			end
		end

		if o.state == "Available" then
			UI.button(card, "Accept", Theme.Mint, function()
				act("accept", o.id)
			end)
			UI.button(card, "Decline", Theme.Coral, function()
				act("cancel", o.id)
			end)
		elseif o.state == "Accepted" then
			UI.label(card, "Next: bake it at your kitchen counter (press E).", { size = 14, bold = true })
			for _, b in matchingBoxes(state, o) do
				UI.button(card, `Use stock box ({b.grade or "Good"}, {b.count} cookies)`, Theme.Butter, function()
					act("assign", o.id, b.id)
				end)
			end
			UI.button(card, "Cancel order", Theme.Coral, function()
				act("cancel", o.id)
			end)
		elseif o.state == "In Production" then
			UI.label(card, "Baking in progress. Finish at the kitchen station.", { size = 14, bold = true })
			UI.button(card, "Cancel order", Theme.Coral, function()
				act("cancel", o.id)
			end)
		elseif o.state == "Ready" then
			UI.button(card, "Hand over cookies", Theme.Mint, function()
				act("deliver", o.id)
			end)
		end
	end

	if shown == 0 and not receipt then
		UI.label(content, "No new requests yet. Customers text you every so often; keep an eye on this app.")
	end

	if #state.history > 0 then
		UI.label(content, "Recent orders", { bold = true, size = 16 })
		for _, h in state.history do
			UI.label(content, `{h.customer}: {h.recipe}  {h.grade}  +${h.pay}`, { size = 13 })
		end
	end
end

return CrumbChat
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX48"><Properties><string name="Name">GearUp</string><ProtectedString name="Source"><![CDATA[--!strict
-- GearUp: equipment by category, what you own, what the next tier does, and a validated Buy button.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Equipment = require(ReplicatedStorage.Shared.Config.Equipment)
local Remotes = require(ReplicatedStorage.Shared.Modules.Remotes)
local UI = require(script.Parent.Parent.Modules.UI)

local Theme = UI.Theme
local CATEGORIES = { "Baking", "Mixing", "Cooling" }

local GearUp = {}
GearUp.id = "gearup"

function GearUp.render(ctx: any)
	local state = ctx.state
	UI.label(ctx.content, `Cash: ${math.floor(state.cash)}`, { bold = true })

	for _, category in CATEGORIES do
		local items: { any } = {}
		for _, def in Equipment.catalog do
			if def.category == category then
				table.insert(items, def)
			end
		end
		table.sort(items, function(a: any, b: any)
			return a.tier < b.tier
		end)

		UI.label(ctx.content, category, { bold = true, size = 18 })
		for _, def in items do
			local card = UI.card(ctx.content, if state.equipment[def.id] then Theme.Mint else Theme.Buttercream)
			UI.label(card, `{def.name}  (tier {def.tier})`, { bold = true })
			UI.label(card, def.description, { size = 13 })
			if state.equipment[def.id] then
				UI.label(card, "Owned", { bold = true, size = 13 })
			elseif def.price <= 0 then
				UI.label(card, "Not for sale", { size = 13 })
			elseif def.requiresMilestone and not state.milestones[def.requiresMilestone] then
				UI.label(card, "Locked: deliver your first order", { size = 13, color = Theme.Coral })
			elseif state.cash < def.price then
				UI.label(card, `Costs ${def.price}. You need ${math.ceil(def.price - state.cash)} more.`, { size = 13, color = Theme.Coral })
			else
				UI.button(card, `Buy for ${def.price}`, Theme.Butter, function()
					local ok, res = Remotes.func("BuyEquipment"):InvokeServer(def.id)
					ctx.say(tostring(res))
					ctx.rerender()
					return ok
				end)
			end
		end
	end
end

return GearUp
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX49"><Properties><string name="Name">Ledger</string><ProtectedString name="Source"><![CDATA[--!strict
-- Ledger: gross income, supply cost, wages, delivery cost and net profit, always shown separately.
local UI = require(script.Parent.Parent.Modules.UI)

local Theme = UI.Theme

local Ledger = {}
Ledger.id = "ledger"

function Ledger.render(ctx: any)
	local s = ctx.state.stats
	local costs = s.supplies + s.wages + s.delivery + s.other
	local net = s.gross - costs
	local card = UI.card(ctx.content)
	UI.label(card, "Business summary", { bold = true, size = 17 })
	UI.label(card, `Orders completed: {s.orders}`)
	UI.label(card, `Gross income: ${s.gross}`)
	UI.label(card, `Ingredient costs: ${s.supplies}`)
	UI.label(card, `Delivery fees: ${s.delivery}`)
	UI.label(card, `Wages: ${s.wages}`)
	UI.label(card, `Equipment and other: ${s.other}`)
	UI.label(card, `Net profit: {if net < 0 then "-" else ""}${math.abs(net)}`, { bold = true, size = 17, color = if net < 0 then Theme.Coral else Theme.Cocoa })
	UI.label(ctx.content, "Cash on hand is separate: it also includes your starting $250.", { size = 13 })
end

return Ledger
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX50"><Properties><string name="Name">MarketPulse</string><ProtectedString name="Source"><![CDATA[--!strict
-- MarketPulse: today's market event, your contract against a rival bakery, and the top earners.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Market = require(ReplicatedStorage.Shared.Config.Market)
local Recipes = require(ReplicatedStorage.Shared.Config.Recipes)
local Remotes = require(ReplicatedStorage.Shared.Modules.Remotes)
local UI = require(script.Parent.Parent.Modules.UI)

local Theme = UI.Theme

local cached: any = nil
local cachedAt = 0

local MarketPulse = {}
MarketPulse.id = "marketpulse"

function MarketPulse.render(ctx: any)
	local state = ctx.state
	if cached == nil or os.clock() - cachedAt > 20 then
		local fresh = Remotes.func("MarketStatus"):InvokeServer()
		if fresh then
			cached = fresh
			cachedAt = os.clock()
		end
	end
	local info = cached

	if info then
		local ev = UI.card(ctx.content, Theme.Butter)
		UI.label(ev, `Today: {info.event.name}`, { bold = true })
		UI.label(ev, info.event.desc, { size = 13 })
		UI.label(ev, `Changes in about {math.ceil(info.secondsLeft / 60)} min.`, { size = 13 })
	end

	UI.label(ctx.content, "Contract", { bold = true, size = 18 })
	local c = state.contract
	if c then
		local rival = "A rival"
		for _, r in Market.rivals do
			if r.id == c.rivalId then
				rival = r.name
			end
		end
		local card = UI.card(ctx.content)
		UI.label(card, `{c.count} x {Recipes.catalog[c.recipeId].name}, score {c.minScore}+`, { bold = true })
		UI.label(card, `Pays ${c.pay} and reputation. {rival} wants it too.`, { size = 13 })
		UI.label(card, `Expires in about {math.max(1, math.ceil((c.expiresAt - os.time()) / 60))} min.`, { size = 13 })
		UI.label(card, "Cookies on display or promised to an order do not count.", { size = 13 })
		UI.button(card, "Deliver from my stock", Theme.Butter, function()
			local ok, msg = Remotes.func("ContractDeliver"):InvokeServer()
			ctx.say(tostring(msg))
			ctx.rerender()
			return ok
		end)
	else
		UI.label(ctx.content, "No contract right now. A new one will appear soon.", { size = 13 })
	end
	UI.label(ctx.content, `You have won {state.contractWins} and lost {state.contractLosses} to rivals.`, { size = 13 })

	UI.label(ctx.content, "Top earners", { bold = true, size = 18 })
	if info and #info.board > 0 then
		for i, row in info.board do
			UI.label(ctx.content, `{i}. {row.name}  ${row.gross}`, { size = 14 })
		end
	else
		UI.label(ctx.content, "The board is empty or unavailable right now.", { size = 13 })
	end
end

return MarketPulse
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX51"><Properties><string name="Name">PantryDash</string><ProtectedString name="Source"><![CDATA[--!strict
-- PantryDash: build a cart, pick a property, review subtotal, fee, ETA and storage, then order.
-- The same DeliveryMath the server uses draws the preview, so what you see is what the server will charge.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Ingredients = require(ReplicatedStorage.Shared.Config.Ingredients)
local Properties = require(ReplicatedStorage.Shared.Config.Properties)
local DeliveryMath = require(ReplicatedStorage.Shared.Modules.DeliveryMath)
local Remotes = require(ReplicatedStorage.Shared.Modules.Remotes)
local UI = require(script.Parent.Parent.Modules.UI)

local Theme = UI.Theme

local cart: { [string]: number } = {}
local destination = "apartment"

local PantryDash = {}
PantryDash.id = "pantrydash"

local function sortedIngredientIds(): { string }
	local ids = {}
	for id in Ingredients do
		table.insert(ids, id)
	end
	table.sort(ids, function(a: string, b: string)
		local ca: number, cb: number = Ingredients[a].cost, Ingredients[b].cost
		if ca ~= cb then
			return ca < cb
		end
		return a < b
	end)
	return ids
end

function PantryDash.render(ctx: any)
	local content = ctx.content
	local state = ctx.state

	-- destination: owned properties that can receive deliveries
	local ownedIds = {}
	for id in state.properties do
		local def = Properties[id]
		if def and def.receivingName then
			table.insert(ownedIds, id)
		end
	end
	table.sort(ownedIds)
	if not state.properties[destination] and #ownedIds > 0 then
		destination = ownedIds[1]
	end

	local summary = UI.card(content, Theme.Butter)
	local capacity = DeliveryMath.capacity(state)
	UI.label(summary, `Storage: {DeliveryMath.units(state)} / {capacity} items (including deliveries on the way)`, { size = 13 })

	for _, id in ownedIds do
		local def = Properties[id]
		UI.button(summary, `{if id == destination then "> " else ""}Deliver to: {def.name}`, if id == destination then Theme.Mint else Theme.Buttercream, function()
			destination = id
			ctx.rerender()
		end)
	end

	-- pending deliveries
	for _, d in state.deliveries do
		local left = d.arriveAt - os.time()
		local text = if left > 0 then `Arriving in {left}s` else "Arrived: collect the crate at your delivery mat"
		UI.label(summary, `Delivery #{d.id}: {text}`, { size = 13, bold = true })
	end

	-- cart
	for _, id in sortedIngredientIds() do
		local ing = Ingredients[id]
		local locked = table.find(ing.tags, "rare") ~= nil and state.level < DeliveryMath.RARE_UNLOCK_LEVEL
		local row = UI.row(content, 48)
		local name = UI.label(row, `{ing.name}  ${ing.cost}\nhave {state.ingredients[id] or 0}`, { size = 14 })
		name.Size = UDim2.new(0.5, 0, 0, 0)
		if locked then
			name.Text = `{ing.name}  ${ing.cost}\nunlocks at level {DeliveryMath.RARE_UNLOCK_LEVEL}`
		else
			local minus = UI.button(row, "-", Theme.Buttercream, function()
				local n = (cart[id] or 0) - 1
				cart[id] = if n > 0 then n else nil
				ctx.rerender()
			end)
			minus.Size = UDim2.fromOffset(44, 44)
			local qty = UI.label(row, tostring(cart[id] or 0), { bold = true, align = Enum.TextXAlignment.Center })
			qty.Size = UDim2.fromOffset(34, 44)
			local plus = UI.button(row, "+", Theme.Butter, function()
				cart[id] = math.min(DeliveryMath.MAX_QTY_PER_ITEM, (cart[id] or 0) + 1)
				ctx.rerender()
			end)
			plus.Size = UDim2.fromOffset(44, 44)
		end
	end

	-- quote
	local box = UI.card(content, Theme.Buttercream)
	local clean = DeliveryMath.normalize(cart)
	if not clean then
		UI.label(box, "Add items to see your total. Orders over $" .. DeliveryMath.FREE_DELIVERY_FROM .. " ship free; smaller ones pay a $" .. DeliveryMath.FEE .. " fee.", { size = 14 })
		return
	end
	local subtotal = DeliveryMath.subtotal(clean)
	UI.label(box, `Subtotal: ${subtotal}`)
	UI.label(box, `Delivery fee: ${DeliveryMath.fee(subtotal, state.vehicles)}`)
	UI.label(box, `Total: ${subtotal + DeliveryMath.fee(subtotal, state.vehicles)}   |   Cash now: ${math.floor(state.cash)}`, { bold = true })
	UI.label(box, `Arrives in about {DeliveryMath.eta(state.vehicles)} seconds at your delivery mat.`, { size = 13 })
	local quote, err = DeliveryMath.quote(state, clean, destination)
	if not quote then
		UI.label(box, tostring(err), { bold = true, color = Theme.Coral })
		UI.button(box, "Can't order yet", Color3.fromRGB(200, 192, 176))
		return
	end
	UI.label(box, `Cash after: ${math.floor(quote.cashAfter)}   |   Storage after: {quote.unitsAfter} / {quote.capacity}`, { size = 13 })
	UI.button(box, `Order delivery (${quote.total})`, Theme.Mint, function()
		local ok, res = Remotes.func("PantryOrder"):InvokeServer(clean, destination)
		if ok then
			table.clear(cart)
			ctx.say("Order placed! The courier is on the way.")
		else
			ctx.say(tostring(res))
		end
		ctx.rerender()
	end)
end

return PantryDash
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX52"><Properties><string name="Name">PropertyDesk</string><ProtectedString name="Source"><![CDATA[--!strict
-- PropertyDesk: browse properties, preview what they give you, confirm the purchase, and manage the display case.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Properties = require(ReplicatedStorage.Shared.Config.Properties)
local Remotes = require(ReplicatedStorage.Shared.Modules.Remotes)
local UI = require(script.Parent.Parent.Modules.UI)

local Theme = UI.Theme
local previewing: string? = nil

local PropertyDesk = {}
PropertyDesk.id = "propertydesk"

function PropertyDesk.render(ctx: any)
	local state = ctx.state
	UI.label(ctx.content, `Cash: ${math.floor(state.cash)}   Level {state.level}`, { bold = true })

	local list: { any } = {}
	for _, def in Properties do
		table.insert(list, def)
	end
	table.sort(list, function(a: any, b: any)
		return a.price < b.price
	end)

	local slots = 0
	for _, def in list do
		local owned = state.properties[def.id] == true
		local card = UI.card(ctx.content, if owned then Theme.Mint else Theme.Buttercream)
		UI.label(card, def.name .. (if owned then "  (owned)" else ""), { bold = true })
		UI.label(card, def.blurb or "", { size = 13 })
		UI.label(card, `Storage {def.storage}   Display slots {def.display or 0}   Rent ${def.dailyCost}/day`, { size = 13 })
		if owned then
			slots += def.display or 0
		elseif (def.unlockLevel or 1) > state.level then
			UI.label(card, `Reach level {def.unlockLevel} to buy.`, { size = 13, color = Theme.Coral })
		elseif previewing == def.id then
			local after = state.cash - def.price
			UI.label(card, `Price ${def.price}. Cash after: ${math.floor(after)}.`, { bold = true, size = 14 })
			if after < 0 then
				UI.label(card, `You need ${math.ceil(-after)} more.`, { size = 13, color = Theme.Coral })
			else
				UI.button(card, "Confirm purchase", Theme.Butter, function()
					local ok, msg = Remotes.func("PropertyBuy"):InvokeServer(def.id)
					previewing = nil
					ctx.say(tostring(msg))
					ctx.rerender()
					return ok
				end)
			end
			UI.button(card, "Cancel", nil, function()
				previewing = nil
				ctx.rerender()
			end)
		else
			UI.button(card, `Preview (${def.price})`, nil, function()
				previewing = def.id
				ctx.rerender()
			end)
		end
	end

	UI.label(ctx.content, "Display case", { bold = true, size = 18 })
	if slots == 0 then
		UI.label(ctx.content, "Buy a Food Truck or bigger to sell to walk-in customers. They pay less than custom orders, but it is passive income.", { size = 13 })
		return
	end
	local used = 0
	for _, b in state.batches do
		if b.displayed then
			used += 1
		end
	end
	UI.label(ctx.content, `{used} / {slots} slots used. Walk-in rounds happen every 20 seconds.`, { size = 13 })
	for _, b in state.batches do
		local card = UI.card(ctx.content, if b.displayed then Theme.Mint else Theme.Buttercream)
		UI.label(card, `{b.name}  x{b.count}  ({b.grade or "?"})`, { bold = true, size = 14 })
		if b.reservedFor then
			UI.label(card, "Promised to an order", { size = 13 })
		else
			UI.button(card, if b.displayed then "Take off display" else "Put on display", nil, function()
				local ok, msg = Remotes.func("DisplaySet"):InvokeServer(b.id, not b.displayed)
				ctx.say(tostring(msg))
				ctx.rerender()
				return ok
			end)
		end
	end
end

return PropertyDesk
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX53"><Properties><string name="Name">RecipeBook</string><ProtectedString name="Source"><![CDATA[--!strict
-- Recipe Book: everything you can bake, what it costs, how it fits customers, and your best result.
-- Locked recipes show only how to unlock them, so experimenting at the oven still feels like discovery.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local AppealCalc = require(ReplicatedStorage.Shared.Modules.AppealCalc)
local Customers = require(ReplicatedStorage.Shared.Config.Customers)
local Ingredients = require(ReplicatedStorage.Shared.Config.Ingredients)
local Recipes = require(ReplicatedStorage.Shared.Config.Recipes)
local UI = require(script.Parent.Parent.Modules.UI)

local Theme = UI.Theme

local RecipeBook = {}
RecipeBook.id = "recipebook"

local function costOf(requires: { [string]: number }): number
	local total = 0
	for id, n in requires do
		total += Ingredients[id].cost * n
	end
	return total
end

local function tagsOf(requires: { [string]: number }): { string }
	local set: { [string]: boolean } = {}
	for id in requires do
		for _, t in Ingredients[id].tags do
			set[t] = true
		end
	end
	local list = {}
	for t in set do
		table.insert(list, t)
	end
	table.sort(list)
	return list
end

-- Customers who love something in this recipe and whose taste in Appeal fits it.
local function fans(tags: { string }, appeal: number): string
	local names = {}
	for _, c in Customers do
		local loves, hates = false, false
		for _, t in tags do
			if table.find(c.loves, t) then
				loves = true
			end
			if table.find(c.hates, t) then
				hates = true
			end
		end
		if loves and not hates and appeal >= c.appealMin - 8 and appeal <= c.appealMax + 8 then
			table.insert(names, c.name)
		end
	end
	return if #names > 0 then table.concat(names, ", ") else "no one in particular yet"
end

local function ingredientLine(state: any, requires: { [string]: number }): string
	local ids: { string } = {}
	for id in requires do
		table.insert(ids, id)
	end
	table.sort(ids)
	local parts = {}
	for _, id in ids do
		table.insert(parts, `{requires[id]}x {Ingredients[id].name} (have {state.ingredients[id] or 0})`)
	end
	return table.concat(parts, ", ")
end

local function recipeCard(ctx: any, name: string, requires: { [string]: number }, extra: string, entry: any?, blurb: string?)
	local state = ctx.state
	local card = UI.card(ctx.content)
	UI.label(card, name, { bold = true, size = 16 })
	if blurb then
		UI.label(card, blurb, { size = 13 })
	end
	UI.label(card, ingredientLine(state, requires), { size = 13 })
	local appeal = AppealCalc.compute(Recipes.expand(requires), 0.9).score
	local tags = tagsOf(requires)
	UI.label(card, `Cost about ${costOf(requires)}  |  Appeal about {appeal}  |  Tags: {table.concat(tags, ", ")}`, { size = 13 })
	UI.label(card, `Customers who like it: {fans(tags, appeal)}`, { size = 13 })
	if entry and entry.bakes > 0 then
		UI.label(card, `Best: {entry.best}/100 ({entry.grade})  |  Baked {entry.bakes} time{if entry.bakes == 1 then "" else "s"}`, { size = 13, bold = true })
	else
		UI.label(card, "Not baked yet", { size = 13 })
	end
	if extra ~= "" then
		UI.label(card, extra, { size = 13, color = Theme.Cocoa })
	end
end

function RecipeBook.render(ctx: any)
	local state = ctx.state
	UI.label(ctx.content, "Known recipes", { bold = true, size = 18 })

	local ids = {}
	for id in Recipes.catalog do
		table.insert(ids, id)
	end
	table.sort(ids, function(a: string, b: string)
		local ra, rb = Recipes.catalog[a], Recipes.catalog[b]
		local la: number, lb: number = ra.unlockLevel or 1, rb.unlockLevel or 1
		if la ~= lb then
			return la < lb
		end
		return a < b
	end)
	for _, id in ids do
		local r = Recipes.catalog[id]
		if state.recipes[id] then
			recipeCard(ctx, r.name, r.requires, "", state.recipeBook[id], r.blurb)
		else
			local card = UI.card(ctx.content, Color3.fromRGB(226, 218, 200))
			UI.label(card, "???", { bold = true, size = 16 })
			UI.label(card, `Reach level {r.unlockLevel or 1}, or discover it by experimenting at the oven.`, { size = 13 })
		end
	end

	local customs = {}
	for key, e in state.recipeBook do
		if e.custom then
			table.insert(customs, key)
		end
	end
	table.sort(customs)
	if #customs > 0 then
		UI.label(ctx.content, "Your experiments", { bold = true, size = 18 })
		for _, key in customs do
			local slots = Recipes.parseCustomKey(key)
			local e = state.recipeBook[key]
			if slots then
				local need = Recipes.requiresFor(slots)
				local practice = math.min(e.bakes, #Recipes.CUSTOM_CORRECTNESS - 1)
				recipeCard(ctx, e.name, need, `Practice {practice}/{#Recipes.CUSTOM_CORRECTNESS - 1}: more bakes refine the recipe.`, e, nil)
			end
		end
	end
	UI.label(ctx.content, "Experiment at the oven (Experiment button) to discover new recipes. Good results are saved here.", { size = 13 })
end

return RecipeBook
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX54"><Properties><string name="Name">Settings</string><ProtectedString name="Source"><![CDATA[--!strict
-- Settings: text size, sound volume and effects. Changes are saved on the server and apply right away.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Brand = require(ReplicatedStorage.Shared.Config.Brand)
local Remotes = require(ReplicatedStorage.Shared.Modules.Remotes)
local UI = require(script.Parent.Parent.Modules.UI)

local Theme = UI.Theme

local Settings = {}
Settings.id = "settings"

local function set(ctx: any, key: string, value: any)
	local ok, msg = Remotes.func("SettingSet"):InvokeServer(key, value)
	if not ok then
		ctx.say(tostring(msg))
	end
end

function Settings.render(ctx: any)
	local s = ctx.state.settings
	UI.label(ctx.content, "Text size", { bold = true, size = 18 })
	local row = UI.row(ctx.content)
	for _, scale in Brand.TEXT_SCALES do
		local b = UI.button(row, `{scale * 100}%`, if s.textScale == scale then Theme.Butter else Theme.Buttercream, function()
			set(ctx, "textScale", scale)
		end)
		b.Size = UDim2.new(1 / #Brand.TEXT_SCALES, -4, 0, UI.MIN_TOUCH)
		b.AutomaticSize = Enum.AutomaticSize.None
	end

	UI.label(ctx.content, "Sound volume", { bold = true, size = 18 })
	local vrow = UI.row(ctx.content)
	for _, level in { 0, 0.3, 0.6, 1 } do
		local b = UI.button(vrow, if level == 0 then "Off" else `{level * 100}%`, if math.abs(s.sfx - level) < 0.05 then Theme.Butter else Theme.Buttercream, function()
			set(ctx, "sfx", level)
		end)
		b.Size = UDim2.new(0.25, -4, 0, UI.MIN_TOUCH)
		b.AutomaticSize = Enum.AutomaticSize.None
	end

	UI.label(ctx.content, "Guidance", { bold = true, size = 18 })
	UI.button(ctx.content, if s.guidance then "Goal hints: ON" else "Goal hints: OFF", if s.guidance then Theme.Mint else Theme.Buttercream, function()
		set(ctx, "guidance", not s.guidance)
	end)
	UI.label(ctx.content, "Everything in the game works with touch, mouse or keyboard. Nothing is timed against you while menus are open.", { size = 13 })
end

return Settings
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX55"><Properties><string name="Name">StaffBoard</string><ProtectedString name="Source"><![CDATA[--!strict
-- StaffBoard: hire bakers, choose what they bake, and read exactly why each one is working or waiting.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Recipes = require(ReplicatedStorage.Shared.Config.Recipes)
local Staff = require(ReplicatedStorage.Shared.Config.Staff)
local Remotes = require(ReplicatedStorage.Shared.Modules.Remotes)
local UI = require(script.Parent.Parent.Modules.UI)

local Theme = UI.Theme
local picking: string? = nil -- staff id whose recipe list is open

local StaffBoard = {}
StaffBoard.id = "staffboard"

function StaffBoard.render(ctx: any)
	local state = ctx.state
	UI.label(ctx.content, `Cash: ${math.floor(state.cash)}   Staff {#state.staff}`, { bold = true })
	UI.label(ctx.content, "Each extra oven (Food Truck or bigger) fits one baker. Wages are paid every 10 minutes.", { size = 13 })

	UI.label(ctx.content, "Your team", { bold = true, size = 18 })
	if #state.staff == 0 then
		UI.label(ctx.content, "Nobody yet. Hire someone below.", { size = 13 })
	end
	for _, e in state.staff do
		local c = Staff.candidates[e.id]
		local card = UI.card(ctx.content, Theme.Mint)
		UI.label(card, `{c.name}  (skill {c.skill + (if e.bakes >= Staff.PROMOTE_EVERY then 1 else 0)}, {e.bakes} bakes)`, { bold = true })
		UI.label(card, e.status, { size = 13, color = if e.unpaid then Theme.Coral else nil })
		UI.label(card, `Bakes: {if e.recipeId then Recipes.catalog[e.recipeId].name else "nothing yet"}`, { size = 13 })
		if picking == e.id then
			local ids: { string } = {}
			for rid in Recipes.catalog do
				if state.recipes[rid] then
					table.insert(ids, rid)
				end
			end
			table.sort(ids)
			for _, rid in ids do
				do
					UI.button(card, Recipes.catalog[rid].name, nil, function()
						picking = nil
						local ok, msg = Remotes.func("StaffAssign"):InvokeServer(e.id, rid)
						ctx.say(tostring(msg))
						ctx.rerender()
						return ok
					end)
				end
			end
		else
			UI.button(card, "Choose recipe", Theme.Butter, function()
				picking = e.id
				ctx.rerender()
			end)
		end
		UI.button(card, "Let go", Theme.Coral, function()
			local _, msg = Remotes.func("StaffFire"):InvokeServer(e.id)
			ctx.say(tostring(msg))
			ctx.rerender()
		end)
	end

	UI.label(ctx.content, "Hire", { bold = true, size = 18 })
	for _, id in Staff.order do
		local c = Staff.candidates[id]
		local hired = false
		for _, e in state.staff do
			if e.id == id then
				hired = true
			end
		end
		if not hired then
			local card = UI.card(ctx.content)
			UI.label(card, `{c.name}  skill {c.skill}  wage ${c.wage}/day`, { bold = true })
			UI.label(card, `{c.blurb} One batch every {c.cycle}s.`, { size = 13 })
			UI.button(card, `Hire for ${c.wage}`, Theme.Butter, function()
				local ok, msg = Remotes.func("StaffHire"):InvokeServer(id)
				ctx.say(tostring(msg))
				ctx.rerender()
				return ok
			end)
		end
	end
end

return StaffBoard
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX56"><Properties><string name="Name">Wheelhouse</string><ProtectedString name="Source"><![CDATA[--!strict
-- Wheelhouse: buy vehicles and spawn the one you own. Vehicles speed up PantryDash couriers; walking always works.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Vehicles = require(ReplicatedStorage.Shared.Config.Vehicles)
local Remotes = require(ReplicatedStorage.Shared.Modules.Remotes)
local UI = require(script.Parent.Parent.Modules.UI)

local Theme = UI.Theme

local Wheelhouse = {}
Wheelhouse.id = "wheelhouse"

function Wheelhouse.render(ctx: any)
	local state = ctx.state
	UI.label(ctx.content, `Cash: ${math.floor(state.cash)}   Level {state.level}`, { bold = true })
	UI.label(ctx.content, "Drive with W/A/S/D from the driver seat. Owning a vehicle also speeds up ingredient deliveries.", { size = 13 })
	for _, id in Vehicles.order do
		local def = Vehicles.catalog[id]
		local owned = state.vehicles[id] == true
		local card = UI.card(ctx.content, if owned then Theme.Mint else Theme.Buttercream)
		UI.label(card, def.name .. (if owned then "  (owned)" else ""), { bold = true })
		UI.label(card, def.blurb, { size = 13 })
		if owned then
			UI.button(card, "Spawn it near me", Theme.Butter, function()
				local ok, msg = Remotes.func("VehicleSpawn"):InvokeServer(id)
				ctx.say(tostring(msg))
				return ok
			end)
		elseif state.level < def.unlockLevel then
			UI.label(card, `Reach level {def.unlockLevel} to buy.`, { size = 13, color = Theme.Coral })
		elseif state.cash < def.price then
			UI.label(card, `Costs ${def.price}. You need ${math.ceil(def.price - state.cash)} more.`, { size = 13, color = Theme.Coral })
		else
			UI.button(card, `Buy for ${def.price}`, Theme.Butter, function()
				local ok, msg = Remotes.func("VehicleBuy"):InvokeServer(id)
				ctx.say(tostring(msg))
				ctx.rerender()
				return ok
			end)
		end
	end
	if next(state.vehicles) then
		UI.button(ctx.content, "Put my vehicle away", nil, function()
			Remotes.func("VehicleRemove"):InvokeServer()
		end)
	end
end

return Wheelhouse
]]></ProtectedString></Properties></Item></Item><Item class="LocalScript" referent="RBX58"><Properties><string name="Name">ClientBootstrap</string><ProtectedString name="Source"><![CDATA[--!strict
-- Loads every ModuleScript in Controllers and calls :Init() then :Start() on each.
local controllers = script.Parent:WaitForChild("Controllers")

local loaded = {}
for _, module in controllers:GetChildren() do
	if module:IsA("ModuleScript") then
		local ok, c = pcall(require, module)
		if ok then
			table.insert(loaded, { name = module.Name, c = c })
		else
			warn(`[Client] failed to load {module.Name}: {c}`)
		end
	end
end

for _, entry in loaded do
	if type(entry.c) == "table" and entry.c.Init then
		local ok, err = pcall(entry.c.Init, entry.c)
		if not ok then
			warn(`[Client] {entry.name}:Init failed: {err}`)
		end
	end
end
for _, entry in loaded do
	if type(entry.c) == "table" and entry.c.Start then
		task.spawn(function()
			local ok, err = pcall(entry.c.Start, entry.c)
			if not ok then
				warn(`[Client] {entry.name}:Start failed: {err}`)
			end
		end)
	end
end

print(`[Client] started {#loaded} controllers`)
]]></ProtectedString></Properties></Item><Item class="Folder" referent="RBX66"><Properties><string name="Name">Controllers</string></Properties><Item class="ModuleScript" referent="RBX59"><Properties><string name="Name">BakingController</string><ProtectedString name="Source"><![CDATA[--!strict
-- Baking station UI: pick a recipe (or experiment), pick which order it is for, then Mix, Portion, Bake, Cool and Package.
-- Opens when the server accepts an interaction with a BakeStation (see InteractionService). The server owns every
-- timer and score; this file only draws the screens and sends the player's button presses.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Baking = require(ReplicatedStorage.Shared.Config.Baking)
local Equipment = require(ReplicatedStorage.Shared.Config.Equipment)
local Ingredients = require(ReplicatedStorage.Shared.Config.Ingredients)
local Recipes = require(ReplicatedStorage.Shared.Config.Recipes)
local AppealCalc = require(ReplicatedStorage.Shared.Modules.AppealCalc)
local Quality = require(ReplicatedStorage.Shared.Modules.Quality)
local Remotes = require(ReplicatedStorage.Shared.Modules.Remotes)
local UI = require(script.Parent.Parent.Modules.UI)
local HUD = require(script.Parent.HUDController)
local UIBus = require(script.Parent.UIBus)

local Theme = UI.Theme

local BakingController = {}

function BakingController:Init() end

function BakingController:Start()
	local gui = Instance.new("ScreenGui")
	gui.Name = "Bake"
	gui.ResetOnSpawn = false
	gui.Enabled = false
	gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")

	local frame = Instance.new("Frame")
	frame.AnchorPoint = Vector2.new(0.5, 0.5)
	frame.Position = UDim2.fromScale(0.5, 0.5)
	frame.Size = UDim2.fromScale(0.92, 0.88)
	frame.BackgroundColor3 = Theme.Buttercream
	frame.BorderSizePixel = 0
	frame.Parent = gui
	UI.corner(frame, 18)
	UI.stroke(frame, 3)
	local limits = Instance.new("UISizeConstraint")
	limits.MinSize = Vector2.new(300, 360)
	limits.MaxSize = Vector2.new(430, 640)
	limits.Parent = frame

	local content = Instance.new("ScrollingFrame")
	content.Size = UDim2.fromScale(1, 1)
	content.BackgroundTransparency = 1
	content.BorderSizePixel = 0
	content.AutomaticCanvasSize = Enum.AutomaticSize.Y
	content.CanvasSize = UDim2.new()
	content.ScrollBarThickness = 6
	content.Parent = frame
	UI.padding(content, 10)
	UI.list(content, 6)

	local bakeStatus = Remotes.func("BakeStatus")
	local bakeStart = Remotes.func("BakeStart")
	local bakeStep = Remotes.func("BakeStep")

	local generation = 0 -- bumped on every screen change so stale timers stop themselves
	local selectedRecipe = "classic_chip" -- catalog id or "experiment"
	local selectedOrder: number? = nil
	local batchMult = 1
	local slots: { [string]: string? } = { flavor = "white_sugar" }
	local showStage: (info: any) -> ()
	local showKitchen: (message: string?) -> ()

	local function clear()
		generation += 1
		UI.clear(content)
	end

	local function title(text: string)
		UI.label(content, text, { bold = true, size = 20 })
	end

	local function step(action: string, arg: any?): (boolean, any)
		local ok, res = bakeStep:InvokeServer(action, arg)
		return ok, res
	end

	-- A bar that fills over IDEAL * BAR_FACTOR seconds with a green zone around the ideal moment.
	local function timingBar(ideal: number, startedAgo: number, buttonText: string, onStop: () -> (), slack: number?)
		local mine = generation
		local bar = Instance.new("Frame")
		bar.Size = UDim2.new(1, 0, 0, 30)
		bar.BackgroundColor3 = Color3.fromRGB(230, 214, 184)
		bar.BorderSizePixel = 0
		bar.Parent = content
		UI.corner(bar)
		local width = 2 * (Baking.ZONE_HALF * ideal + (slack or 0)) / (ideal * Baking.BAR_FACTOR)
		local zone = Instance.new("Frame")
		zone.Size = UDim2.fromScale(width, 1)
		zone.Position = UDim2.fromScale(0.5 - width / 2, 0)
		zone.BackgroundColor3 = Theme.Mint
		zone.BorderSizePixel = 0
		zone.Parent = bar
		local fill = Instance.new("Frame")
		fill.Size = UDim2.fromScale(0, 1)
		fill.BackgroundColor3 = Theme.Butter
		fill.BackgroundTransparency = 0.35
		fill.BorderSizePixel = 0
		fill.Parent = bar

		local t0 = os.clock() - startedAgo
		local conn: RBXScriptConnection
		conn = RunService.RenderStepped:Connect(function()
			if generation ~= mine then
				conn:Disconnect()
				return
			end
			fill.Size = UDim2.fromScale(math.clamp((os.clock() - t0) / (ideal * Baking.BAR_FACTOR), 0, 1), 1)
		end)
		UI.button(content, buttonText, Theme.Coral, function()
			if generation == mine then
				conn:Disconnect()
				onStop()
			end
		end)
	end

	local function percent(x: number): string
		return `{math.floor(x * 100 + 0.5)}%`
	end

	local function showResult(res: any)
		clear()
		local batch = res.batch
		title(`{batch.grade}! ({batch.score}/100)`)
		if res.discovered then
			UI.label(content, "Discovery! This recipe is now in your Recipe Book.", { bold = true, color = Theme.Coral })
		end
		UI.label(content, batch.name, { bold = true, size = 17 })
		-- the grade, explained: each factor and how much it counts
		local f = batch.factors
		local w = Quality.WEIGHTS
		local card = UI.card(content)
		UI.label(card, "How your score was made", { bold = true, size = 14 })
		UI.label(card, `Recipe {percent(f.recipe)}  (counts {percent(w.recipe)})`, { size = 13 })
		UI.label(card, `Bake timing {percent(f.bake)}  (counts {percent(w.bake)})`, { size = 13 })
		UI.label(card, `Ingredient freshness {percent(f.fresh)}  (counts {percent(w.fresh)})`, { size = 13 })
		UI.label(card, `Portion consistency {percent(f.portion)}  (counts {percent(w.portion)})`, { size = 13 })
		UI.label(content, tostring(batch.feedback), { bold = true })
		UI.label(content, `Appeal {batch.appeal}   |   {batch.count} cookies boxed`, { size = 14 })
		if res.orderId then
			if res.linkedOrder then
				UI.label(content, "Order status: Ready. Open your phone (P) to deliver it.", { bold = true })
			else
				UI.label(content, "The order is gone, so these cookies went to your stock.")
			end
		else
			UI.label(content, "Boxed into your stock. Assign it to an order from your phone.", { size = 14 })
		end
		UI.button(content, "Bake another batch", Theme.Butter, function()
			selectedOrder = nil
			showKitchen()
		end)
		UI.button(content, "Close", Theme.Coral, function()
			gui.Enabled = false
		end)
	end

	function showStage(info: any)
		clear()
		local stage = info.stage
		local forOrder = if info.orderId then "  (for an order)" else ""

		if stage == "mix" then
			title(`Step 1 of 5: Mix{forOrder}`)
			local taps = info.mixTaps or 8
			UI.label(content, `Tap Stir {taps} times to mix the dough.`)
			local bar = Instance.new("Frame")
			bar.Size = UDim2.new(1, 0, 0, 24)
			bar.BackgroundColor3 = Color3.fromRGB(230, 214, 184)
			bar.BorderSizePixel = 0
			bar.Parent = content
			UI.corner(bar)
			local fill = Instance.new("Frame")
			fill.Size = UDim2.fromScale(0, 1)
			fill.BackgroundColor3 = Theme.Mint
			fill.BorderSizePixel = 0
			fill.Parent = bar
			local message = UI.label(content, "")
			local count = 0
			local mine = generation
			UI.button(content, "Stir!", Theme.Coral, function()
				if generation ~= mine or count >= taps then
					return
				end
				count += 1
				fill.Size = UDim2.fromScale(count / taps, 1)
				if count < taps then
					return
				end
				message.Text = "Almost there..."
				task.spawn(function()
					for _ = 1, 20 do
						local ok, res = step("mixDone")
						if generation ~= mine then
							return
						end
						if ok then
							showStage(res)
							return
						end
						if res ~= "keep stirring a little longer" then
							message.Text = tostring(res)
							return
						end
						task.wait(0.5)
					end
				end)
			end)
		elseif stage == "portion" then
			title(`Step 2 of 5: Portion{forOrder}`)
			UI.label(content, "Scoop the dough. Stop the bar in the green zone for even cookies.")
			if info.running then
				timingBar(Baking.PORTION_IDEAL, info.elapsed or 0, "Scoop!", function()
					local ok, res = step("portionStop")
					if ok then
						showStage(res)
					else
						UI.label(content, tostring(res))
					end
				end)
			else
				UI.button(content, "Start portioning", Theme.Coral, function()
					local ok, res = step("portionStart")
					if ok then
						showStage(res)
					end
				end)
			end
		elseif stage == "bake" then
			title(`Step 3 of 5: Bake{forOrder}`)
			UI.label(content, "Pull the tray when the bar reaches the green zone. Too early is doughy, too late is dark.")
			if info.running then
				timingBar(Baking.BAKE_IDEAL, info.elapsed or 0, "Pull the tray!", function()
					local ok, res = step("ovenPull")
					if ok then
						showStage(res)
					else
						UI.label(content, tostring(res))
					end
				end, info.bakeSlack)
			else
				UI.button(content, "Load tray into the oven", Theme.Coral, function()
					local ok, res = step("ovenStart")
					if ok then
						showStage(res)
					end
				end)
			end
		elseif stage == "cool" then
			title(`Step 4 of 5: Cool{forOrder}`)
			UI.label(content, "Let the tray rest on the rack so the cookies set.")
			local countdown = UI.label(content, "", { bold = true, size = 18 })
			local mine = generation
			local endsAt = os.clock() + (info.coolRemaining or 0)
			task.spawn(function()
				while generation == mine and os.clock() < endsAt do
					countdown.Text = `Cooling... {math.ceil(endsAt - os.clock())}s`
					task.wait(0.2)
				end
				if generation ~= mine then
					return
				end
				-- allow a little network slack before the server agrees the tray has cooled
				for _ = 1, 10 do
					local ok, res = step("coolDone")
					if generation ~= mine then
						return
					end
					if ok then
						showStage(res)
						return
					end
					task.wait(0.3)
				end
				countdown.Text = "The tray is still cooling. Close and reopen the station."
			end)
		elseif stage == "package" then
			title(`Step 5 of 5: Package{forOrder}`)
			UI.label(content, `This tray has {info.yield} cookies. Pick the box that fits.`)
			local message = UI.label(content, "", { color = Theme.Coral, bold = true })
			local mine = generation
			for _, box in Recipes.boxes do
				UI.button(content, `{box.name} ({box.size} cookies)`, Theme.Butter, function()
					if generation ~= mine then
						return
					end
					local ok, res = step("pack", box.id)
					if ok then
						showResult(res)
					else
						message.Text = tostring(res)
					end
				end)
			end
		end
	end

	-- What the currently selected recipe needs, as { recipeName, requires } or nil with a reason.
	local function currentRecipe(state: any): (string?, { [string]: number }?, string?)
		if selectedRecipe == "experiment" then
			local clean, err = Recipes.validateSlots(slots :: any)
			if not clean then
				return nil, nil, err
			end
			local named = Recipes.matchCatalog(clean)
			local name = if named and state.recipes[named.id] then named.name else "Experimental cookies"
			return name, Recipes.requiresFor(clean), nil
		end
		local r = Recipes.catalog[selectedRecipe]
		if r and state.recipes[r.id] then
			return r.name, r.requires, nil
		end
		return nil, nil, "pick a recipe"
	end

	function showKitchen(message: string?)
		clear()
		local state = HUD.state
		if not state then
			UI.label(content, "Loading...")
			return
		end
		local effects = Equipment.effective(state.equipment)
		title("Kitchen")
		if message then
			UI.label(content, message, { bold = true, color = Theme.Coral })
		end

		-- 1. recipe
		UI.label(content, "1. Pick a recipe", { bold = true })
		local ids = {}
		for id in Recipes.catalog do
			if state.recipes[id] then
				table.insert(ids, id)
			end
		end
		table.sort(ids, function(a: string, b: string)
			local ra, rb = Recipes.catalog[a], Recipes.catalog[b]
			local la: number, lb: number = ra.unlockLevel or 1, rb.unlockLevel or 1
			if la ~= lb then
				return la < lb
			end
			return a < b
		end)
		if selectedRecipe ~= "experiment" and not state.recipes[selectedRecipe] then
			selectedRecipe = "classic_chip"
		end
		for _, id in ids do
			local r = Recipes.catalog[id]
			local cost = 0
			for ing, n in r.requires do
				cost += Ingredients[ing].cost * n
			end
			local appeal = AppealCalc.compute(Recipes.expand(r.requires), 0.9).score
			local chosen = selectedRecipe == id
			UI.button(content, `{if chosen then "> " else ""}{r.name}  (about ${cost}, Appeal ~{appeal})`, if chosen then Theme.Mint else Theme.Buttercream, function()
				selectedRecipe = id
				showKitchen()
			end)
		end
		UI.button(content, `{if selectedRecipe == "experiment" then "> " else ""}Experiment: invent a recipe`, if selectedRecipe == "experiment" then Theme.Mint else Theme.Blueberry, function()
			selectedRecipe = "experiment"
			showKitchen()
		end)

		-- experiment slots
		if selectedRecipe == "experiment" then
			UI.label(content, "Dough (flour and butter) is always included. Add a flavor, and optionally a mix-in and a finish.", { size = 13 })
			for _, slot in Recipes.slotOrder do
				local def = Recipes.slots[slot]
				UI.label(content, `{string.upper(string.sub(slot, 1, 1))}{string.sub(slot, 2)}{if def.required then " (required)" else " (optional)"}`, { bold = true, size = 14 })
				if not def.required then
					UI.button(content, `{if slots[slot] == nil then "> " else ""}None`, if slots[slot] == nil then Theme.Mint else Theme.Buttercream, function()
						slots[slot] = nil
						showKitchen()
					end)
				end
				for _, opt in def.options do
					local locked = opt ~= "white_sugar" and (state.ingredients[opt] or 0) == 0
					local label = `{if slots[slot] == opt then "> " else ""}{Ingredients[opt].name} (have {state.ingredients[opt] or 0})`
					UI.button(content, label, if slots[slot] == opt then Theme.Mint else Theme.Buttercream, function()
						slots[slot] = opt
						showKitchen()
					end)
					_ = locked
				end
			end
		end

		-- summary for the current choice
		local name, requires, why = currentRecipe(state)
		local missingAny = false
		if requires and name then
			local summary = UI.card(content)
			UI.label(summary, name, { bold = true })
			local ids2: { string } = {}
			for id in requires do
				table.insert(ids2, id)
			end
			table.sort(ids2)
			local cost = 0
			for _, id in ids2 do
				local need = requires[id] * batchMult
				local have = state.ingredients[id] or 0
				cost += Ingredients[id].cost * need
				if have < need then
					missingAny = true
				end
				UI.label(summary, `{Ingredients[id].name}: need {need}, have {have}`, { size = 13, color = if have >= need then Theme.Cocoa else Theme.Coral })
			end
			local appeal = AppealCalc.compute(Recipes.expand(requires, batchMult), 0.9).score
			local tagSet: { [string]: boolean } = {}
			for id in requires do
				for _, t in Ingredients[id].tags do
					tagSet[t] = true
				end
			end
			local tags = {}
			for t in tagSet do
				table.insert(tags, t)
			end
			table.sort(tags)
			UI.label(summary, `Cost about ${cost}  |  Appeal about {appeal}  |  Tags: {table.concat(tags, ", ")}`, { size = 13 })
			if selectedRecipe == "experiment" then
				UI.label(summary, "New combinations score lower at first. Bake the same experiment again to perfect it.", { size = 13 })
			end
		elseif why then
			UI.label(content, why, { color = Theme.Coral })
		end

		-- 2. order
		local accepted = {}
		for _, o in HUD.orders do
			if o.state == "Accepted" then
				local fits = o.recipeId == "any" or o.recipeId == selectedRecipe
				if fits then
					table.insert(accepted, o)
				end
			end
		end
		if selectedOrder then
			local still = false
			for _, o in accepted do
				if o.id == selectedOrder then
					still = true
				end
			end
			if not still then
				selectedOrder = nil
			end
		end
		UI.label(content, "2. Bake for which order?", { bold = true })
		if #accepted > 0 then
			for _, o in accepted do
				local chosen = selectedOrder == o.id
				UI.button(content, `{if chosen then "> " else ""}{o.customerName}: {o.count} cookies`, if chosen then Theme.Mint else Theme.Buttercream, function()
					selectedOrder = if chosen then nil else o.id
					showKitchen()
				end)
			end
			UI.label(content, "Tap an order again to bake for stock instead.", { size = 12 })
		else
			UI.label(content, "No accepted order fits this recipe. You can bake for stock, or accept an order on your phone (P).", { size = 13 })
		end

		-- 3. batch size
		if effects.maxBatchMult >= 2 then
			UI.label(content, "3. Batch size", { bold = true })
			UI.button(content, `{if batchMult == 1 then "> " else ""}Single batch (6 cookies)`, if batchMult == 1 then Theme.Mint else Theme.Buttercream, function()
				batchMult = 1
				showKitchen()
			end)
			UI.button(content, `{if batchMult == 2 then "> " else ""}Double batch (12 cookies, Large box)`, if batchMult == 2 then Theme.Mint else Theme.Buttercream, function()
				batchMult = 2
				showKitchen()
			end)
		else
			batchMult = 1
		end

		if missingAny then
			UI.label(content, "You are short on ingredients. Order more with PantryDash on your phone.", { bold = true, color = Theme.Coral })
			UI.button(content, "Open PantryDash", Theme.Blueberry, function()
				gui.Enabled = false
				UIBus.Open:Fire("PhonePantry")
			end)
		end
		UI.button(content, "Start baking", Theme.Coral, function()
			local options: any = { batchMult = batchMult }
			local recipeId = selectedRecipe
			if selectedRecipe == "experiment" then
				options.slots = slots
			end
			local ok, res = bakeStart:InvokeServer(recipeId, selectedOrder, options)
			if ok then
				showStage(res)
			else
				showKitchen(tostring(res))
			end
		end)
		UI.button(content, "Close", Theme.Butter, function()
			gui.Enabled = false
		end)
	end

	UIBus.Open.Event:Connect(function(panel)
		if panel ~= "Bake" then
			return
		end
		gui.Enabled = true
		local info = bakeStatus:InvokeServer()
		if info then
			showStage(info) -- resume a bake that was left half-finished
		else
			showKitchen()
		end
	end)
end

return BakingController
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX60"><Properties><string name="Name">HUDController</string><ProtectedString name="Source"><![CDATA[--!strict
-- Always-visible HUD: cash and level, the current objective, and on-screen Phone / Gear buttons (touch friendly).
-- Also keeps the latest server state for other controllers (HUD:OnState).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = require(ReplicatedStorage.Shared.Modules.Remotes)
local Theme = require(ReplicatedStorage.Shared.Config.Theme)
local Milestones = require(ReplicatedStorage.Shared.Config.Milestones)
local RunService = game:GetService("RunService")
local UIBus = require(script.Parent.UIBus)

local HUD = {}
HUD.state = nil :: any
HUD.orders = {} :: { any }
local listeners: { (any) -> () } = {}
local orderListeners: { (any) -> () } = {}

-- Called whenever the server sends the full order list (and once right away if we already have it).
function HUD:OnOrders(fn: (any) -> ())
	table.insert(orderListeners, fn)
	fn(HUD.orders)
end

function HUD:OnState(fn: (any) -> ())
	table.insert(listeners, fn)
	if HUD.state then
		fn(HUD.state)
	end
end

-- The objective follows the most advanced active order, so the first loop is always spelled out.
local function objectiveFor(state: any, orders: { any }): string
	local best: any = nil
	local rank = { Available = 1, Accepted = 2, ["In Production"] = 3, Ready = 4 }
	for _, o in orders do
		if not best or (rank[o.state] or 0) > (rank[best.state] or 0) then
			best = o
		end
	end
	if best then
		if best.state == "Available" then
			return `Open your phone (P or the Phone button) and accept {best.customerName}'s order.`
		elseif best.state == "Accepted" then
			return `Tap the 🍪 Bake button (bottom right) to bake {best.recipeName}. Or walk to the kitchen counter and press E.`
		elseif best.state == "In Production" then
			return "Finish your bake: tap the 🍪 Bake button (or press E at the counter) to continue."
		elseif best.state == "Ready" then
			return `Open your phone and deliver the cookies to {best.customerName}.`
		end
	end
	if state.milestones and state.milestones.firstOrderDone then
		return "Nice work! Wait for new orders, or order ingredients in PantryDash on your phone."
	end
	return "Waiting for your first customer to text you..."
end

local function card(parent: Instance, size: UDim2, position: UDim2): Frame
	local f = Instance.new("Frame")
	f.Size = size
	f.Position = position
	f.BackgroundColor3 = Theme.Buttercream
	f.BorderSizePixel = 0
	f.Parent = parent
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 16)
	corner.Parent = f
	local stroke = Instance.new("UIStroke")
	stroke.Color = Theme.Cocoa
	stroke.Thickness = 2
	stroke.Transparency = 0.1
	stroke.Parent = f
	local grad = Instance.new("UIGradient")
	grad.Rotation = 90
	grad.Color = ColorSequence.new(Theme.Cream, Theme.Peach)
	grad.Parent = f
	return f
end

local function label(parent: Instance, text: string, size: number, pos: UDim2, dim: UDim2): TextLabel
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Size = dim
	l.Position = pos
	l.Font = Enum.Font.GothamBold
	l.TextSize = size
	l.TextColor3 = Theme.Cocoa
	l.TextXAlignment = Enum.TextXAlignment.Left
	l.TextWrapped = true
	l.Text = text
	l.Parent = parent
	return l
end

local function actionButton(parent: Instance, text: string, color: Color3, pos: UDim2, onClick: () -> ()): TextButton
	local b = Instance.new("TextButton")
	b.Size = UDim2.fromOffset(120, 56) -- large enough for touch
	b.Position = pos
	b.AnchorPoint = Vector2.new(1, 1)
	b.BackgroundColor3 = color
	b.TextColor3 = Theme.Cocoa
	b.Font = Enum.Font.GothamBold
	b.TextSize = 20
	b.Text = text
	b.AutoButtonColor = true
	b.Parent = parent
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 18)
	corner.Parent = b
	local stroke = Instance.new("UIStroke")
	stroke.Color = Theme.Cocoa
	stroke.Thickness = 2.5
	stroke.Parent = b
	local grad = Instance.new("UIGradient")
	grad.Rotation = 90
	grad.Color = ColorSequence.new(color:Lerp(Color3.new(1, 1, 1), 0.4), color)
	grad.Parent = b
	b.Activated:Connect(onClick)
	return b
end

function HUD:Init() end

function HUD:Start()
	local gui = Instance.new("ScreenGui")
	gui.Name = "HUD"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = false
	gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")

	local top = card(gui, UDim2.fromOffset(300, 96), UDim2.new(0, 12, 0, 12))
	local stats = label(top, "Loading...", 22, UDim2.fromOffset(12, 6), UDim2.new(1, -24, 0, 28))
	local objective = label(top, "", 15, UDim2.fromOffset(12, 36), UDim2.new(1, -24, 0, 54))
	objective.Font = Enum.Font.Gotham
	objective.TextYAlignment = Enum.TextYAlignment.Top

	-- Next-goal panel: always shows the first unfinished business milestone.
	local goalCard = card(gui, UDim2.fromOffset(300, 78), UDim2.new(0, 12, 0, 116))
	local goalTitle = label(goalCard, "NEXT GOAL", 12, UDim2.fromOffset(12, 4), UDim2.new(1, -24, 0, 16))
	goalTitle.TextColor3 = Theme.Coral
	local goalText = label(goalCard, "", 15, UDim2.fromOffset(12, 20), UDim2.new(1, -24, 0, 22))
	local goalHint = label(goalCard, "", 13, UDim2.fromOffset(12, 42), UDim2.new(1, -24, 0, 34))
	goalHint.Font = Enum.Font.Gotham
	goalHint.TextYAlignment = Enum.TextYAlignment.Top

	-- Compact order tracker: the current order's state stays visible while the phone is closed.
	local trackCard = card(gui, UDim2.fromOffset(300, 48), UDim2.new(0, 12, 0, 202))
	local trackText = label(trackCard, "", 14, UDim2.fromOffset(12, 4), UDim2.new(1, -24, 0, 40))
	trackText.Font = Enum.Font.GothamBold
	trackCard.Visible = false

	-- Dev-only: wipes your save so the first-time flow can be replayed. The server refuses it outside Studio.
	if RunService:IsStudio() then
		local reset = Instance.new("TextButton")
		reset.Size = UDim2.fromOffset(150, 32)
		reset.Position = UDim2.new(0, 12, 1, -12)
		reset.AnchorPoint = Vector2.new(0, 1)
		reset.BackgroundColor3 = Theme.Blueberry
		reset.TextColor3 = Theme.Cocoa
		reset.Font = Enum.Font.GothamBold
		reset.TextSize = 13
		reset.Text = "Dev: reset my save"
		reset.Parent = gui
		Instance.new("UICorner").Parent = reset
		reset.Activated:Connect(function()
			Remotes.func("DevReset"):InvokeServer()
		end)
		local boost = reset:Clone()
		boost.Position = UDim2.new(0, 12, 1, -50)
		boost.Size = UDim2.fromOffset(190, 32)
		boost.BackgroundColor3 = Theme.Mint
		boost.Text = "Dev: unlock everything"
		boost.Parent = gui
		boost.Activated:Connect(function()
			Remotes.func("DevBoost"):InvokeServer()
		end)
	end

	actionButton(gui, "📱 Phone", Theme.Coral, UDim2.new(1, -12, 1, -12), function()
		UIBus.Toggle:Fire("Phone")
	end)
	actionButton(gui, "🔧 Gear", Theme.Butter, UDim2.new(1, -144, 1, -12), function()
		UIBus.Open:Fire("PhoneGear")
	end)
	actionButton(gui, "🍪 Bake", Theme.Mint, UDim2.new(1, -276, 1, -12), function()
		-- the server walks you to the kitchen counter if you are far away, then the kitchen opens
		local ok = Remotes.func("GoToKitchen"):InvokeServer()
		if ok then
			UIBus.Open:Fire("Bake")
		end
	end)

	local function refreshObjective()
		if HUD.state then
			objective.Text = objectiveFor(HUD.state, HUD.orders)
			local top: any = nil
			local rank = { Available = 1, Accepted = 2, ["In Production"] = 3, Ready = 4 }
			for _, o in HUD.orders do
				if not top or (rank[o.state] or 0) > (rank[top.state] or 0) then
					top = o
				end
			end
			trackCard.Visible = top ~= nil
			if top then
				trackText.Text = `ORDER: {top.customerName}, {top.count}x {top.recipeName}\n[{top.state}]`
			end
			goalCard.Visible = HUD.state.settings == nil or HUD.state.settings.guidance ~= false
			local goal = Milestones.next(HUD.state)
			if goal then
				goalText.Text = goal.title
				goalHint.Text = goal.hint
			else
				goalText.Text = "All starter goals complete!"
				goalHint.Text = "New goals unlock as the game grows."
			end
		end
	end

	local function apply(state: any)
		HUD.state = state
		stats.Text = `💰 ${math.floor(state.cash)}     ⭐ Lv {state.level}`
		refreshObjective()
		for _, fn in listeners do
			task.spawn(fn, state)
		end
	end

	local function applyOrders(list: any)
		HUD.orders = list
		refreshObjective()
		for _, fn in orderListeners do
			task.spawn(fn, list)
		end
	end

	Remotes.event("OrdersUpdated").OnClientEvent:Connect(applyOrders)
	Remotes.event("StateUpdated").OnClientEvent:Connect(apply)
	-- the first call can come back empty if the save is still loading, so keep asking until it arrives
	local function fetchOrders()
		local okOrders, list = pcall(function()
			return Remotes.func("GetOrders"):InvokeServer()
		end)
		if okOrders and list then
			applyOrders(list)
		end
	end
	task.spawn(function()
		local lastError = ""
		for attempt = 1, 40 do
			local ok, state = pcall(function()
				return Remotes.func("GetState"):InvokeServer()
			end)
			if ok and state then
				apply(state)
				fetchOrders()
				return
			end
			-- show what is going on instead of an endless "Loading..."
			lastError = if ok then "the server has no save for you yet" else tostring(state)
			stats.Text = `Connecting... ({attempt})`
			objective.Text = lastError
			task.wait(1)
		end
		stats.Text = "Could not load your save"
		objective.Text = `{lastError}. Rejoin the game.`
	end)
end

return HUD
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX61"><Properties><string name="Name">InteractionController</string><ProtectedString name="Source"><![CDATA[--!strict
-- Receives server-accepted station interactions and opens the matching panel.
-- The ProximityPrompt itself lives on the station and is handled by the server (InteractionService),
-- so the client can never open a station UI the server did not approve.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = require(ReplicatedStorage.Shared.Modules.Remotes)
local UIBus = require(script.Parent.UIBus)

local InteractionController = {}

function InteractionController:Init() end

function InteractionController:Start()
	Remotes.event("InteractionAccepted").OnClientEvent:Connect(function(panel: any)
		if type(panel) == "string" then
			UIBus.Open:Fire(panel)
		end
	end)
end

return InteractionController
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX62"><Properties><string name="Name">PhoneController</string><ProtectedString name="Source"><![CDATA[--!strict
-- Phone shell: one persistent button (or P) opens it; the home screen lists apps from Config/Apps and each app
-- draws itself into the content area. Apps live in the Apps folder and return { id, render(ctx) }.
local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local AppsConfig = require(ReplicatedStorage.Shared.Config.Apps)
local Remotes = require(ReplicatedStorage.Shared.Modules.Remotes)
local Theme = require(ReplicatedStorage.Shared.Config.Theme)
local UI = require(script.Parent.Parent.Modules.UI)
local HUD = require(script.Parent.HUDController)
local UIBus = require(script.Parent.UIBus)

local PhoneController = {}

type App = { id: string, render: (ctx: any) -> () }

function PhoneController:Init() end

function PhoneController:Start()
	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")

	-- load app modules
	local apps: { [string]: App } = {}
	local appsFolder = script.Parent.Parent:WaitForChild("Apps")
	for _, m in appsFolder:GetChildren() do
		if m:IsA("ModuleScript") then
			local ok, app = pcall(require, m)
			if ok and type(app) == "table" and AppsConfig.byId[app.id] then
				apps[app.id] = app
			else
				warn(`[Phone] could not load app {m.Name}: {app}`)
			end
		end
	end

	-- toasts live in their own always-on gui so they show while the phone is closed
	local toastGui = Instance.new("ScreenGui")
	toastGui.Name = "PhoneToasts"
	toastGui.ResetOnSpawn = false
	toastGui.Parent = playerGui
	local toast = Instance.new("TextLabel")
	toast.Size = UDim2.fromOffset(340, 0)
	toast.AutomaticSize = Enum.AutomaticSize.Y
	toast.Position = UDim2.new(1, -352, 0, 12)
	toast.BackgroundColor3 = Theme.Buttercream
	toast.TextColor3 = Theme.Cocoa
	toast.Font = Enum.Font.GothamBold
	toast.TextSize = 15
	toast.TextWrapped = true
	toast.Visible = false
	toast.Parent = toastGui
	UI.corner(toast)
	UI.stroke(toast)
	UI.padding(toast, 8)
	local toastId = 0
	local function say(text: string)
		toastId += 1
		local mine = toastId
		toast.Text = text
		toast.Visible = true
		task.delay(5, function()
			if toastId == mine then
				toast.Visible = false
			end
		end)
	end

	-- phone frame
	local gui = Instance.new("ScreenGui")
	gui.Name = "Phone"
	gui.ResetOnSpawn = false
	gui.Enabled = false
	gui.Parent = playerGui

	local frame = Instance.new("Frame")
	frame.AnchorPoint = Vector2.new(0.5, 0.5)
	frame.Position = UDim2.fromScale(0.5, 0.5)
	frame.Size = UDim2.fromScale(0.92, 0.88)
	frame.BackgroundColor3 = Theme.Buttercream
	frame.BorderSizePixel = 0
	frame.Parent = gui
	UI.corner(frame, 24)
	UI.stroke(frame, 5)
	UI.gradient(frame, Theme.Cream, Theme.Peach)
	local frameStroke = frame:FindFirstChildOfClass("UIStroke")
	if frameStroke then
		frameStroke.Color = Theme.Night
	end
	local limits = Instance.new("UISizeConstraint")
	limits.MinSize = Vector2.new(300, 360)
	limits.MaxSize = Vector2.new(430, 640)
	limits.Parent = frame

	local header = Instance.new("Frame")
	header.Size = UDim2.new(1, 0, 0, 52)
	header.BackgroundColor3 = Theme.Night
	header.BorderSizePixel = 0
	header.Parent = frame
	UI.corner(header, 20)
	UI.gradient(header, Theme.Cocoa, Theme.Night)

	local backBtn = Instance.new("TextButton")
	backBtn.Size = UDim2.fromOffset(44, 44)
	backBtn.Position = UDim2.fromOffset(4, 4)
	backBtn.BackgroundColor3 = Theme.Butter
	backBtn.TextColor3 = Theme.Cocoa
	backBtn.Font = Enum.Font.GothamBold
	backBtn.TextSize = 22
	backBtn.Text = "<"
	backBtn.Parent = header
	UI.corner(backBtn)

	local titleLabel = Instance.new("TextLabel")
	titleLabel.Size = UDim2.new(1, -150, 1, 0)
	titleLabel.Position = UDim2.fromOffset(52, 0)
	titleLabel.BackgroundTransparency = 1
	titleLabel.TextColor3 = Theme.Buttercream
	titleLabel.Font = Enum.Font.GothamBold
	titleLabel.TextSize = 20
	titleLabel.TextXAlignment = Enum.TextXAlignment.Left
	titleLabel.Text = "Phone"
	titleLabel.Parent = header

	local cashLabel = Instance.new("TextLabel")
	cashLabel.Size = UDim2.fromOffset(60, 44)
	cashLabel.Position = UDim2.new(1, -108, 0, 4)
	cashLabel.BackgroundTransparency = 1
	cashLabel.TextColor3 = Theme.Butter
	cashLabel.Font = Enum.Font.GothamBold
	cashLabel.TextSize = 16
	cashLabel.TextXAlignment = Enum.TextXAlignment.Right
	cashLabel.Parent = header

	local closeBtn = Instance.new("TextButton")
	closeBtn.Size = UDim2.fromOffset(44, 44)
	closeBtn.Position = UDim2.new(1, -48, 0, 4)
	closeBtn.BackgroundColor3 = Theme.Coral
	closeBtn.TextColor3 = Theme.Cocoa
	closeBtn.Font = Enum.Font.GothamBold
	closeBtn.TextSize = 20
	closeBtn.Text = "X"
	closeBtn.Parent = header
	UI.corner(closeBtn)

	local content = Instance.new("ScrollingFrame")
	content.Position = UDim2.fromOffset(0, 56)
	content.Size = UDim2.new(1, 0, 1, -56)
	content.BackgroundTransparency = 1
	content.BorderSizePixel = 0
	content.AutomaticCanvasSize = Enum.AutomaticSize.Y
	content.CanvasSize = UDim2.new()
	content.ScrollBarThickness = 6
	content.Parent = frame
	UI.padding(content, 8)
	UI.list(content, 6)

	local current: string? = nil -- open app id, nil = home screen
	local announced: { [string]: boolean } = {}

	local function unlocked(appId: string): boolean
		local state = HUD.state
		return state ~= nil and AppsConfig.byId[appId].unlock(state)
	end

	local function seen(appId: string): boolean
		local state = HUD.state
		return state ~= nil and state.settings ~= nil and state.settings.seenApps ~= nil and state.settings.seenApps[appId] == true
	end

	local render

	local function openApp(appId: string?)
		current = appId
		if appId and not seen(appId) then
			task.spawn(function()
				Remotes.func("SeenApp"):InvokeServer(appId)
			end)
		end
		render()
	end

	function render()
		UI.clear(content)
		local state = HUD.state
		UI.textScale = if state and state.settings and state.settings.textScale then state.settings.textScale else 1
		backBtn.Visible = current ~= nil
		cashLabel.Text = if state then UI.money(state.cash) else ""
		if not state then
			titleLabel.Text = "Phone"
			UI.label(content, "Loading...")
			return
		end
		if current and apps[current] and unlocked(current) then
			titleLabel.Text = AppsConfig.byId[current].title
			apps[current].render({
				content = content,
				state = state,
				orders = HUD.orders,
				say = say,
				back = function()
					openApp(nil)
				end,
				rerender = render,
			})
			return
		end
		current = nil
		backBtn.Visible = false
		local brand = if state.settings.brandName ~= "" then state.settings.brandName else "Phone"
		titleLabel.Text = brand
		local grid = Instance.new("Frame")
		grid.Size = UDim2.new(1, 0, 0, 0)
		grid.AutomaticSize = Enum.AutomaticSize.Y
		grid.BackgroundTransparency = 1
		grid.Parent = content
		local layout = Instance.new("UIGridLayout")
		layout.CellSize = UDim2.new(0.5, -6, 0, 104)
		layout.CellPadding = UDim2.fromOffset(8, 8)
		layout.SortOrder = Enum.SortOrder.LayoutOrder
		layout.Parent = grid
		for i, def in AppsConfig.list do
			local on = unlocked(def.id) and apps[def.id] ~= nil
			local b = Instance.new("TextButton")
			b.LayoutOrder = i
			b.BackgroundColor3 = if on then Theme[def.color] else Color3.fromRGB(205, 198, 184)
			b.Text = ""
			b.AutoButtonColor = on
			b.Parent = grid
			UI.corner(b, 18)
			UI.stroke(b, 2)
			UI.gradient(b)
			local icon = Instance.new("TextLabel")
			icon.BackgroundTransparency = 1
			icon.Size = UDim2.new(1, 0, 0, 46)
			icon.Position = UDim2.fromOffset(0, 8)
			icon.Font = Enum.Font.GothamBold
			icon.TextSize = 36
			icon.Text = if on then def.icon else "🔒"
			icon.TextTransparency = if on then 0 else 0.35
			icon.Parent = b
			local name = Instance.new("TextLabel")
			name.BackgroundTransparency = 1
			name.Size = UDim2.new(1, -8, 0, 30)
			name.Position = UDim2.new(0, 4, 1, -34)
			name.Font = Enum.Font.GothamBold
			name.TextSize = 14
			name.TextColor3 = Theme.Cocoa
			name.TextWrapped = true
			name.Text = def.title
			name.Parent = b
			if on and not seen(def.id) then
				local badge = UI.pill(b, "NEW")
				badge.Position = UDim2.new(1, -8, 0, 6)
				badge.AnchorPoint = Vector2.new(1, 0)
			end
			b.Activated:Connect(function()
				if on then
					openApp(def.id)
				else
					say(def.unlockHint)
				end
			end)
		end
		UI.label(content, "Tap an app to open it. New apps appear as your business grows.", { size = 13 })
	end

	backBtn.Activated:Connect(function()
		openApp(nil)
	end)
	closeBtn.Activated:Connect(function()
		gui.Enabled = false
	end)

	Remotes.event("Notify").OnClientEvent:Connect(function(msg)
		say(tostring(msg))
	end)

	local function onChange()
		-- announce newly unlocked apps once
		local state = HUD.state
		if state then
			local fresh = {}
			for _, def in AppsConfig.list do
				if def.unlock(state) and not seen(def.id) and not announced[def.id] and def.id ~= "crumbchat" and def.id ~= "pantrydash" and def.id ~= "settings" then
					announced[def.id] = true
					table.insert(fresh, def)
				end
			end
			if #fresh == 1 then
				say(`New app: {fresh[1].title}. {fresh[1].blurb}`)
			elseif #fresh > 1 then
				local names = {}
				for _, def in fresh do
					table.insert(names, def.title)
				end
				say(`New apps: {table.concat(names, ", ")}. Open your phone to explore.`)
			end
		end
		if gui.Enabled then
			render()
		end
	end
	HUD:OnOrders(onChange)
	HUD:OnState(onChange)

	-- keep delivery countdowns fresh while PantryDash is open
	task.spawn(function()
		while true do
			task.wait(1)
			if gui.Enabled and current == "pantrydash" and HUD.state and #HUD.state.deliveries > 0 then
				render()
			end
		end
	end)

	local function toggle()
		gui.Enabled = not gui.Enabled
		if gui.Enabled then
			render()
		end
	end

	UIBus.Toggle.Event:Connect(function(name)
		if name == "Phone" then
			toggle()
		end
	end)
	UIBus.Open.Event:Connect(function(panel)
		if panel == "PhonePantry" then
			gui.Enabled = true
			openApp("pantrydash")
		elseif panel == "PhoneGear" then
			gui.Enabled = true
			if unlocked("gearup") then
				openApp("gearup")
			else
				openApp(nil)
				say(AppsConfig.byId.gearup.unlockHint)
			end
		end
	end)

	ContextActionService:BindAction("OpenGear", function(_, inputState)
		if inputState == Enum.UserInputState.Begin then
			UIBus.Open:Fire("PhoneGear")
		end
		return Enum.ContextActionResult.Pass
	end, false, Enum.KeyCode.B)

	ContextActionService:BindAction("TogglePhone", function(_, inputState)
		if inputState == Enum.UserInputState.Begin then
			toggle()
		end
		return Enum.ContextActionResult.Pass
	end, false, Enum.KeyCode.P)
end

return PhoneController
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX63"><Properties><string name="Name">SoundController</string><ProtectedString name="Source"><![CDATA[--!strict
-- Sound effects. Uses Roblox's built-in sounds so nothing needs uploading; if a sound cannot load it is skipped, and
-- the volume comes from the player's saved setting (0 = silent).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")

local Remotes = require(ReplicatedStorage.Shared.Modules.Remotes)
local HUD = require(script.Parent.HUDController)

local SOUNDS = {
	notify = "rbxasset://sounds/electronicpingshort.wav",
	cash = "rbxasset://sounds/switch.wav",
}

local SoundController = {}

local function volume(): number
	local s = HUD.state
	return if s and s.settings and type(s.settings.sfx) == "number" then s.settings.sfx else 0.6
end

local function play(name: string)
	local v = volume()
	if v <= 0 or not SOUNDS[name] then
		return
	end
	pcall(function()
		local snd = Instance.new("Sound")
		snd.SoundId = SOUNDS[name]
		snd.Volume = v
		snd.Parent = SoundService
		snd.Ended:Once(function()
			snd:Destroy()
		end)
		snd:Play()
		task.delay(5, function()
			snd:Destroy()
		end)
	end)
end

function SoundController:Init() end

function SoundController:Start()
	Remotes.event("Notify").OnClientEvent:Connect(function()
		play("notify")
	end)
	local lastCash: number? = nil
	HUD:OnState(function()
		local s = HUD.state
		if s then
			if lastCash and s.cash > lastCash then
				play("cash")
			end
			lastCash = s.cash
		end
	end)
end

return SoundController
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX64"><Properties><string name="Name">UIBus</string><ProtectedString name="Source"><![CDATA[--!strict
-- Tiny in-client event hub so controllers never require each other.
--   UIBus.Toggle:Fire("Phone")           toggles a panel (HUD button, keyboard shortcut)
--   UIBus.Open:Fire("Bake" | "PhonePantry" | "PhoneGear")  opens a panel (server-accepted interaction, deep links)
local UIBus = {
	Toggle = Instance.new("BindableEvent"),
	Open = Instance.new("BindableEvent"),
}

return UIBus
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX65"><Properties><string name="Name">WorldFxController</string><ProtectedString name="Source"><![CDATA[--!strict
-- Client-side visuals that follow your save: the buildings you own appear on their plots (only you see yours), shop signs
-- show your bakery name, and a short welcome card explains where the new features are.
local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Properties = require(ReplicatedStorage.Shared.Config.Properties)
local Theme = require(ReplicatedStorage.Shared.Config.Theme)
local UI = require(script.Parent.Parent.Modules.UI)
local HUD = require(script.Parent.HUDController)

local WorldFxController = {}

local folder: Folder? = nil
local built: { [string]: Model } = {}

local function c(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end

local function part(model: Model, name: string, base: CFrame, offset: Vector3, size: Vector3, color: Color3, material: Enum.Material, transparency: number?): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.Size = size
	p.CFrame = base * CFrame.new(offset)
	p.Color = color
	p.Material = material
	p.Transparency = transparency or 0
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = model
	return p
end

local function signFace(parent: Part, face: Enum.NormalId, text: string, textColor: Color3)
	local gui = Instance.new("SurfaceGui")
	gui.Name = "SignGui"
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 40
	gui.Parent = parent
	local label = Instance.new("TextLabel")
	label.Name = "SignText"
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBlack
	label.TextScaled = true
	label.TextColor3 = textColor
	label.Text = text
	label.Parent = gui
end

local function glow(p: Part, color: Color3)
	local l = Instance.new("PointLight")
	l.Color = color
	l.Range = 20
	l.Brightness = 1.4
	l.Parent = p
end

local BUILDERS: { [string]: (model: Model, base: CFrame, name: string) -> () } = {
	food_truck = function(m, base, name)
		part(m, "Body", base, Vector3.new(0, 5.2, 0), Vector3.new(14, 7, 7), c(255, 196, 60), Enum.Material.SmoothPlastic)
		part(m, "Cab", base, Vector3.new(8.6, 4, 0), Vector3.new(4, 5, 6.6), c(240, 150, 40), Enum.Material.SmoothPlastic)
		part(m, "Window", base, Vector3.new(0, 5.6, 3.55), Vector3.new(7, 3, 0.2), c(40, 60, 80), Enum.Material.Glass, 0.2)
		part(m, "Awning", base, Vector3.new(0, 7.6, 4.8), Vector3.new(8.5, 0.3, 3.2), c(230, 70, 80), Enum.Material.Fabric)
		for _, x in { -4.5, 4.5, 8.6 } do
			for _, z in { -3.4, 3.4 } do
				local w = part(m, "Wheel", base, Vector3.new(x, 1.3, z), Vector3.new(1.1, 2.6, 2.6), c(30, 30, 34), Enum.Material.SmoothPlastic)
				w.Shape = Enum.PartType.Cylinder
				w.CFrame = base * CFrame.new(x, 1.3, z) * CFrame.Angles(0, 0, math.rad(90))
			end
		end
		local sign = part(m, "Sign", base, Vector3.new(0, 9.6, 0), Vector3.new(10, 2.2, 0.5), c(40, 28, 24), Enum.Material.SmoothPlastic)
		signFace(sign, Enum.NormalId.Front, name, c(255, 230, 150))
		glow(sign, c(255, 210, 140))
	end,
	garage = function(m, base, name)
		part(m, "Walls", base, Vector3.new(0, 6, 0), Vector3.new(22, 12, 14), c(170, 176, 190), Enum.Material.Concrete)
		part(m, "Roof", base, Vector3.new(0, 12.4, 0), Vector3.new(23.5, 1, 15.5), c(90, 94, 110), Enum.Material.Metal)
		part(m, "RollDoor", base, Vector3.new(-3, 4.5, 7.1), Vector3.new(10, 8.6, 0.3), c(230, 232, 240), Enum.Material.Metal)
		part(m, "Window", base, Vector3.new(7, 6.5, 7.1), Vector3.new(5, 3.5, 0.3), c(110, 160, 200), Enum.Material.Glass, 0.25)
		local sign = part(m, "Sign", base, Vector3.new(0, 10.3, 7.3), Vector3.new(16, 2.2, 0.4), c(60, 62, 80), Enum.Material.SmoothPlastic)
		signFace(sign, Enum.NormalId.Front, name, c(255, 220, 130))
		glow(sign, c(255, 220, 160))
	end,
	corner_shop = function(m, base, name)
		part(m, "Walls", base, Vector3.new(0, 8, 0), Vector3.new(24, 16, 16), c(255, 214, 224), Enum.Material.SmoothPlastic)
		part(m, "Roof", base, Vector3.new(0, 16.6, 0), Vector3.new(26, 1.4, 18), c(176, 96, 84), Enum.Material.Slate)
		part(m, "Awning", base, Vector3.new(0, 11.5, 9.4), Vector3.new(22, 0.5, 4.4), c(230, 70, 90), Enum.Material.Fabric)
		part(m, "WindowL", base, Vector3.new(-7, 6, 8.1), Vector3.new(7, 7, 0.3), c(255, 244, 214), Enum.Material.Glass, 0.3)
		part(m, "Door", base, Vector3.new(6, 4.5, 8.1), Vector3.new(5, 9, 0.3), c(120, 80, 56), Enum.Material.Wood)
		local cookie = part(m, "RoofCookie", base, Vector3.new(0, 20.5, 0), Vector3.new(6, 6, 1.2), c(214, 160, 90), Enum.Material.SmoothPlastic)
		cookie.Shape = Enum.PartType.Cylinder
		cookie.CFrame = base * CFrame.new(0, 20.5, 0) * CFrame.Angles(0, math.rad(90), 0)
		local sign = part(m, "Sign", base, Vector3.new(0, 13.4, 8.2), Vector3.new(18, 2.6, 0.4), c(60, 36, 32), Enum.Material.SmoothPlastic)
		signFace(sign, Enum.NormalId.Front, name, c(255, 226, 150))
		glow(sign, c(255, 200, 150))
	end,
}

local function signText(id: string): string
	local s = HUD.state
	local brand = if s and s.settings and s.settings.brandName ~= "" then s.settings.brandName else nil
	return brand or Properties[id].name
end

local function refresh()
	local state = HUD.state
	if not state or not folder then
		return
	end
	for id, def in Properties do
		local owned = state.properties[id] == true and def.plotName ~= nil
		local existing = built[id]
		if owned and not existing and BUILDERS[id] then
			for _, inst in CollectionService:GetTagged("PropertyPlot") do
				if inst:IsA("BasePart") and inst.Name == def.plotName then
					local model = Instance.new("Model")
					model.Name = def.name .. " (yours)"
					-- sit on top of the flat plot marker, facing the same way as the marker
					local base = CFrame.new(inst.Position.X, inst.Position.Y + inst.Size.Y / 2, inst.Position.Z)
					BUILDERS[id](model, base, signText(id))
					model.Parent = folder
					built[id] = model
					break
				end
			end
		elseif existing then
			for _, d in existing:GetDescendants() do
				if d:IsA("TextLabel") and d.Name == "SignText" then
					d.Text = signText(id)
				end
			end
		end
	end
end

local function welcome()
	local gui = Instance.new("ScreenGui")
	gui.Name = "Welcome"
	gui.ResetOnSpawn = false
	gui.DisplayOrder = 20
	gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")

	local frame = Instance.new("Frame")
	frame.AnchorPoint = Vector2.new(0.5, 0.5)
	frame.Position = UDim2.fromScale(0.5, 0.5)
	frame.Size = UDim2.fromOffset(420, 0)
	frame.AutomaticSize = Enum.AutomaticSize.Y
	frame.BackgroundColor3 = Theme.Buttercream
	frame.Parent = gui
	UI.corner(frame, 22)
	UI.stroke(frame, 4)
	UI.gradient(frame, Theme.Cream, Theme.Peach)
	UI.padding(frame, 16)
	UI.list(frame, 8)
	local limit = Instance.new("UISizeConstraint")
	limit.MaxSize = Vector2.new(460, 9999)
	limit.Parent = frame

	UI.label(frame, "🍪 Cookie Empire", { bold = true, size = 28, align = Enum.TextXAlignment.Center })
	UI.label(frame, "Bake, deliver, grow.", { size = 16, align = Enum.TextXAlignment.Center })
	UI.label(frame, "📱 Your phone (P) holds everything: orders, ingredients, recipes and more apps that unlock as you grow.", { size = 15 })
	UI.label(frame, "🏠 Buy a Food Truck, Garage or Shop and it appears on its lot with your bakery name on the sign.", { size = 15 })
	UI.label(frame, "🚗 Cars, 🧑‍🍳 bakers, 📈 market events and contracts unlock at higher levels.", { size = 15 })
	UI.button(frame, "Let's bake!", Theme.Butter, function()
		gui:Destroy()
	end)
end

function WorldFxController:Init() end

function WorldFxController:Start()
	local f = Instance.new("Folder")
	f.Name = "MyBuildings" -- client-only: other players never see your buildings
	f.Parent = workspace
	folder = f
	HUD:OnState(refresh)
	refresh()
	task.delay(1.5, welcome)
end

return WorldFxController
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX68"><Properties><string name="Name">Modules</string></Properties><Item class="ModuleScript" referent="RBX67"><Properties><string name="Name">UI</string><ProtectedString name="Source"><![CDATA[--!strict
-- Small UI kit shared by the phone and the panels. Everything auto-sizes to its text so nothing gets clipped,
-- every button is at least 44 px tall for touch, and colors come only from Theme.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Theme = require(ReplicatedStorage.Shared.Config.Theme)

local UI = {}

UI.Theme = Theme
UI.MIN_TOUCH = 44
UI.textScale = 1 -- accessibility: set from the player's saved settings before each render

function UI.corner(inst: Instance, radius: number?)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, radius or 10)
	c.Parent = inst
end

function UI.stroke(inst: Instance, thickness: number?)
	local s = Instance.new("UIStroke")
	s.Color = Theme.Cocoa
	s.Thickness = thickness or 2
	s.Transparency = 0.15
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Parent = inst
end

-- A soft vertical gradient from `top` to `bottom` (defaults to a lighter and a slightly deeper shade of the fill).
function UI.gradient(inst: GuiObject, top: Color3?, bottom: Color3?)
	local base = inst.BackgroundColor3
	local g = Instance.new("UIGradient")
	g.Rotation = 90
	g.Color = ColorSequence.new(top or base:Lerp(Color3.new(1, 1, 1), 0.35), bottom or base:Lerp(Color3.new(0, 0, 0), 0.08))
	g.Parent = inst
end

-- Small rounded badge, e.g. "NEW".
function UI.pill(parent: Instance, text: string, color: Color3?): TextLabel
	local l = Instance.new("TextLabel")
	l.AutomaticSize = Enum.AutomaticSize.XY
	l.BackgroundColor3 = color or Theme.Cherry
	l.TextColor3 = Theme.Cream
	l.Font = Enum.Font.GothamBlack
	l.TextSize = 11
	l.Text = " " .. text .. " "
	l.Parent = parent
	UI.corner(l, 8)
	return l
end

function UI.padding(inst: Instance, px: number)
	local p = Instance.new("UIPadding")
	p.PaddingLeft = UDim.new(0, px)
	p.PaddingRight = UDim.new(0, px)
	p.PaddingTop = UDim.new(0, px)
	p.PaddingBottom = UDim.new(0, px)
	p.Parent = inst
end

function UI.list(inst: Instance, gap: number?): UIListLayout
	local l = Instance.new("UIListLayout")
	l.Padding = UDim.new(0, gap or 6)
	l.SortOrder = Enum.SortOrder.LayoutOrder
	l.Parent = inst
	return l
end

-- Destroys everything a screen added (keeps layouts, padding and decoration).
function UI.clear(inst: Instance)
	for _, c in inst:GetChildren() do
		if c:IsA("GuiObject") then
			c:Destroy()
		end
	end
end

export type LabelOpts = { size: number?, bold: boolean?, color: Color3?, align: Enum.TextXAlignment?, order: number? }

function UI.label(parent: Instance, text: string, opts: LabelOpts?): TextLabel
	local o: LabelOpts = opts or {}
	local l = Instance.new("TextLabel")
	l.Size = UDim2.new(1, 0, 0, 0)
	l.AutomaticSize = Enum.AutomaticSize.Y
	l.BackgroundTransparency = 1
	l.TextColor3 = o.color or Theme.Cocoa
	l.Font = if o.bold then Enum.Font.GothamBold else Enum.Font.Gotham
	l.TextSize = math.floor((o.size or 15) * UI.textScale + 0.5)
	l.TextWrapped = true
	l.TextXAlignment = o.align or Enum.TextXAlignment.Left
	l.TextYAlignment = Enum.TextYAlignment.Top
	l.Text = text
	if o.order then
		l.LayoutOrder = o.order
	end
	l.Parent = parent
	return l
end

function UI.button(parent: Instance, text: string, color: Color3?, onClick: (() -> ())?): TextButton
	local b = Instance.new("TextButton")
	b.Size = UDim2.new(1, 0, 0, math.floor(UI.MIN_TOUCH * UI.textScale))
	b.AutomaticSize = Enum.AutomaticSize.Y
	b.BackgroundColor3 = color or Theme.Coral
	b.TextColor3 = Theme.Cocoa
	b.Font = Enum.Font.GothamBold
	b.TextSize = math.floor(16 * UI.textScale + 0.5)
	b.TextWrapped = true
	b.Text = text
	b.AutoButtonColor = true
	b.Parent = parent
	UI.corner(b, 12)
	UI.stroke(b, 1.5)
	UI.gradient(b)
	if onClick then
		b.Activated:Connect(onClick)
	end
	return b
end

-- A rounded, outlined box that stacks its children vertically and grows with them.
function UI.card(parent: Instance, color: Color3?): Frame
	local f = Instance.new("Frame")
	f.Size = UDim2.new(1, 0, 0, 0)
	f.AutomaticSize = Enum.AutomaticSize.Y
	f.BackgroundColor3 = color or Theme.Buttercream
	f.BorderSizePixel = 0
	f.Parent = parent
	UI.corner(f, 14)
	UI.stroke(f, 1.5)
	UI.gradient(f, (color or Theme.Buttercream):Lerp(Theme.Cream, 0.6), color or Theme.Buttercream)
	UI.padding(f, 10)
	UI.list(f, 5)
	return f
end

-- A horizontal row (for -/+ steppers and similar).
function UI.row(parent: Instance, height: number?): Frame
	local f = Instance.new("Frame")
	f.Size = UDim2.new(1, 0, 0, height or UI.MIN_TOUCH)
	f.BackgroundTransparency = 1
	f.Parent = parent
	local l = Instance.new("UIListLayout")
	l.FillDirection = Enum.FillDirection.Horizontal
	l.Padding = UDim.new(0, 6)
	l.VerticalAlignment = Enum.VerticalAlignment.Center
	l.SortOrder = Enum.SortOrder.LayoutOrder
	l.Parent = f
	return f
end

function UI.money(n: number): string
	return "$" .. tostring(math.floor(n))
end

return UI
]]></ProtectedString></Properties></Item></Item></Item></Item></Item></roblox>