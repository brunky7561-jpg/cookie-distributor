X>2.000</X><Y>200.000</Y><Z>1200.000</Z></Vector3><Color3uint8 name="Color3uint8">4294967295</Color3uint8><token name="Material">256</token><token name="TopSurface">0</token><token name="BottomSurface">0</token><token name="shape">1</token><float name="Transparency">1</float></Properties></Item><Item class="Part" referent="RBX102677"><Properties><string name="Name">Wall</string><bool name="Anchored">true</bool><CoordinateFrame name="CFrame"><X>-600.000</X><Y>100.000</Y><Z>0.000</Z><R00>1.00000</R00><R01>0.00000</R01><R02>0.00000</R02><R10>0.00000</R10><R11>1.00000</R11><R12>0.00000</R12><R20>0.00000</R20><R21>0.00000</R21><R22>1.00000</R22></CoordinateFrame><Vector3 name="size"><X>2.000</X><Y>200.000</Y><Z>1200.000</Z></Vector3><Color3uint8 name="Color3uint8">4294967295</Color3uint8><token name="Material">256</token><token name="TopSurface">0</token><token name="BottomSurface">0</token><token name="shape">1</token><float name="Transparency">1</float></Properties></Item><Item class="Part" referent="RBX102678"><Properties><string name="Name">Wall</string><bool name="Anchored">true</bool><CoordinateFrame name="CFrame"><X>0.000</X><Y>100.000</Y><Z>600.000</Z><R00>1.00000</R00><R01>0.00000</R01><R02>0.00000</R02><R10>0.00000</R10><R11>1.00000</R11><R12>0.00000</R12><R20>0.00000</R20><R21>0.00000</R21><R22>1.00000</R22></CoordinateFrame><Vector3 name="size"><X>1200.000</X><Y>200.000</Y><Z>2.000</Z></Vector3><Color3uint8 name="Color3uint8">4294967295</Color3uint8><token name="Material">256</token><token name="TopSurface">0</token><token name="BottomSurface">0</token><token name="shape">1</token><float name="Transparency">1</float></Properties></Item><Item class="Part" referent="RBX102679"><Properties><string name="Name">Wall</string><bool name="Anchored">true</bool><CoordinateFrame name="CFrame"><X>0.000</X><Y>100.000</Y><Z>-600.000</Z><R00>1.00000</R00><R01>0.00000</R01><R02>0.00000</R02><R10>0.00000</R10><R11>1.00000</R11><R12>0.00000</R12><R20>0.00000</R20><R21>0.00000</R21><R22>1.00000</R22></CoordinateFrame><Vector3 name="size"><X>1200.000</X><Y>200.000</Y><Z>2.000</Z></Vector3><Color3uint8 name="Color3uint8">4294967295</Color3uint8><token name="Material">256</token><token name="TopSurface">0</token><token name="BottomSurface">0</token><token name="shape">1</token><float name="Transparency">1</float></Properties></Item></Item></Item><Item class="ReplicatedStorage" referent="RBX71"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="Folder" referent="RBX24"><Properties><string name="Name">Shared</string></Properties><Item class="Folder" referent="RBX15"><Properties><string name="Name">Config</string></Properties><Item class="ModuleScript" referent="RBX1"><Properties><string name="Name">Apps</string><ProtectedString name="Source"><![CDATA[--!strict
-- Phone apps: which exist, what they do, and when they unlock. The client builds the home screen from this and the
-- server uses the same list to validate app ids. Apps unlock gradually; new ones announce themselves once.
export type AppDef = {
	id: string,
	icon: string,
	title: string,
	blurb: string, -- one-line explanation shown when the app unlocks
	color: string, -- Theme token name
	unlockHint: string,
	unlock: (data: any) -> boolean,
}

local Apps = {}

Apps.list = {
	{
		id = "crumbchat",
		icon = "💬",
		title = "CrumbChat",
		blurb = "Customer requests: accept orders, ask questions and track delivery.",
		color = "Coral",
		unlockHint = "",
		unlock = function(_data)
			return true
		end,
	},
	{
		id = "pantrydash",
		icon = "🛒",
		title = "PantryDash",
		blurb = "Order ingredients and have them delivered to your property.",
		color = "Butter",
		unlockHint = "",
		unlock = function(_data)
			return true
		end,
	},
	{
		id = "ledger",
		icon = "📒",
		title = "Ledger",
		blurb = "See income, costs and profit.",
		color = "Mint",
		unlockHint = "Deliver your first order to unlock the Ledger.",
		unlock = function(data)
			return data.milestones.firstOrderDone == true
		end,
	},
	{
		id = "recipebook",
		icon = "📖",
		title = "Recipe Book",
		blurb = "Your recipes, their costs and your best bakes. Experiment at the oven to discover more.",
		color = "Blueberry",
		unlockHint = "Deliver your first order to unlock the Recipe Book.",
		unlock = function(data)
			return data.milestones.firstOrderDone == true
		end,
	},
	{
		id = "gearup",
		icon = "🔧",
		title = "GearUp",
		blurb = "Buy better ovens, mixers and racks.",
		color = "Butter",
		unlockHint = "GearUp is always available.",
		unlock = function()
			return true
		end,
	},
	{
		id = "propertydesk",
		icon = "🏠",
		title = "Property Desk",
		blurb = "Buy a food truck or shop, then sell to walk-in customers from a display case.",
		color = "Mint",
		unlockHint = "Reach level 3 to unlock the Property Desk.",
		unlock = function(data)
			return data.level >= 3 or data.milestones.firstOrderDone == true and data.cash >= 1500
		end,
	},
	{
		id = "staffboard",
		icon = "🧑‍🍳",
		title = "Staff Board",
		blurb = "Hire bakers to bake your recipes while you handle orders.",
		color = "Blueberry",
		unlockHint = "Buy a Food Truck or bigger to get a second oven and unlock the Staff Board.",
		unlock = function(data)
			for id in data.properties do
				if id ~= "apartment" then
					return true
				end
			end
			return false
		end,
	},
	{
		id = "wheelhouse",
		icon = "🚗",
		title = "Wheelhouse",
		blurb = "Buy a car or van: faster ingredient deliveries and a way to cruise the city.",
		color = "Coral",
		unlockHint = "Reach level 4 to unlock the Wheelhouse.",
		unlock = function(data)
			return data.level >= 4
		end,
	},
	{
		id = "marketpulse",
		icon = "📈",
		title = "Market Pulse",
		blurb = "Daily market events, rival contracts and the leaderboard.",
		color = "Blueberry",
		unlockHint = "Reach level 2 to unlock Market Pulse.",
		unlock = function(data)
			return data.level >= 2 and data.milestones.firstOrderDone == true
		end,
	},
	{
		id = "brandstudio",
		icon = "🎨",
		title = "Brand Studio",
		blurb = "Name your bakery and pick its color.",
		color = "Coral",
		unlockHint = "Reach level 3 to unlock Brand Studio.",
		unlock = function(data)
			return data.level >= 3
		end,
	},
	{
		id = "settings",
		icon = "⚙️",
		title = "Settings",
		blurb = "Text size, sound and hints.",
		color = "Buttercream",
		unlockHint = "",
		unlock = function(_data)
			return true
		end,
	},
} :: { AppDef }

Apps.byId = {} :: { [string]: AppDef }
for _, app in Apps.list do
	Apps.byId[app.id] = app
end

return Apps
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX2"><Properties><string name="Name">Baking</string><ProtectedString name="Source"><![CDATA[--!strict
-- Timings for the baking station, in seconds. Shared so the client can draw bars that match the server's rules.
return {
	MIX_MIN = 3, -- stirring must last at least this long before the dough counts as mixed
	PORTION_IDEAL = 3, -- stop the portion bar here for the most even cookies
	BAKE_IDEAL = 6, -- pull the tray here for a perfect bake
	COOL_TIME = 4, -- tray must rest this long before packaging
	BAR_FACTOR = 2, -- a timing bar fills over IDEAL * BAR_FACTOR seconds
	ZONE_HALF = 0.12, -- green zone is +/- this fraction of IDEAL around the ideal moment
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX3"><Properties><string name="Name">Brand</string><ProtectedString name="Source"><![CDATA[--!strict
-- Settings choices and the bakery brand. Both are validated on the server against these lists.
local Brand = {}

Brand.TEXT_SCALES = { 1, 1.25, 1.5 }
Brand.COLORS = {
	{ name = "Cocoa", rgb = { 76, 48, 40 } },
	{ name = "Coral", rgb = { 238, 120, 109 } },
	{ name = "Mint", rgb = { 142, 200, 174 } },
	{ name = "Blueberry", rgb = { 138, 158, 221 } },
	{ name = "Butter", rgb = { 246, 215, 122 } },
} :: { { name: string, rgb: { number } } }
Brand.NAME_MIN = 3
Brand.NAME_MAX = 20

-- Letters, digits and single spaces only. Returns the cleaned name or nil plus a reason.
function Brand.cleanName(raw: any): (string?, string?)
	if type(raw) ~= "string" then
		return nil, "type a name"
	end
	local name = string.gsub(string.match(raw, "^%s*(.-)%s*$") :: string, "%s+", " ")
	if #name < Brand.NAME_MIN or #name > Brand.NAME_MAX then
		return nil, `Use {Brand.NAME_MIN} to {Brand.NAME_MAX} characters.`
	end
	if string.find(name, "[^%w ]") then
		return nil, "Use only letters, numbers and spaces."
	end
	return name, nil
end

return Brand
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX4"><Properties><string name="Name">Customers</string><ProtectedString name="Source"><![CDATA[--!strict
local Types = require(script.Parent.Parent.Modules.Types)

local Customers: { Types.CustomerTemplate } = {
	{ id = "parkway", name = "Mrs. Park", personality = "Neighbor", loves = { "chocolate" }, hates = {}, appealMin = 0, appealMax = 60, budget = 45 },
	{ id = "zed", name = "Zed", personality = "Trendsetter", loves = { "energy", "salty" }, hates = {}, appealMin = 10, appealMax = 70, budget = 50 },
	{ id = "maya", name = "Maya", personality = "Foodie", loves = { "chocolate", "salty" }, hates = { "rare" }, appealMin = 15, appealMax = 40, budget = 55 },
	{ id = "leo", name = "Leo", personality = "SweetTooth", loves = { "sweet" }, hates = { "salty" }, appealMin = 30, appealMax = 70, budget = 45 },
	{ id = "dot", name = "Dot", personality = "BargainHunter", loves = { "base" }, hates = { "rare" }, appealMin = 0, appealMax = 30, budget = 30 },
	{ id = "hana", name = "Hana", personality = "HealthNut", loves = { "sweet" }, hates = { "intense" }, appealMin = 0, appealMax = 20, budget = 40 },
}

return Customers
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX5"><Properties><string name="Name">Dialogue</string><ProtectedString name="Source"><![CDATA[--!strict
-- Curated phone dialogue. Players only ever choose from these preset questions; they never type to NPCs,
-- so nothing goes around Roblox chat filtering.
local Dialogue = {}

Dialogue.questions = {
	{ id = "flavor", label = "What do you like?" },
	{ id = "deadline", label = "When do you need it?" },
	{ id = "where", label = "Where should I deliver?" },
	{ id = "budget", label = "What can you pay?" },
} :: { { id: string, label: string } }

Dialogue.tagWords = {
	chocolate = "chocolate",
	salty = "a pinch of salt",
	sweet = "something nice and sweet",
	base = "simple classic cookies",
	rare = "fancy, special ingredients",
} :: { [string]: string }

return Dialogue
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX6"><Properties><string name="Name">Equipment</string><ProtectedString name="Source"><![CDATA[--!strict
-- Equipment the player can own. Within a category the highest tier owned is the one that counts.
-- Effects are absolute values; Equipment.effective merges the best item per category over the defaults.
export type EquipmentDef = {
	id: string,
	name: string,
	category: string,
	tier: number,
	price: number, -- 0 = starter equipment, never sold
	requiresMilestone: string?,
	description: string,
	effects: { [string]: number },
}

local Equipment = {}

Equipment.defaults = {
	bakeSlack = 0, -- seconds around the ideal oven moment that still score 100%
	mixTaps = 8, -- stirs needed to finish mixing
	mixMin = 3, -- minimum seconds of mixing the server enforces
	coolTime = 4, -- seconds the tray must rest
	maxBatchMult = 1, -- 2 = can bake double batches (12 cookies in the Large box)
} :: { [string]: number }

Equipment.starter = { "basic_oven", "mixing_bowl", "cooling_rack" }

Equipment.catalog = {
	basic_oven = {
		id = "basic_oven",
		name = "Basic Oven",
		category = "Baking",
		tier = 1,
		price = 0,
		description = "A small oven. You have to watch it closely.",
		effects = {},
	},
	convection_oven = {
		id = "convection_oven",
		name = "Convection Oven",
		category = "Baking",
		tier = 2,
		price = 150,
		requiresMilestone = "firstOrderDone",
		description = "Even heat gives you a wider window to pull the tray: forgives about half a second either way.",
		effects = { bakeSlack = 0.6 },
	},
	stand_mixer = {
		id = "stand_mixer",
		name = "Stand Mixer",
		category = "Mixing",
		tier = 2,
		price = 220,
		requiresMilestone = "firstOrderDone",
		description = "Mixes in half the taps and lets you bake double batches (12 cookies, Large box).",
		effects = { mixTaps = 4, mixMin = 1.5, maxBatchMult = 2 },
	},
	fan_rack = {
		id = "fan_rack",
		name = "Fan Cooling Rack",
		category = "Cooling",
		tier = 2,
		price = 120,
		requiresMilestone = "firstOrderDone",
		description = "Cools a tray in 2 seconds instead of 4, so you can keep a rhythm going.",
		effects = { coolTime = 2 },
	},
	mixing_bowl = {
		id = "mixing_bowl",
		name = "Mixing Bowl",
		category = "Mixing",
		tier = 1,
		price = 0,
		description = "A good old hand bowl.",
		effects = {},
	},
	cooling_rack = {
		id = "cooling_rack",
		name = "Cooling Rack",
		category = "Cooling",
		tier = 1,
		price = 0,
		description = "A simple wire rack.",
		effects = {},
	},
} :: { [string]: EquipmentDef }

-- owned: { [equipmentId]: true }
function Equipment.effective(owned: { [string]: boolean }): { [string]: number }
	local best: { [string]: EquipmentDef } = {}
	for id in owned do
		local def = Equipment.catalog[id]
		if def and (not best[def.category] or def.tier > best[def.category].tier) then
			best[def.category] = def
		end
	end
	local out: { [string]: number } = table.clone(Equipment.defaults)
	for _, def in best do
		for k, v in def.effects do
			out[k] = v
		end
	end
	return out
end

return Equipment
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX7"><Properties><string name="Name">Ingredients</string><ProtectedString name="Source"><![CDATA[--!strict
local Types = require(script.Parent.Parent.Modules.Types)

local Ingredients: { [string]: Types.Ingredient } = {
	flour = { id = "flour", name = "Flour", category = "Base", cost = 1, appeal = 0, tags = { "base" }, sideEffects = {} },
	butter = { id = "butter", name = "Butter", category = "Fat", cost = 2, appeal = 1, tags = { "fat" }, sideEffects = {} },
	white_sugar = { id = "white_sugar", name = "White Sugar", category = "Sweetener", cost = 1, appeal = 2, tags = { "sweet" }, sideEffects = {} },
	brown_sugar = { id = "brown_sugar", name = "Brown Sugar", category = "Sweetener", cost = 2, appeal = 4, tags = { "sweet" }, sideEffects = {} },
	chocolate_chips = { id = "chocolate_chips", name = "Chocolate Chips", category = "Add-in", cost = 3, appeal = 6, tags = { "chocolate" }, sideEffects = {} },
	sea_salt = { id = "sea_salt", name = "Sea Salt", category = "Booster", cost = 1, appeal = 4, tags = { "salty" }, sideEffects = {} },
	caramel = { id = "caramel", name = "Caramel", category = "Sweetener", cost = 4, appeal = 8, tags = { "sweet" }, sideEffects = { "Crash" } },
	espresso_powder = { id = "espresso_powder", name = "Espresso Powder", category = "Booster", cost = 5, appeal = 10, tags = { "energy" }, sideEffects = { "Energized" } },
	golden_honey = { id = "golden_honey", name = "Golden Honey", category = "Rare", cost = 25, appeal = 30, tags = { "sweet", "rare" }, sideEffects = { "Cozy" } },
	moon_sugar = { id = "moon_sugar", name = "Moon Sugar", category = "Rare", cost = 40, appeal = 45, tags = { "rare", "intense" }, sideEffects = { "Sugar Rush" } },
}

return Ingredients
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX8"><Properties><string name="Name">Market</string><ProtectedString name="Source"><![CDATA[--!strict
-- The city market: a rotating event that changes what customers pay, rival bakeries that compete for contracts, and the
-- contract rules. The event is a pure function of the clock, so every server and every player sees the same one.
local Market = {}

Market.EVENT_PERIOD = 900 -- seconds each event lasts

Market.events = {
	{ id = "choc_craze", name = "Chocolate Craze", desc = "Chocolate cookies pay 25% more.", tag = "chocolate", mult = 1.25 },
	{ id = "salty_week", name = "Salty-Sweet Week", desc = "Salty cookies pay 25% more.", tag = "salty", mult = 1.25 },
	{ id = "sweet_fest", name = "Sugar Festival", desc = "Sweet cookies pay 20% more.", tag = "sweet", mult = 1.2 },
	{ id = "quiet_day", name = "Quiet Day", desc = "Steady business. Normal prices.", tag = "", mult = 1 },
} :: { { id: string, name: string, desc: string, tag: string, mult: number } }

Market.rivals = {
	{ id = "sugar_rush", name = "Sugar Rush Bakery", blurb = "Loud, cheap and everywhere." },
	{ id = "golden_whisk", name = "The Golden Whisk", blurb = "Fancy and slow. Loves a big contract." },
	{ id = "crumb_co", name = "Crumb & Co.", blurb = "The old family shop on Main Street." },
} :: { { id: string, name: string, blurb: string } }

Market.CONTRACT_COUNT = 12
Market.CONTRACT_MIN_SCORE = 65
Market.CONTRACT_LIFETIME = 1200 -- seconds
Market.CONTRACT_COOLDOWN = 120
Market.CONTRACT_REPUTATION = 5
Market.CONTRACT_PREMIUM = 1.5 -- over the normal per-order offer

function Market.currentEvent(now: number): any
	local index = math.floor(now / Market.EVENT_PERIOD) % #Market.events + 1
	return Market.events[index]
end

function Market.secondsLeft(now: number): number
	return Market.EVENT_PERIOD - now % Market.EVENT_PERIOD
end

-- Payout multiplier for a batch with these tags under an event.
function Market.eventMult(event: any, tags: { string }?): number
	if event.tag ~= "" and tags and table.find(tags, event.tag) then
		return event.mult
	end
	return 1
end

return Market
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX9"><Properties><string name="Name">Milestones</string><ProtectedString name="Source"><![CDATA[--!strict
-- Business milestones shown as the "next goal". Order matters: the first unfinished one is the current goal.
-- `done` reads saved data only, so the server (to award) and the client (to display) agree.
export type Milestone = {
	id: string,
	title: string,
	hint: string,
	done: (data: any) -> boolean,
}

local Milestones = {}

Milestones.list = {
	{
		id = "firstOrderDone",
		title = "Deliver your first order",
		hint = "Open the phone (P), accept Mrs. Park's order, then tap the Bake button to bake it.",
		done = function(data)
			return data.milestones.firstOrderDone == true
		end,
	},
	{
		id = "savedForUpgrade",
		title = "Save $150 for an oven upgrade",
		hint = "Keep delivering orders. The Convection Oven gives you a wider window to pull the tray.",
		done = function(data)
			return data.cash >= 150 or data.equipment.convection_oven == true
		end,
	},
	{
		id = "firstUpgrade",
		title = "Buy the Convection Oven",
		hint = "Open GearUp on your phone (or press B) and buy the Convection Oven.",
		done = function(data)
			return data.equipment.convection_oven == true
		end,
	},
	{
		id = "threeOrders",
		title = "Complete 3 orders",
		hint = "Customers text you every so often. Accept the ones you can fill.",
		done = function(data)
			return data.stats.orders >= 3
		end,
	},
} :: { Milestone }

-- First unfinished milestone, or nil when everything here is done.
function Milestones.next(data: any): Milestone?
	for _, m in Milestones.list do
		if not m.done(data) then
			return m
		end
	end
	return nil
end

return Milestones
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX10"><Properties><string name="Name">Properties</string><ProtectedString name="Source"><![CDATA[--!strict
-- Properties: where you bake, store supplies and (from the food truck up) sell to walk-in customers.
-- display = how many batches the display case holds; walkIn = max cookies a walk-in crowd buys per sales round.
